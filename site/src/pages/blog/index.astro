---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getCategories, getPosts } from '../../lib/content';
import '../../styles/editorial.css';
const posts = await getPosts();
const categories = await getCategories();
---
<BaseLayout title="Blog — DejotaCode" description="Tutoriais e artigos práticos para aprender tecnologia, publicar projetos e criar renda digital.">
  <Header/><main class="editorial-page"><section class="page-head"><div class="container"><p class="eyebrow">Conteúdo prático</p><h1>Blog</h1><p>Aprenda no seu ritmo e termine cada leitura sabendo qual é o próximo passo.</p><form class="search" role="search"><label class="sr-only" for="post-search">Buscar artigos</label><input id="post-search" type="search" placeholder="Buscar artigos…" autocomplete="off"/><button type="submit">Buscar</button></form><div class="filters"><button class="active" data-filter="all">Todos</button>{categories.map((category)=><button data-filter={category.slug}>{category.name} <span>{category.count}</span></button>)}</div></div></section>
  <section class="container blog-layout"><div><p class="results" aria-live="polite"><strong data-count>{posts.length}</strong> conteúdos encontrados</p><div class="post-list">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div><p class="empty-state" hidden data-empty>Nenhum conteúdo corresponde à sua busca.</p><nav class="pagination" aria-label="Paginação"><button data-prev aria-label="Página anterior">←</button><span data-pages></span><button data-next>Próxima →</button></nav></div>
  <aside class="blog-aside"><section><h2>Mais populares</h2><ol>{posts.slice(0,4).map((post)=><li><a href={post.type==='tutorial'?`/tutorial/${post.slug}`:`/blog/${post.slug}`}>{post.title}</a><small>{post.readingTime} min</small></li>)}</ol></section><section class="aside-news"><span class="tag">Newsletter</span><h2>Receba conteúdo exclusivo</h2><p>Um tutorial prático por semana.</p><form data-lead-form action={`${import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8787'}/api/leads`} method="post"><label class="sr-only" for="blog-email">Seu e-mail</label><input id="blog-email" name="email" type="email" placeholder="Seu melhor e-mail" required/><input type="hidden" name="resource" value="newsletter-blog"/><button class="button" type="submit">Quero receber</button><output aria-live="polite"></output></form></section></aside></section></main><Footer/>
  <script>
    const form=document.querySelector<HTMLFormElement>('.search'); const input=document.querySelector<HTMLInputElement>('#post-search'); const cards=[...document.querySelectorAll<HTMLElement>('[data-post]')]; const count=document.querySelector('[data-count]'); const empty=document.querySelector<HTMLElement>('[data-empty]'); const pages=document.querySelector<HTMLElement>('[data-pages]'); const prev=document.querySelector<HTMLButtonElement>('[data-prev]'); const next=document.querySelector<HTMLButtonElement>('[data-next]'); const pageSize=4; let category='all'; let currentPage=1;
    const update=()=>{const query=input?.value.trim().toLowerCase()??'';const matches=cards.filter(card=>Boolean(card.dataset.title?.includes(query)&&(category==='all'||card.dataset.category===category)));const totalPages=Math.max(1,Math.ceil(matches.length/pageSize));currentPage=Math.min(currentPage,totalPages);cards.forEach(card=>card.hidden=true);matches.slice((currentPage-1)*pageSize,currentPage*pageSize).forEach(card=>card.hidden=false);if(count)count.textContent=String(matches.length);if(empty)empty.hidden=matches.length!==0;if(pages){pages.replaceChildren();for(let page=1;page<=totalPages;page++){const button=document.createElement('button');button.textContent=String(page);if(page===currentPage)button.setAttribute('aria-current','page');button.addEventListener('click',()=>{currentPage=page;update();});pages.append(button);}}if(prev)prev.disabled=currentPage===1;if(next)next.disabled=currentPage===totalPages||matches.length===0;};
    form?.addEventListener('submit',(event)=>{event.preventDefault();currentPage=1;update();}); input?.addEventListener('input',()=>{currentPage=1;update();}); prev?.addEventListener('click',()=>{currentPage--;update();});next?.addEventListener('click',()=>{currentPage++;update();});document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{category=button.dataset.filter??'all';currentPage=1;document.querySelectorAll('[data-filter]').forEach(item=>item.classList.remove('active'));button.classList.add('active');update();}));update();
  </script>
</BaseLayout>
