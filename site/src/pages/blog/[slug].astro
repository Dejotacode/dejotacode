---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/content';
import '../../styles/editorial.css';
export async function getStaticPaths(){const posts=(await getPosts()).filter((post)=>post.type==='article');return posts.map((post)=>({params:{slug:post.slug},props:{post}}));}
const { post }=Astro.props;
const all=await getPosts();
const related=all.filter((item)=>item.slug!==post.slug&&item.categorySlug===post.categorySlug).slice(0,3);
const published=new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(post.publishedAt));
const canonical=new URL(`/blog/${post.slug}`,Astro.site??'https://www.dejotacode.com.br');
const schema={'@context':'https://schema.org','@type':'Article',headline:post.title,description:post.excerpt,datePublished:post.publishedAt,author:{'@type':'Person',name:post.author},publisher:{'@type':'Organization',name:'DejotaCode'},mainEntityOfPage:canonical.href};
---
<BaseLayout title={`${post.title} — DejotaCode`} description={post.excerpt} image={post.coverUrl}>
<Header/><main class="article-page">
<div class="container breadcrumbs"><a href="/">Início</a><span>›</span><a href="/blog">Blog</a><span>›</span><a href={`/categoria/${post.categorySlug}`}>{post.category}</a></div>
<header class="article-head container"><span class="tag">Artigo</span><h1>{post.title}</h1><p>{post.excerpt}</p><div class="meta"><span>Por {post.author}</span><span>{post.readingTime} min de leitura</span><time datetime={post.publishedAt}>{published}</time></div></header>
<div class:list={["article-cover", !post.coverUrl && "cover-1"]}>
  <img
    class="cover-image"
    src={post.coverUrl ?? '/images/editorial-cover-default.png'}
    alt={post.coverAlt ?? `Capa de ${post.title}`}
    width="1200"
    height="675"
  />
</div>
<div class="container share-row"><span>Compartilhe:</span><button type="button" data-share="native">Compartilhar</button><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical.href)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a><button type="button" data-share="copy">Copiar link</button><output data-share-status aria-live="polite"></output></div>
<div class="container article-layout"><aside class="toc" aria-label="Índice do artigo"><strong>Neste artigo</strong>{post.sections.map((section)=><a href={`#${section.id}`}>{section.title}</a>)}</aside>
<article class="prose">{post.sections.map((section)=><section id={section.id}><h2>{section.title}</h2>{section.paragraphs.map((paragraph)=><p>{paragraph}</p>)}{section.steps&&<ul>{section.steps.map((step)=><li>{step}</li>)}</ul>}{section.code&&<div class="code-block"><button type="button" data-copy-code>Copiar</button><pre><code>{section.code}</code></pre></div>}</section>)}<div class="author-box"><img src="/images/dejotacode-icon.png" width="46" height="51" alt="Símbolo DejotaCode"/><p><strong>Dejota</strong><br/>Criador do DejotaCode. Tecnologia explicada para quem está começando.</p></div></article>
<aside class="article-cta"><span class="tag">Material gratuito</span><h2>Checklist do primeiro site</h2><p>Publique sem esquecer nenhuma etapa importante.</p><a class="button" href="/newsletter">Baixar agora</a></aside></div>
{related.length>0&&<section class="section section--soft"><div class="container"><h2>Continue aprendendo</h2><div class="related-grid">{related.map((item,index)=><PostCard post={item} index={index}/>)}</div></div></section>}</main><Footer/>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>
<script>
const status=document.querySelector<HTMLOutputElement>('[data-share-status]');
document.querySelector('[data-share="native"]')?.addEventListener('click',async()=>{if(navigator.share)await navigator.share({title:document.title,url:location.href});else{await navigator.clipboard.writeText(location.href);if(status)status.textContent='Link copiado.';}});
document.querySelector('[data-share="copy"]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);if(status)status.textContent='Link copiado.';});
document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach(button=>button.addEventListener('click',async()=>{const code=button.nextElementSibling?.textContent??'';await navigator.clipboard.writeText(code);button.textContent='Copiado';setTimeout(()=>button.textContent='Copiar',1800);}));
</script></BaseLayout>
<style>
.article-cover{gap:18px;align-content:center}.article-cover img.cover-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:none;opacity:1}.share-row{display:flex;justify-content:flex-end;align-items:center;gap:8px;margin-top:-38px;margin-bottom:38px;color:var(--muted);font-size:.82rem}.share-row button,.share-row a{padding:7px 10px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink);font:inherit;cursor:pointer}.share-row button:hover,.share-row a:hover{border-color:#9bbdf1;color:var(--blue)}.share-row output{min-width:70px;color:var(--blue)}.author-box img{width:46px;height:46px;object-fit:contain}.code-block pre{margin-bottom:0}@media(max-width:650px){.share-row{justify-content:flex-start;flex-wrap:wrap;margin-top:-32px}.article-cover img.cover-image{width:100%}}
</style>
