---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import PostCard from '../../components/PostCard.astro'; import { getPosts } from '../../lib/content'; import '../../styles/editorial.css';
export async function getStaticPaths(){const posts=(await getPosts()).filter((post)=>post.type==='article');return posts.map((post)=>({params:{slug:post.slug},props:{post}}));}
const { post }=Astro.props; const all=await getPosts(); const related=all.filter((item)=>item.slug!==post.slug&&item.categorySlug===post.categorySlug).slice(0,3);
---
<BaseLayout title={`${post.title} — DejotaCode`} description={post.excerpt}><Header/><main class="article-page"><div class="container breadcrumbs"><a href="/">Início</a><span>›</span><a href="/blog">Blog</a><span>›</span><a href={`/categoria/${post.categorySlug}`}>{post.category}</a></div><header class="article-head container"><span class="tag">Artigo</span><h1>{post.title}</h1><p>{post.excerpt}</p><div class="meta"><span>Por {post.author}</span><span>{post.readingTime} min de leitura</span><time datetime={post.publishedAt}>{post.publishedAt}</time></div></header><div class="article-cover cover-1"><span>DEJOTACODE / {post.category.toUpperCase()}</span></div><div class="container article-layout"><aside class="toc"><strong>Neste artigo</strong>{post.sections.map((section)=><a href={`#${section.id}`}>{section.title}</a>)}</aside><article class="prose">{post.sections.map((section)=><section id={section.id}><h2>{section.title}</h2>{section.paragraphs.map((paragraph)=><p>{paragraph}</p>)}{section.steps&&<ul>{section.steps.map((step)=><li>{step}</li>)}</ul>}{section.code&&<pre><code>{section.code}</code></pre>}</section>)}<div class="author-box"><div>D</div><p><strong>Dejota</strong><br/>Criador do DejotaCode. Tecnologia explicada para quem está começando.</p></div></article><aside class="article-cta"><span class="tag">Material gratuito</span><h2>Checklist do primeiro site</h2><p>Publique sem esquecer etapas.</p><a class="button" href="/newsletter">Baixar agora</a></aside></div>{related.length>0&&<section class="section section--soft"><div class="container"><h2>Continue aprendendo</h2><div class="related-grid">{related.map((item,index)=><PostCard post={item} index={index}/>)}</div></div></section>}</main><Footer/></BaseLayout>
