---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const categories=[['</>','Programação','Desenvolvimento web, código e frameworks.','programacao'],['>_','Linux & Segurança','Sistemas, terminal e proteção digital.','linux'],['☁','Cloudflare','Workers, D1, R2 e publicação moderna.','cloudflare'],['↗','Renda Digital','Caminhos para gerar renda online.','renda-digital'],['✦','IA','Ferramentas, prompts e automações.','ia'],['▤','Tech & Tendências','Notícias e análises sem complicação.','programacao'],['▣','Tutoriais & Guias','Passo a passo e soluções práticas.','programacao']];
const featured=[['Cloudflare','Como publicar seu primeiro site gratuitamente','12 min','publicar-site-cloudflare','CF'],['Linux','Terminal Linux: 12 comandos para começar','10 min','comandos-linux-iniciantes','>_'],['Programação','Crie uma página responsiva do zero','18 min','pagina-responsiva-zero','</>'],['IA','Automatize sua primeira tarefa com IA','9 min','pagina-responsiva-zero','IA']];
const recent=[['IA','5 formas práticas de usar IA no trabalho','08 set 2026'],['Renda digital','Como montar seu primeiro serviço online','05 set 2026'],['Segurança','Proteja suas contas com passos simples','02 set 2026'],['Programação','Seu primeiro projeto para o portfólio','30 ago 2026']];
---
<BaseLayout title="DejotaCode — Transforme conhecimento em renda" description="Tutoriais simples de tecnologia e estratégias práticas para aprender, construir e monetizar."><Header/><main>
<section class="home-hero"><div class="container home-hero__grid"><div class="home-hero__copy"><p class="eyebrow">Aprenda. Construa. Monetize.</p><h1>Transforme conhecimento em <span>renda.</span></h1><p>Tutoriais simples, tecnologia e estratégias práticas para você aprender, construir seus projetos e começar sua jornada digital.</p><div class="actions"><a class="button" href="/comece-aqui">Começar agora</a><a class="button button--ghost" href="/blog">Ver tutoriais</a></div></div><div class="home-hero__visual" aria-label="Visão geral do método DejotaCode"><div class="video-preview" role="img" aria-label="Prévia do futuro vídeo de apresentação do DejotaCode"><div class="video-preview__brand" aria-hidden="true"><img src="/images/dejotacode-icon.png" width="42" height="47" alt=""/><span><small>Conheça o</small><strong>DejotaCode</strong></span></div><span class="video-preview__play" aria-hidden="true">▶</span><span class="video-preview__status">Vídeo de apresentação · em breve</span></div><ul><li><b aria-hidden="true">▤</b><span><strong>Tutoriais práticos</strong>Passo a passo simples</span></li><li><b aria-hidden="true">⌘</b><span><strong>Projetos reais</strong>Aprenda construindo</span></li><li><b aria-hidden="true">⌂</b><span><strong>Renda online</strong>Transforme conhecimento</span></li></ul></div></div></section>
<section class="home-section home-categories" aria-labelledby="categorias"><div class="container"><div class="home-heading"><div><h2 id="categorias">Explore por categoria</h2><p>Acesse conteúdos organizados para acelerar sua evolução.</p></div></div><div class="home-category-grid">{categories.map(([icon,title,text,slug])=><a href={`/categoria/${slug}`}><span aria-hidden="true">{icon}</span><h3>{title}</h3><p>{text}</p><i aria-hidden="true">→</i></a>)}</div></div></section>
<section class="home-section home-section--soft" aria-labelledby="destaques"><div class="container"><div class="home-heading"><div><h2 id="destaques">Tutoriais em destaque</h2><p>Os conteúdos mais acessados para você aprender e aplicar agora.</p></div><a href="/blog">Ver todos</a></div><div class="home-card-grid">{featured.map(([tag,title,time,slug,mark],index)=><article><a class={`home-card__cover cover-${index%3+1}`} href={`/tutorial/${slug}`} aria-label={`Abrir ${title}`}><span class="home-card__label">Guia prático</span><strong aria-hidden="true">{mark}</strong></a><div><small>{tag}</small><h3><a href={`/tutorial/${slug}`}>{title}</a></h3><p><span>Por Dejota</span><span>{time}</span><span>08/09/2026</span></p></div></article>)}</div></div></section>
<section class="home-journey"><div class="container"><div class="home-journey__title"><h2>Sua jornada no DejotaCode</h2><p>Siga um caminho simples, do zero à sua primeira renda online.</p></div><ol><li><b>1</b><div><h3>Aprenda</h3><p>Entenda os conceitos de forma simples.</p></div></li><li><b>2</b><div><h3>Construa</h3><p>Coloque em prática com projetos reais.</p></div></li><li><b>3</b><div><h3>Publique</h3><p>Mostre seu trabalho na internet.</p></div></li><li><b>4</b><div><h3>Monetize</h3><p>Transforme suas habilidades em renda.</p></div></li></ol></div></section>
<section class="home-section"><div class="container home-feature-grid"><article><h2>Renda Digital</h2><p>Descubra formas práticas de gerar sua primeira renda online.</p><ul><li>Afiliados</li><li>Freelancing</li><li>Produtos digitais</li><li>Blogs</li><li>E-commerce</li></ul><a class="button button--ghost" href="/categoria/renda-digital">Explorar agora</a></article><article class="home-project"><div><h2>Projetos em destaque</h2><p>Veja projetos reais que ensinam o processo completo.</p><a class="button button--ghost" href="/portfolio">Ver projetos</a></div><div class="project-placeholder">Imagem</div></article><article><h2>Material gratuito</h2><p>Receba guias, checklists e conteúdos exclusivos no seu e-mail.</p><form class="lead-form" data-lead-form action={`${import.meta.env.PUBLIC_API_URL??'http://localhost:8787'}/api/leads`} method="post"><label class="sr-only" for="lead-name">Seu nome</label><input id="lead-name" name="name" placeholder="Seu nome"/><label class="sr-only" for="lead-email">Seu e-mail</label><input id="lead-email" name="email" type="email" autocomplete="email" placeholder="Seu e-mail" required/><input type="hidden" name="resource" value="checklist-primeiro-site"/><button class="button" type="submit">Quero receber</button><output aria-live="polite"></output></form><small>Sem spam. Cancele quando quiser.</small></article></div></section>
<section class="home-section home-section--soft"><div class="container"><div class="home-heading"><div><h2>Artigos recentes</h2><p>Acompanhe os conteúdos mais novos do blog.</p></div><a href="/blog">Ver todos</a></div><div class="home-card-grid">{recent.map(([tag,title,date],index)=><article><a class={`home-card__cover cover-${index%3+1}`} href="/blog"><span>Imagem do artigo</span></a><div><small>{tag}</small><h3><a href="/blog">{title}</a></h3><p><span>Por Dejota</span><span>{date}</span></p></div></article>)}</div></div></section>
</main><Footer/></BaseLayout>
