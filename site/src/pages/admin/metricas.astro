---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Brand from '../../components/Brand.astro'; import '../../styles/admin.css'; import '../../styles/metrics.css'; const api=import.meta.env.PUBLIC_API_URL??'http://localhost:8787';
---
<BaseLayout title="Métricas — DejotaCode" description="Métricas agregadas do projeto." noindex><main class="admin-shell" data-api={api}><header><Brand/><a href="/admin">← Voltar ao painel</a></header><section class="metrics-workspace"><p class="eyebrow">Últimos 30 dias</p><h1>Métricas e conversão</h1><p>Somente totais agregados, sem identificação de visitantes.</p><div class="metric-cards" data-totals><p>Carregando…</p></div><section><h2>Páginas mais lidas</h2><div class="ranking" data-pages></div></section></section></main><script>const api=document.querySelector<HTMLElement>('[data-api]')!.dataset.api;const start=async()=>{const session=await fetch(`${api}/api/auth/session`,{credentials:'include'});if(!session.ok){location.href='/admin';return;}const response=await fetch(`${api}/api/analytics/summary`,{credentials:'include'});const data=(await response.json()).data;const totals=document.querySelector<HTMLElement>('[data-totals]')!;totals.replaceChildren();const labels:any={page_view:'Visualizações',cta_click:'Cliques em CTA',lead_submit:'Inscrições',contact_submit:'Contatos'};data.totals.forEach((item:any)=>{const card=document.createElement('article');card.innerHTML='<strong></strong><span></span>';card.querySelector('strong')!.textContent=new Intl.NumberFormat('pt-BR').format(item.total);card.querySelector('span')!.textContent=labels[item.event]??item.event;totals.append(card);});const pages=document.querySelector<HTMLElement>('[data-pages]')!;data.pages.forEach((item:any,index:number)=>{const row=document.createElement('div');row.innerHTML='<b></b><span></span><strong></strong>';row.querySelector('b')!.textContent=String(index+1);row.querySelector('span')!.textContent=item.path;row.querySelector('strong')!.textContent=String(item.total);pages.append(row);});};start();</script></BaseLayout>
