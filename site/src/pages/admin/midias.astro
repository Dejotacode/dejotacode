---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Brand from '../../components/Brand.astro'; import '../../styles/admin.css'; import '../../styles/media.css'; const api=import.meta.env.PUBLIC_API_URL??'http://localhost:8787';
---
<BaseLayout title="Biblioteca de mídias — DejotaCode" description="Área privada de mídias." noindex><main class="admin-shell media-admin" data-api={api}><header><Brand/><a href="/admin">← Voltar ao painel</a></header><section class="media-workspace"><div><p class="eyebrow">Cloudflare R2</p><h1>Biblioteca de mídias</h1><p>Imagens, capas e materiais para download ficam armazenados fora do banco.</p></div><form class="upload-form" data-upload><label>Arquivo<input name="file" type="file" multiple accept="image/jpeg,image/png,image/webp,image/avif,application/pdf,application/zip" required/></label><label>Descrição acessível<input name="alt" maxlength="220" placeholder="Descreva o conteúdo da imagem"/></label><button class="button" type="submit">Enviar arquivo</button><output aria-live="polite"></output></form><div class="media-grid" data-media-list><p>Carregando arquivos…</p></div></section></main><script>
const root=document.querySelector<HTMLElement>('[data-api]')!;const api=root.dataset.api;let csrf='';const json=async(path:string,options:RequestInit={})=>{const response=await fetch(`${api}${path}`,{credentials:'include',...options,headers:{'X-CSRF-Token':csrf,...options.headers}});const payload=await response.json();if(!response.ok)throw new Error(payload.error?.message??'Não foi possível concluir.');return payload.data;};
const load=async()=>{const list=document.querySelector<HTMLElement>('[data-media-list]')!;const data=await json('/api/media/cms');list.replaceChildren();if(!data.items.length){list.innerHTML='<p>Nenhum arquivo enviado.</p>';return;}data.items.forEach((item:any)=>{const card=document.createElement('article');const isImage=item.contentType.startsWith('image/');card.innerHTML=`<div class="media-preview"></div><div><strong></strong><small></small><button type="button">Remover</button></div>`;const preview=card.querySelector<HTMLElement>('.media-preview')!;if(isImage){const image=document.createElement('img');image.src=`${api}/api/media/public/${item.objectKey}`;image.alt=item.altText;preview.append(image);}else preview.textContent='ARQUIVO';card.querySelector('strong')!.textContent=item.altText||item.objectKey.split('/').pop();card.querySelector('small')!.textContent=`${item.contentType} · ${Math.ceil(item.sizeBytes/1024)} KB`;card.querySelector('button')!.addEventListener('click',async()=>{if(confirm('Remover este arquivo?')){await json(`/api/media/cms/${item.id}`,{method:'DELETE'});await load();}});list.append(card);});};
const start=async()=>{const session=await json('/api/auth/session');csrf=session.csrf;await load();};start().catch(()=>location.href='/admin');const uploadForm=document.querySelector<HTMLFormElement>('[data-upload]')!;
uploadForm.addEventListener('submit',async(event)=>{
  event.preventDefault();
  const form=event.currentTarget as HTMLFormElement;
  const input=form.querySelector<HTMLInputElement>('input[name="file"]')!;
  const altInput=form.querySelector<HTMLInputElement>('input[name="alt"]')!;
  const output=form.querySelector<HTMLOutputElement>('output')!;
  const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const files=Array.from(input.files??[]);

  if(!files.length){
    output.textContent='Selecione pelo menos um arquivo.';
    return;
  }

  button.disabled=true;
  let sent=0;

  try{
    for(const file of files){
      output.textContent=`Enviando ${sent+1}/${files.length}: ${file.name}`;

      const data=new FormData();
      data.set('file',file);

      const derivedAlt=`Capa editorial do conteúdo ${file.name
        .replace(/-1200x675\.png$/i,'')
        .replace(/-/g,' ')}`;

      data.set(
        'alt',
        files.length===1 && altInput.value.trim()
          ? altInput.value.trim()
          : derivedAlt.slice(0,220)
      );

      const response=await fetch(`${api}/api/media/cms`,{
        method:'POST',
        credentials:'include',
        headers:{'X-CSRF-Token':csrf},
        body:data
      });

      const payload=await response.json();

      if(!response.ok){
        throw new Error(
          `${file.name}: ${payload.error?.message??'Falha no upload.'}`
        );
      }

      sent++;
    }

    form.reset();
    output.textContent=`${sent} arquivo(s) enviado(s) com sucesso.`;
    await load();
  }catch(error){
    output.textContent=`Enviados ${sent}/${files.length}. ${(error as Error).message}`;
  }finally{
    button.disabled=false;
  }
});
</script></BaseLayout>
