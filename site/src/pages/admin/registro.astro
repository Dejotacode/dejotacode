---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Brand from '../../components/Brand.astro'; import '../../styles/admin.css'; const api=import.meta.env.PUBLIC_API_URL??'http://localhost:8787';
---
<BaseLayout title="Aceitar convite — DejotaCode" description="Crie sua conta editorial por convite."><main class="admin-shell" data-api={api}><header><Brand/><span>Convite editorial</span></header><section class="login-panel"><p class="eyebrow">Acesso por convite</p><h1>Criar conta</h1><form data-register><label>Nome<input name="name" required minlength="2"/></label><label>E-mail<input name="email" type="email" required/></label><label>Senha<input name="password" type="password" minlength="12" required/><small>Mínimo de 12 caracteres.</small></label><button class="button" type="submit">Criar conta</button><output aria-live="polite"></output></form></section></main><script>const form=document.querySelector<HTMLFormElement>('[data-register]')!;form.addEventListener('submit',async(event)=>{event.preventDefault();const output=form.querySelector('output')!;const token=new URLSearchParams(location.search).get('token');if(!token){output.textContent='Convite ausente.';return;}const api=document.querySelector<HTMLElement>('[data-api]')!.dataset.api;const body={...Object.fromEntries(new FormData(form)),invite:token};const response=await fetch(`${api}/api/auth/register`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const payload=await response.json();output.textContent=response.ok?'Conta criada. Você já pode entrar no painel.':payload.error?.message??'Não foi possível criar a conta.';});</script></BaseLayout>
