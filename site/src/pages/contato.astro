---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import '../styles/institutional.css';
---
<BaseLayout title="Contato — DejotaCode" description="Envie sua dúvida, sugestão ou proposta para o DejotaCode."><Header/><main><section class="institutional-hero compact"><div class="container"><p class="eyebrow">Vamos conversar</p><h1>Contato</h1><p>Escreva com o máximo de detalhes possível. Assim consigo entender e responder melhor.</p></div></section><section class="section container contact-layout"><aside><article><span>?</span><h2>Dúvidas e sugestões</h2><p>Conte onde você travou ou qual tutorial gostaria de ver.</p></article><article><span>↗</span><h2>Serviços e propostas</h2><p>Explique o objetivo, o prazo e o resultado que você procura.</p></article><div class="contact-note"><strong>Prazo de resposta</strong><p>Normalmente em até dois dias úteis.</p></div></aside><form class="contact-form" data-contact-form action={`${import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8787'}/api/contact`} method="post"><div class="field-row"><label>Seu nome<input name="name" required minlength="2" maxlength="100" autocomplete="name"/></label><label>Seu e-mail<input name="email" type="email" required maxlength="254" autocomplete="email"/></label></div><label>Assunto<select name="subject" required><option value="">Selecione um assunto</option><option>Dúvida sobre conteúdo</option><option>Sugestão de tutorial</option><option>Serviço ou orçamento</option><option>Parceria</option><option>Outro assunto</option></select></label><label>Sua mensagem<textarea name="message" required minlength="20" maxlength="3000" rows="8" placeholder="Explique como posso ajudar..."></textarea></label><label class="consent"><input name="consent" type="checkbox" value="true" required/> Concordo com o uso dos dados para responder esta mensagem.</label><button class="button" type="submit">Enviar mensagem</button><output aria-live="polite"></output></form></section></main><Footer/><script>const form=document.querySelector<HTMLFormElement>('[data-contact-form]');form?.addEventListener('submit',async(event)=>{event.preventDefault();const button=form.querySelector<HTMLButtonElement>('button');const output=form.querySelector('output');if(!button||!output)return;button.disabled=true;output.textContent='Enviando…';const data=Object.fromEntries(new FormData(form));try{const response=await fetch(form.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,consent:data.consent==='true'})});if(!response.ok)throw new Error('request_failed');form.reset();output.textContent='Mensagem enviada. Obrigado pelo contato!';}catch{output.textContent='Não foi possível enviar agora. Tente novamente.';}finally{button.disabled=false;}});</script></BaseLayout>
