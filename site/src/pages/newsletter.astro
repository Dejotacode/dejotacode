---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import '../styles/institutional.css';
---
<BaseLayout title="Newsletter — DejotaCode" description="Receba um tutorial prático e direto por semana."><Header/><main class="newsletter-page"><section class="newsletter-card"><p class="eyebrow">Conteúdo sem enrolação</p><h1>Um passo prático por semana.</h1><p>Receba tutoriais para aprender tecnologia, publicar projetos e construir sua primeira renda digital.</p><ul><li>Explicações para iniciantes</li><li>Projetos que você consegue reproduzir</li><li>Sem spam e sem promessa fácil</li></ul><form data-lead-form action={`${import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8787'}/api/leads`} method="post"><label for="newsletter-email">Seu melhor e-mail</label><input id="newsletter-email" name="email" type="email" required autocomplete="email" placeholder="voce@exemplo.com"/><input type="hidden" name="resource" value="newsletter-principal"/><button class="button" type="submit">Quero aprender toda semana</button><output aria-live="polite"></output></form><small>Ao se inscrever, você concorda com a Política de Privacidade.</small></section></main><Footer/></BaseLayout>
