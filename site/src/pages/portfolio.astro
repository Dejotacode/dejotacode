---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import '../styles/institutional.css';
const projects=[['DejotaCode','Plataforma editorial estática com API no edge, CMS headless e arquitetura Cloudflare.',['Astro','Hono','D1','R2']],['Landing page para serviços','Página rápida e responsiva orientada à geração de contatos.',['Astro','SEO','CRO']],['Blog para iniciantes','Experiência de leitura com categorias, busca, tutoriais e newsletter.',['SSG','Acessibilidade','SEO']],['Painel editorial','Área segura para gerenciar publicações, usuários e mídias.',['TypeScript','D1','R2']],['Checklist interativo','Material gratuito que organiza a primeira publicação de um site.',['JavaScript','UX']],['Portfólio profissional','Estrutura para apresentar projetos, decisões e resultados.',['Astro','Design system']]];
---
<BaseLayout title="Portfólio — DejotaCode" description="Projetos digitais construídos com clareza, desempenho e foco em resultado."><Header/><main><section class="institutional-hero"><div class="container"><p class="eyebrow">Projetos reais</p><h1>Portfólio</h1><p>Conheça projetos construídos para ensinar, resolver problemas e criar oportunidades.</p></div></section><section class="section container"><div class="project-grid">{projects.map(([title,description,tags],index)=><article class="project-card"><div class={`project-shot shot-${(index%3)+1}`}><span>0{index+1}</span></div><div><h2>{title}</h2><p>{description}</p><ul>{(tags as string[]).map((tag)=><li>{tag}</li>)}</ul><a href="/contato">Conhecer o projeto →</a></div></article>)}</div></section></main><Footer/></BaseLayout>
