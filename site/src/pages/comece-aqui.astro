---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import '../styles/institutional.css';
const paths=[['01','Sou totalmente iniciante','Comece pelos conceitos básicos, sem precisar saber programar.','/tutorial/comandos-linux-iniciantes'],['02','Quero aprender programação','Siga uma rota de HTML, CSS, JavaScript e projetos web.','/categoria/programacao'],['03','Quero aprender Linux','Conheça terminal, sistema, segurança e ferramentas essenciais.','/categoria/linux'],['04','Quero usar inteligência artificial','Use IA como apoio para aprender e trabalhar com mais clareza.','/categoria/ia'],['05','Quero publicar meu site','Prepare, teste e coloque seu primeiro projeto na Cloudflare.','/tutorial/publicar-site-cloudflare'],['06','Quero criar minha primeira renda','Transforme uma habilidade pequena em um serviço bem definido.','/categoria/renda-digital']];
---
<BaseLayout title="Comece Aqui — DejotaCode" description="Escolha seu objetivo e siga uma rota simples para começar do zero."><Header/><main><section class="institutional-hero"><div class="container"><p class="eyebrow">Sua primeira rota</p><h1>Comece Aqui</h1><p>Você não precisa aprender tudo. Escolha um objetivo e faça uma etapa por vez.</p></div></section><section class="section container"><div class="path-grid">{paths.map(([number,title,text,href])=><a class="path-card" href={href}><span>{number}</span><div><h2>{title}</h2><p>{text}</p></div><b>→</b></a>)}</div><a class="wide-path" href="/categoria/renda-digital"><span>Rota completa</span><div><h2>Quero construir um negócio digital</h2><p>Una aprendizado, projetos, publicação e monetização em um plano sustentável.</p></div><b>Começar →</b></a></section></main><Footer/></BaseLayout>
