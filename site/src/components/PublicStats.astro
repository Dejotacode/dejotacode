<section class="public-stats" aria-label="Números do DejotaCode"><div class="container"><div><strong data-stat="tutorials">0</strong><span>Conteúdos publicados</span></div><div><strong data-stat="readers">0</strong><span>Leituras registradas</span></div><div><strong data-stat="subscribers">0</strong><span>Pessoas inscritas</span></div><div><strong data-stat="resources">0</strong><span>Materiais disponíveis</span></div></div></section><script>const api=document.documentElement.dataset.api;fetch(`${api}/api/stats`).then(response=>response.ok?response.json():Promise.reject()).then(payload=>Object.entries(payload.data).forEach(([key,value])=>{const node=document.querySelector(`[data-stat="${key}"]`);if(node)node.textContent=new Intl.NumberFormat('pt-BR',{notation:'compact'}).format(Number(value));})).catch(()=>{});</script><style>.public-stats{padding:42px 0;background:#eef5ff;border-block:1px solid var(--line)}.public-stats>.container{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.public-stats div div{display:grid}.public-stats strong{font-size:2rem;color:var(--blue)}.public-stats span{color:var(--muted);font-size:.85rem}@media(max-width:700px){.public-stats>.container{grid-template-columns:repeat(2,1fr)}}</style>
