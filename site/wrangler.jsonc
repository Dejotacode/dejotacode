{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dejotacode-site",
  "compatibility_date": "2026-09-08",
  "routes": [
    { "pattern": "dejotacode.com.br", "custom_domain": true },
    { "pattern": "www.dejotacode.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
