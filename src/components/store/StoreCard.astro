---
import StoreBadge from "./StoreBadge.astro";
import VisualMedia from "../visual/VisualMedia.astro";
import { resolveStoreVisual } from "../../data/storeVisuals";

interface Props {
  id: string;
  title: string;
  description: string;
  status: "uso" | "testado" | "pesquisado";
  category: string;
  brand?: string;
  offerCount?: number;
  relatedPost?: string;
  loading?: "eager" | "lazy";
}
const { id, title, description, status, category, brand, offerCount = 0, relatedPost, loading = "lazy" } = Astro.props;
const { src: productVisual, fallbackSrc: productFallback, categoryLabel } = resolveStoreVisual(id, category);
---
<article class="store-card">
  <div class="store-card__media">
    <VisualMedia
      src={productVisual}
      fallbackSrc={productFallback}
      alt={`Imagem editorial de ${title}`}
      label={title}
      loading={loading}
    />
    <span class="store-card__category">{categoryLabel}</span>
  </div>
  <div class="store-card__body">
    <div class="store-card__topline">
      <StoreBadge status={status} />
      <span class="store-card__brand">{brand ?? "DejotaStore"}</span>
    </div>
    <h3>{title}</h3>
    <p class="store-card__description">{description}</p>
    <div class="store-card__commercial" aria-label="Informações comerciais">
      <div>
        <span class="store-card__commercial-label">Preço</span>
        <strong>Consultar no parceiro</strong>
      </div>
      <span class="store-card__offer-count">{offerCount > 0 ? `${offerCount} ${offerCount === 1 ? "oferta" : "ofertas"}` : "sem oferta ativa"}</span>
    </div>
    <div class="store-card__actions">
      <a
        class="store-card__primary"
        href={`/store/${id}/`}
        data-store-origin={`internal:${Astro.url.pathname}`}
        data-analytics-cta={`store-card:${id}`}
      >
        Ver produto <span aria-hidden="true">→</span>
      </a>
      {relatedPost && (
        <a class="store-card__secondary" href={`/blog/${relatedPost}/`} data-analytics-cta={`store-card:${id}:article`}>
          Ver artigo
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .store-card { min-width: 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast); }
  .store-card:hover { transform: translateY(-3px); border-color: var(--color-accent-strong); box-shadow: var(--shadow-card); }
  .store-card__media { position: relative; }
  .store-card__media > .visual-media { border: 0; border-bottom: 1px solid var(--color-border); border-radius: 0; }
  .store-card__category { position: absolute; left: .8rem; bottom: .75rem; z-index: 2; padding: .35rem .65rem; border-radius: 999px; background: color-mix(in srgb, var(--color-accent-strong) 88%, transparent); color: var(--color-bg); font-size: .72rem; font-weight: 900; letter-spacing: .01em; box-shadow: 0 .35rem 1rem rgb(0 0 0 / .16); }
  .store-card__body { display: grid; gap: .8rem; padding: 1rem; }
  .store-card__topline { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .store-card__brand { color: var(--color-text-subtle); font: 700 .72rem/1.2 var(--font-code); }
  .store-card h3 { margin: 0; font-size: 1.08rem; line-height: 1.2; }
  .store-card__description { display: -webkit-box; margin: 0; overflow: hidden; color: var(--color-text-muted); font-size: .9rem; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .store-card__commercial { display: flex; align-items: end; justify-content: space-between; gap: .75rem; padding-top: .15rem; }
  .store-card__commercial > div { display: grid; gap: .18rem; }
  .store-card__commercial-label { color: var(--color-text-subtle); font-size: .7rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .store-card__commercial strong { font-size: .98rem; }
  .store-card__offer-count { color: var(--color-text-subtle); font: 700 .72rem/1.2 var(--font-code); text-align: right; }
  .store-card__actions { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: .55rem; margin-top: .1rem; }
  .store-card__actions a { display: inline-flex; min-height: 2.6rem; align-items: center; justify-content: center; gap: .45rem; border-radius: .7rem; font-size: .86rem; font-weight: 850; text-decoration: none; }
  .store-card__primary { padding: .65rem .9rem; background: var(--color-accent-strong); color: var(--color-bg); }
  .store-card__primary:hover { background: var(--color-accent-hover); }
  .store-card__secondary { padding: .65rem .8rem; border: 1px solid var(--color-border); color: var(--color-text); background: var(--color-surface); }
  .store-card__secondary:hover { border-color: var(--color-accent-strong); color: var(--color-accent-strong); }
  .store-card__actions > :only-child { grid-column: 1 / -1; }
  @media (max-width: 30rem) { .store-card__commercial { align-items: start; flex-direction: column; } .store-card__offer-count { text-align: left; } .store-card__actions { grid-template-columns: 1fr; } }
</style>
