---
import StoreBadge from "./StoreBadge.astro";
import VisualMedia from "../visual/VisualMedia.astro";

interface Props {
  id: string;
  title: string;
  description: string;
  status: "uso" | "testado" | "pesquisado";
  category: string;
  brand?: string;
  offerCount?: number;
}
const { id, title, description, status, category, brand, offerCount = 0 } = Astro.props;
const categoryLabels: Record<string, string> = {
  linux: "Linux",
  setup: "Setup",
  programacao: "Programação",
  criadores: "Criadores",
  "ferramentas-digitais": "Ferramentas digitais",
};
const categoryVisuals: Record<string, string> = {
  linux: "/assets/resources/category-aprendizado.svg",
  setup: "/assets/resources/category-infraestrutura.svg",
  programacao: "/assets/resources/category-desenvolvimento.svg",
  criadores: "/assets/resources/category-digitais.svg",
  "ferramentas-digitais": "/assets/resources/category-digitais.svg",
};
---
<article class="store-card">
  <VisualMedia src={categoryVisuals[category]} alt={`Ilustração da categoria ${categoryLabels[category] ?? category} na DejotaStore`} label={categoryLabels[category] ?? category} />
  <div class="store-card__body">
    <StoreBadge status={status} />
    <div class="store-card__context"><span>{categoryLabels[category] ?? category}</span><span>·</span><span>{brand ?? "DejotaStore"}</span><span>·</span><span>{offerCount > 0 ? `${offerCount} ${offerCount === 1 ? "oferta" : "ofertas"}` : "sem oferta ativa"}</span></div>
    <h3>{title}</h3>
    <p>{description}</p>
    <a
      href={`/store/${id}/`}
      data-store-origin={`internal:${Astro.url.pathname}`}
      data-analytics-cta={`store-card:${id}`}
    >
      Ver análise <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .store-card { min-width: 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast); }
  .store-card:hover { transform: translateY(-2px); border-color: var(--color-accent-strong); box-shadow: var(--shadow-card); }
  .store-card > .visual-media { border: 0; border-bottom: 1px solid var(--color-border); border-radius: 0; }
  .store-card__body { display: grid; gap: .7rem; padding: 1rem; }
  .store-card__context { display: flex; flex-wrap: wrap; gap: .4rem; color: var(--color-text-subtle); font: 700 .7rem/1.2 var(--font-code); }
  .store-card h3 { margin: 0; font-size: 1.03rem; }
  .store-card p { margin: 0; color: var(--color-text-muted); font-size: .9rem; }
  .store-card a { width: fit-content; color: var(--color-accent-strong); font-size: .88rem; font-weight: 800; text-decoration: none; }
  .store-card a:hover { color: var(--color-accent-hover); }
</style>
