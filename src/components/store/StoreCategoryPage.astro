---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoreCard from "./StoreCard.astro";
import StoreCategoryNav from "./StoreCategoryNav.astro";

interface Props {
  slug: "linux" | "setup" | "programacao" | "criadores" | "ferramentas-digitais";
  label: string;
  description: string;
}

const { slug, label, description } = Astro.props;
const products = await getCollection("storeProducts", ({ data }) => !data.draft && data.category === slug);
const guides = await getCollection("storeGuides", ({ data }) => !data.draft && data.category === slug);
---

<BaseLayout title={`${label} na DejotaStore`} description={description}>
  <main id="conteudo" class="category-page">
    <div class="container">
      <nav class="breadcrumbs"><a href="/">Início</a><span>›</span><a href="/store/">Store</a><span>›</span><span>{label}</span></nav>

      <section class="hero">
        <div class="hero__copy">
          <p class="eyebrow">Categoria DejotaStore</p>
          <h1>{label}</h1>
          <p>{description}</p>
        </div>
        <a class="hero__store-link" href="/store/">Visão geral da Store →</a>
      </section>

      <section class="category-switcher">
        <div class="heading heading--compact">
          <div><p class="eyebrow">Categorias</p><h2>Continue explorando sem voltar</h2></div>
        </div>
        <StoreCategoryNav activeSlug={slug} compact />
      </section>

      <section class="section">
        <div class="heading">
          <div><p class="eyebrow">Curadoria</p><h2>Produtos e ferramentas</h2></div>
        </div>
        <div class="products">
          {products.length > 0 ? products.map((product, productIndex) => (
            <StoreCard
              id={product.id}
              title={product.data.title}
              description={product.data.description}
              status={product.data.editorialStatus}
              category={product.data.category}
              brand={product.data.brand}
              offerCount={product.data.offers.filter((offer) => offer.active).length}
              relatedPost={product.data.relatedPosts?.[0]}
              loading={productIndex < 3 ? "eager" : "lazy"}
            />
          )) : <p class="empty">Ainda não há recomendações publicadas nesta categoria.</p>}
        </div>
      </section>

      <section class="section">
        <div class="heading"><div><p class="eyebrow">Guias de compra</p><h2>Aprenda a escolher</h2></div></div>
        <div class="guides">
          {guides.length > 0 ? guides.map((guide) => (
            <a href={`/store/guias/${guide.id}/`}>
              <strong>{guide.data.title}</strong>
              <span>{guide.data.description}</span>
            </a>
          )) : <p class="empty">Os primeiros guias desta categoria ainda estão sendo preparados.</p>}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .container { width: min(calc(100% - (2 * var(--space-page))), var(--container)); margin-inline: auto; }
  .breadcrumbs { display:flex;flex-wrap:wrap;gap:.45rem;padding-top:1.5rem;color:var(--color-text-subtle);font-size:.82rem; }
  .breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{color:var(--color-accent-strong)}
  .hero{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;padding:2.5rem 0 1.5rem;border-bottom:1px solid var(--color-border)}
  .hero h1{margin:.35rem 0;font-size:clamp(2.5rem,7vw,4.5rem);letter-spacing:-.045em}.hero__copy>p:last-child{max-width:60ch;color:var(--color-text-muted)}.hero__store-link{flex:none;color:var(--color-accent-strong);font-size:.85rem;font-weight:850;text-decoration:none}.category-switcher{padding:1.25rem 0 0}.heading--compact h2{margin:.25rem 0 .8rem;font-size:1.2rem}
  .eyebrow{margin:0;color:var(--color-accent-strong);font-size:.76rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .section{padding:2rem 0}.heading h2{margin:.3rem 0 1rem}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}
  .guides{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.guides a{display:grid;gap:.35rem;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface);text-decoration:none}.guides a:hover{border-color:var(--color-accent-strong)}.guides span,.empty{color:var(--color-text-muted)}
  @media(max-width:55rem){.products{grid-template-columns:repeat(2,1fr)}}@media(max-width:38rem){.hero{align-items:start;flex-direction:column}.products,.guides{grid-template-columns:1fr}}
</style>
