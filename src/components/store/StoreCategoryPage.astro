---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getStoreMerchants } from "../../lib/storeOffers";
import StoreCard from "./StoreCard.astro";
import StoreCategoryNav from "./StoreCategoryNav.astro";
import CategoryIcon from "../ui/CategoryIcon.astro";
import "../../styles/store-catalog.css";

interface Props {
  slug: "linux" | "setup" | "programacao" | "criadores" | "ferramentas-digitais";
  label: string;
  description: string;
}

const { slug, label, description } = Astro.props;
const products = (await getCollection("storeProducts", ({ data }) => !data.draft && data.catalogStage !== "avaliacao" && data.category === slug))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "pt-BR"));
const guides = await getCollection("storeGuides", ({ data }) => !data.draft && data.category === slug);
---

<BaseLayout title={`${label} na DejotaStore`} description={description}>
  <main id="conteudo" tabindex="-1" class="store-catalog-page store-category-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Navegação estrutural"><a href="/">Início</a><span>›</span><a href="/store/">Store</a><span>›</span><span aria-current="page">{label}</span></nav>

      <section class="hero">
        <div class="hero__copy">
          <p class="eyebrow">Categoria DejotaStore</p>
          <h1>{label}</h1>
          <p>{description}</p>
        </div>
        <a class="hero__store-link" href="/store/">Voltar à Store <CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></a>
      </section>

      <section class="category-switcher" aria-label="Categorias da Store">
        <StoreCategoryNav activeSlug={slug} compact />
      </section>

      <section class="section guides-section">
        <div class="catalog-heading"><div><p class="eyebrow">Guias de compra</p><h2>Aprenda a escolher</h2></div></div>
        <div class="guides">
          {guides.length > 0 ? guides.map((guide) => (
            <a href={`/store/guias/${guide.id}/`}>
              <CategoryIcon icon="news" size={28} />
              <div><strong>{guide.data.title}</strong><p>{guide.data.description}</p></div>
              <span class="guide-action">Ler guia <span aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></span>
            </a>
          )) : <p class="empty empty--state">Os primeiros guias desta categoria ainda estão sendo preparados.</p>}
        </div>
      </section>

      <section class="section">
        <div class="catalog-heading">
          <div><p class="eyebrow">Curadoria</p><h2>Recomendações em {label}</h2></div>
          <span>{products.length} {products.length === 1 ? "item" : "itens"} no catálogo</span>
        </div>
        <div class:list={["catalog-products", { "products--single": products.length === 1, "products--double": products.length === 2 }]}>
          {products.length > 0 ? products.map((product, productIndex) => (
            <StoreCard
              editorial
              id={product.id}
              title={product.data.title}
              description={product.data.description}
              status={product.data.editorialStatus}
              category={product.data.category}
              brand={product.data.brand}
              offerCount={getStoreMerchants(product.data).length}
              relatedPost={product.data.relatedPosts?.[0]}
              loading={productIndex < 3 ? "eager" : "lazy"}
            />
          )) : <p class="empty empty--state">Ainda não há recomendações publicadas nesta categoria.</p>}
        </div>
      </section>
      <section class="catalog-context" aria-label="Conteúdo e critérios editoriais">
        <a href="/blog/"><CategoryIcon icon="news" size={32} /><div><h2>Aprenda antes de comprar</h2><p>Veja os conteúdos que dão contexto às recomendações.</p><span>Explorar o Blog <CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></div></a>
        <a href="/store/como-avaliamos/"><CategoryIcon icon="shield-check" size={32} /><div><h2>Como avaliamos</h2><p>Entenda os selos de uso, teste e pesquisa.</p><span>Conhecer os critérios <CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></div></a>
      </section>
      <aside class="catalog-disclosure"><CategoryIcon icon="privacy" size={26} /><div><h2>Transparência sobre afiliados</h2><p>Alguns links podem gerar comissão para o DejotaCode, sem custo adicional para você. A compra, entrega e garantia ficam com o parceiro. Uma comissão nunca deve ser o motivo principal de uma recomendação.</p></div></aside>
    </div>
  </main>
</BaseLayout>

<style>
  .breadcrumbs{display:flex;flex-wrap:wrap;gap:.45rem;padding-top:1.5rem;color:var(--color-text-subtle);font-size:.82rem}
  .breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{color:var(--color-accent-strong)}
  .hero{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;padding:2rem 0 1.5rem;border-bottom:1px solid var(--color-border)}
  .hero h1{margin:.6rem 0 .8rem;font-size:clamp(2.2rem,3.6vw,3.1rem);line-height:1.12;letter-spacing:-.04em}
  .hero__copy{min-width:0}.hero__copy>p:last-child{max-width:60ch}.hero__store-link{flex:none;color:var(--color-accent-strong);font-size:.85rem;font-weight:600;text-decoration:none;border:1px solid var(--color-border-strong);border-radius:8px;padding:.7rem 1rem;min-height:44px}
  .category-switcher{padding-top:1.2rem}.eyebrow{text-transform:uppercase}.section{padding-top:2rem}
  .products--single{grid-template-columns:minmax(0,1fr);max-width:24rem}.products--double{grid-template-columns:repeat(2,minmax(0,1fr));max-width:49rem}
  .guides{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .guides a{display:flex;align-items:center;gap:1rem;padding:1.1rem;border:1px solid var(--color-border-strong);border-radius:9px;background:var(--color-surface);color:var(--color-text);text-decoration:none;min-width:0}
  .guides a:hover{border-color:var(--color-accent-strong)}.guides a>div{min-width:0}.guides strong{font-size:.95rem;line-height:1.4}.guides p{font-size:.83rem;margin-top:.4rem}.guide-action{flex:none;color:var(--color-accent-strong);font-size:.8rem}
  .empty--state{grid-column:1/-1;padding:1rem 1.1rem;border:1px dashed var(--color-border-strong);border-radius:9px;background:var(--color-surface)}
  @media(max-width:960px){.guides{grid-template-columns:1fr}}
  @media(max-width:600px){.hero{align-items:start;flex-direction:column}.products--single,.products--double{grid-template-columns:minmax(0,1fr);max-width:none}.guides a{flex-wrap:wrap}.guide-action{margin-left:2.75rem}}
</style>
