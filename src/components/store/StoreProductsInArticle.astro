---
import { getCollection } from "astro:content";
import StoreBadge from "./StoreBadge.astro";

interface Props {
  productIds: string[];
}

const { productIds } = Astro.props;
const products = (await getCollection("storeProducts", ({ data }) => !data.draft))
  .filter((product) => productIds.includes(product.id));
---

{products.length > 0 && (
  <aside class="article-store" aria-labelledby="article-store-title">
    <div class="article-store__intro">
      <p class="article-store__eyebrow">DejotaStore · itens relacionados</p>
      <h2 id="article-store-title">Produtos deste guia</h2>
      <p>Você não precisa destes itens para entender o tutorial. Eles são opções para quem pretende executar o processo.</p>
    </div>

    <div class="article-store__list">
      {products.map((product) => (
        <article>
          <StoreBadge status={product.data.editorialStatus} />
          <div>
            <h3>{product.data.title}</h3>
            <p>{product.data.description}</p>
          </div>
          <a href={`/store/${product.id}/`}>Ver recomendação <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>

    <p class="article-store__disclosure">Algumas recomendações poderão conter links de afiliados. Quando isso acontecer, a relação comercial será informada com transparência.</p>
  </aside>
)}

<style>
  .article-store {
    margin-block: 2rem;
    padding: 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, var(--color-surface), var(--color-surface-soft));
  }

  .article-store__intro h2 {
    margin: .3rem 0 .45rem;
    font-size: 1.35rem;
  }

  .article-store__intro > p:not(.article-store__eyebrow) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .9rem;
  }

  .article-store__eyebrow {
    margin: 0;
    color: var(--color-accent-strong);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .article-store__list {
    display: grid;
    gap: .7rem;
    margin-top: 1rem;
  }

  .article-store__list article {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: .9rem;
    align-items: center;
    padding: .9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .article-store__list h3 {
    margin: 0 0 .2rem;
    font-size: .98rem;
  }

  .article-store__list p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .84rem;
  }

  .article-store__list a {
    color: var(--color-accent-strong);
    font-size: .84rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .article-store__list a:hover {
    color: var(--color-accent-hover);
  }

  .article-store__disclosure {
    margin: .85rem 0 0;
    color: var(--color-text-subtle);
    font-size: .76rem;
  }

  @media (max-width: 42rem) {
    .article-store__list article {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .article-store__list a {
      white-space: normal;
    }
  }
</style>
