---
import type { OfficialIconId } from "../data/categoryIcons";

interface Props {
  icon: OfficialIconId;
  size?: number;
  label?: string;
  class?: string;
}

const { icon, size = 24, label, class: className } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.8",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  class: className,
  "aria-hidden": label ? undefined : "true",
  role: label ? ("img" as const) : undefined,
  "aria-label": label,
} as const;
---

<svg {...common}>
  {icon === "code" && <><path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m14 5-4 14"/></>}
  {icon === "terminal" && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3"/><path d="M12 15h5"/></>}
  {icon === "ai-nodes" && <><circle cx="12" cy="12" r="2.3"/><circle cx="5" cy="7" r="1.4"/><circle cx="19" cy="7" r="1.4"/><circle cx="5" cy="17" r="1.4"/><circle cx="19" cy="17" r="1.4"/><path d="m10.2 10.6-4-2.7M13.8 10.6l4-2.7M10.2 13.4l-4 2.7M13.8 13.4l4 2.7"/></>}
  {icon === "grid" && <><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></>}
  {icon === "wallet" && <><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H18a2 2 0 0 1 2 2v12H6a2 2 0 0 1-2-2V7.5Z"/><path d="M4.5 8H18a2 2 0 0 1 2 2v2h-4a2 2 0 0 0 0 4h4"/><circle cx="16" cy="14" r=".6" fill="currentColor" stroke="none"/></>}
  {icon === "monitor" && <><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></>}
  {icon === "microphone" && <><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M6.5 11a5.5 5.5 0 0 0 11 0M12 16.5V21M9 21h6"/></>}
  {icon === "apps" && <><rect x="4" y="4" width="6" height="6" rx="1.5"/><rect x="14" y="4" width="6" height="6" rx="1.5"/><rect x="4" y="14" width="6" height="6" rx="1.5"/><circle cx="17" cy="17" r="3"/></>}
  {icon === "window" && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/></>}
  {icon === "smartphone-android" && <><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M10 7h4M10 10h.01M14 10h.01M10 14h4M12 18h.01"/></>}
  {icon === "smartphone-ios" && <><rect x="7" y="2.5" width="10" height="19" rx="3"/><path d="M10.5 5h3M12 18.5h.01"/></>}
  {icon === "shield-check" && <><path d="M12 3 5 6v5c0 4.7 2.8 8 7 10 4.2-2 7-5.3 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></>}
  {icon === "blockchain" && <><rect x="3" y="8" width="6" height="6" rx="1"/><rect x="15" y="4" width="6" height="6" rx="1"/><rect x="15" y="14" width="6" height="6" rx="1"/><path d="m9 10 6-3M9 12l6 5"/></>}
  {icon === "cloud-server" && <><path d="M7 18h11a4 4 0 0 0 .5-8A6 6 0 0 0 7.3 8.4 4.5 4.5 0 0 0 7 18Z"/><path d="M9 13h6M9 16h4"/></>}
  {icon === "browser" && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/></>}
  {icon === "smartphone" && <><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M10 5h4M12 18.5h.01"/></>}
  {icon === "workflow" && <><rect x="3" y="4" width="6" height="5" rx="1"/><rect x="15" y="4" width="6" height="5" rx="1"/><rect x="9" y="15" width="6" height="5" rx="1"/><path d="M6 9v2h6v4M18 9v2h-6"/></>}
  {icon === "checklist" && <><path d="m4 6 1.5 1.5L8 5M4 12l1.5 1.5L8 11M4 18l1.5 1.5L8 17M11 6h9M11 12h9M11 18h9"/></>}
  {icon === "news" && <><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5M8 18h8"/></>}
  {icon === "privacy" && <><path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5S2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.5"/><path d="m5 19 14-14"/></>}
  {icon === "network" && <><circle cx="5" cy="12" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="12" cy="19" r="2"/><path d="m6.5 10.5 4-4M13.5 6.5l4 4M17.5 13.5l-4 4M10.5 17.5l-4-4"/></>}
  {icon === "chip" && <><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/></>}
  {icon === "database" && <><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></>}
  {icon === "calendar" && <><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></>}
  {icon === "clock" && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {icon === "keyboard" && <><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M5 10h.01M8 10h.01M11 10h.01M14 10h.01M17 10h.01M20 10h.01M5 13h.01M8 13h.01M11 13h.01M14 13h.01M17 13h.01M20 13h.01M7 16h10"/></>}
  {icon === "mouse" && <><rect x="6" y="2" width="12" height="20" rx="6"/><path d="M12 2v7M6 10h12"/></>}
  {icon === "usb-hub" && <><rect x="2" y="12" width="20" height="8" rx="2"/><path d="M6 16h2M11 16h2M16 16h2M12 12V5M9 5h6V2H9v3Z"/></>}
</svg>
