---
import CategoryIcon from "../ui/CategoryIcon.astro";
interface Props {
  compact?: boolean;
  eyebrow?: string;
  title: string;
  description: string;
  href: string;
  label: string;
  campaign: string;
}

const {
  compact = false,
  eyebrow = "PRÓXIMO PASSO",
  title,
  description,
  href,
  label,
  campaign,
} = Astro.props;
---

<aside class:list={["conversion-cta", { "conversion-cta--compact": compact }]} aria-label="Próximo passo recomendado">
  {compact && <span class="conversion-cta__icon" aria-hidden="true"><CategoryIcon icon="workflow" size={26} /></span>}
  <div class="conversion-cta__copy">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  <p>{description}</p>
  </div>
  <a
    class="button button-primary"
    href={href}
    data-analytics-cta={campaign}
  >{label} <span aria-hidden="true">→</span></a>
</aside>

<style>
  .conversion-cta {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .conversion-cta h2 {
    max-width: 22ch;
    margin: .45rem 0 .75rem;
    font-size: var(--size-title-cta);
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  .conversion-cta > p:not(.eyebrow) {
    max-width: 44rem;
    margin-bottom: 1.25rem;
    color: var(--color-text-muted);
  }
</style>
