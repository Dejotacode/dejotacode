---
import type { Post } from "../../lib/content";
import VisualMedia from "../visual/VisualMedia.astro";
import CategoryIcon from "../ui/CategoryIcon.astro";
import { resolvePostVisual } from "../../data/editorialVisuals";
import {
  categories,
  categoryHref,
  formatPostDate,
  postHref,
} from "../../lib/content";

interface Props {
  post: Post;
  featured?: boolean;
  showReadLink?: boolean;
  blogMetaIcons?: boolean;
}

const {
  post,
  featured = false,
  showReadLink = false,
  blogMetaIcons = false,
} = Astro.props;
const category = post.data.category;
const visual = resolvePostVisual(category, post.id.replace(/\.md$/, ""));
// Responsive derivatives of the approved cover, with its composition preserved.
const responsiveFeatured = featured && blogMetaIcons && visual ===
  "/assets/posts/como-estudar-tecnologia-sem-se-perder-diversidade-assinatura-v1.webp";
const featuredSrcset = responsiveFeatured
  ? [480, 768, 1024].map((width) =>
      `/assets/posts/responsive/como-estudar-tecnologia-sem-se-perder-${width}w.webp ${width}w`,
    ).concat(`${visual} 1440w`).join(", ")
  : undefined;
---

<article class:list={["post-card", { "post-card--featured": featured }]}>
  <div class="post-card__visual">
    <VisualMedia src={visual} fallbackSrc="/assets/resources/category-aprendizado.svg" alt={`Ilustração editorial de ${categories[category]}`} label={post.data.title} loading={featured ? "eager" : "lazy"}
      srcset={featuredSrcset}
      sizes={responsiveFeatured ? "(max-width: 600px) calc(100vw - 64px), (max-width: 1244px) 46vw, 540px" : undefined}
      fetchpriority={featured && blogMetaIcons ? "high" : undefined} />
  </div>

  <div class="post-card__body">
    <div class="post-card__eyebrow">
      <a class="post-card__category" href={categoryHref(category)}>{categories[category]}</a>
      <span aria-hidden="true">•</span>
      <span class="post-card__type">{post.data.type}</span>
      {showReadLink && <span class="post-card__featured-label">Em destaque</span>}
    </div>

    <h2><a href={postHref(post)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>

    <div class="post-card__meta">
      <span class="post-card__meta-item">
        {blogMetaIcons && <CategoryIcon icon="calendar" size={14} />}
        <time datetime={post.data.publishedAt.toISOString()}>
          {formatPostDate(post.data.publishedAt)}
        </time>
      </span>
      <span class="post-card__meta-item">
        {blogMetaIcons && <CategoryIcon icon="clock" size={14} />}
        <span>{post.data.readingTime} min de leitura</span>
      </span>
      {showReadLink && (
        <a class="blog-read-link" href={postHref(post)} aria-label={`Ler conteúdo: ${post.data.title}`}>
          Ler conteúdo <span aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span>
        </a>
      )}
    </div>
  </div>
</article>
