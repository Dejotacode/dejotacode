---
import CategoryIcon from "./CategoryIcon.astro";
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
  firstPagePath?: string;
}

const { currentPage, totalPages, basePath, firstPagePath = basePath } = Astro.props;

const pageHref = (page: number) =>
  page === 1 ? firstPagePath : `${basePath}${page}/`;

const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Paginação">
      {currentPage > 1 ? (
        <a class="pagination__direction" href={pageHref(currentPage - 1)} rel="prev">
          ← Anterior
        </a>
      ) : (
        <span class="pagination__direction pagination__direction--disabled" aria-disabled="true">
          ← Anterior
        </span>
      )}

      <div class="pagination__pages" aria-label="Páginas">
        {pages.map((page) =>
          page === currentPage ? (
            <span class="pagination__page is-current" aria-current="page">
              {page}
            </span>
          ) : (
            <a class="pagination__page" href={pageHref(page)} aria-label={`Ir para a página ${page}`}>
              {page}
            </a>
          ),
        )}
      </div>

      {currentPage < totalPages ? (
        <a class="pagination__direction" href={pageHref(currentPage + 1)} rel="next">
          Próxima <CategoryIcon icon="arrow-right" size={18} class="action-arrow" />
        </a>
      ) : (
        <span class="pagination__direction pagination__direction--disabled" aria-disabled="true">
          Próxima <CategoryIcon icon="arrow-right" size={18} class="action-arrow" />
        </span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .pagination__pages {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pagination__page,
  .pagination__direction {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: border-color var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast);
  }

  .pagination__direction {
    min-width: 0;
    padding-inline: 1rem;
  }

  .pagination__direction:last-child {
    justify-self: end;
  }

  .pagination a:hover,
  .pagination a:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-text);
    background: var(--color-surface-soft);
  }

  .pagination__page.is-current {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-weight: 700;
  }

  .pagination__direction--disabled {
    opacity: 0.6;
  }

  @media (max-width: 600px) {
    .pagination {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 0.75rem;
    }

    .pagination__pages {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .pagination__direction:first-child {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
    }

    .pagination__direction:last-child {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pagination__page,
    .pagination__direction {
      transition: none;
    }
  }
</style>
