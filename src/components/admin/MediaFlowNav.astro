---
const currentPath = Astro.url.pathname;

const maintenancePaths = [
  "/admin/midia/manutencao",
  "/admin/midia/cleanup",
  "/admin/midia/dry-run",
  "/admin/midia/snapshot",
  "/admin/midia/auditoria",
  "/admin/midia/pronto-exclusao",
  "/admin/midia/exclusao",
];

const items = [
  {
    href: "/admin/midia/",
    label: "Biblioteca",
    match: (path: string) => path === "/admin/midia/" || path.startsWith("/admin/midia/upload"),
  },
  {
    href: "/admin/midia/revisao/",
    label: "Revisão",
    match: (path: string) => path.startsWith("/admin/midia/revisao"),
  },
  {
    href: "/admin/midia/manutencao/",
    label: "Manutenção",
    match: (path: string) => maintenancePaths.some((prefix) => path.startsWith(prefix)),
  },
];
---

<nav class="media-flow-nav" aria-label="Navegação de mídia">
  <div class="media-flow-nav__inner">
    {items.map((item) => {
      const active = item.match(currentPath);
      return (
        <a
          class:list={["media-flow-nav__link", { "media-flow-nav__link--active": active }]}
          href={item.href}
          aria-current={active ? "page" : undefined}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</nav>

<style>
  .media-flow-nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-soft);
  }

  .media-flow-nav__inner {
    width: min(calc(100% - var(--space-page) - var(--space-page)), 68rem);
    margin-inline: auto;
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    padding-block: 0.6rem;
    scrollbar-width: thin;
  }

  .media-flow-nav__link {
    flex: 0 0 auto;
    min-height: 2.45rem;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
  }

  .media-flow-nav__link:hover,
  .media-flow-nav__link:focus-visible {
    color: var(--color-text);
    border-color: var(--color-border);
    background: var(--color-bg);
  }

  .media-flow-nav__link--active {
    color: var(--color-accent-strong);
    border-color: var(--color-border-strong);
    background: var(--color-surface);
  }
</style>
