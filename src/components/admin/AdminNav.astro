---
const currentPath = Astro.url.pathname;
const waitsForSession = currentPath === "/admin/";

const items = [
  { href: "/admin/", label: "Dashboard", match: (path: string) => path === "/admin/" },
  { href: "/admin/editor/", label: "Conteúdo", match: (path: string) => path.startsWith("/admin/editor") },
  { href: "/admin/midia/", label: "Mídia", match: (path: string) => path.startsWith("/admin/midia") },
  { href: "/admin/metricas/", label: "Métricas", match: (path: string) => path.startsWith("/admin/metricas") },
];
---

<nav class="admin-nav" aria-label="Navegação administrativa" data-admin-nav hidden={waitsForSession}>
  <div class="admin-nav__inner">
    {items.map((item) => {
      const active = item.match(currentPath);
      return (
        <a
          class:list={["admin-nav__link", { "admin-nav__link--active": active }]}
          href={item.href}
          aria-current={active ? "page" : undefined}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</nav>

<style>
  .admin-nav[hidden] {
    display: none;
  }

  .admin-nav {
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 96%, var(--color-surface));
  }

  .admin-nav__inner {
    width: min(calc(100% - var(--space-page) - var(--space-page)), 68rem);
    margin-inline: auto;
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    padding-block: 0.5rem;
    scrollbar-width: thin;
  }

  .admin-nav__link {
    position: relative;
    flex: 0 0 auto;
    min-height: var(--space-control);
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.78rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .admin-nav__link::after {
    content: "";
    position: absolute;
    right: 0.72rem;
    bottom: 0.18rem;
    left: 0.72rem;
    height: 2px;
    border-radius: 999px;
    background: var(--color-accent);
    opacity: 0;
    transform: scaleX(0.55);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .admin-nav__link:hover,
  .admin-nav__link:focus-visible {
    color: var(--color-text);
    border-color: var(--color-border);
    background: var(--color-surface-soft);
  }

  .admin-nav__link--active {
    color: var(--color-accent-strong);
    border-color: color-mix(in srgb, var(--color-accent) 32%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface-soft));
  }

  .admin-nav__link--active::after {
    opacity: 1;
    transform: scaleX(1);
  }
</style>
