---
import CategoryIcon from "../ui/CategoryIcon.astro";
import { getResourceDiscovery } from "../../data/resourceDiscovery";
import VisualMedia from "../visual/VisualMedia.astro";
import type { RecommendedResource } from "../../data/recommendedResources";
interface Props { resource: RecommendedResource; loading?: "eager" | "lazy"; compact?: boolean; }
const { resource, loading = "lazy", compact = false } = Astro.props;
const discovery = getResourceDiscovery(resource);
const categoryImage = `/assets/resources/category-${resource.category}.svg`;
const primaryMeta = resource.editorialLabel ?? (resource.storePath ? "DejotaStore" : resource.relationship === "affiliate" ? "Afiliado" : "Recurso");
const categoryLabels: Record<RecommendedResource["category"], string> = {
  desenvolvimento: "Desenvolvimento",
  digitais: "Ferramentas digitais",
  infraestrutura: "Infraestrutura",
  aprendizado: "Aprendizado",
  seguranca: "Segurança",
  "renda-digital": "Renda digital",
};
---
<article class:list={["resource-card-v2", { "resource-card-v2--compact": compact }]}>
  <div class="resource-card-v2__media">
    <VisualMedia
      src={resource.image ?? categoryImage}
      fallbackSrc={categoryImage}
      alt={resource.imageAlt ?? `Ilustração da categoria ${resource.category} para ${resource.name}`}
      label={resource.name}
      loading={loading}
    />
    <span class="resource-card-v2__category">{categoryLabels[resource.category]}</span>
  </div>
  <div class="resource-card-v2__body">
    <div class="resource-card-v2__meta"><span>{compact ? discovery.status : primaryMeta}</span></div>
    <h3>{resource.name}</h3>
    <p class="resource-card-v2__description">{compact ? discovery.summary : resource.description}</p>
    <p class="resource-card-v2__fit"><span>Ideal para</span><strong>{compact ? discovery.ideal : resource.bestFor}</strong></p>
    {resource.relationship === "affiliate" && <p class="resource-card-v2__affiliate"><small>{compact ? "Link de afiliado" : "Link de afiliado: o DejotaCode pode receber comissão por compras elegíveis."}</small></p>}
    <div class="resource-card-v2__actions" aria-label={`Caminhos para ${resource.name}`}>
      {resource.articlePath && <a class="button button-secondary" href={resource.articlePath} data-analytics-cta={`resource-${resource.id}-article`}>{resource.articleCta ?? "Ver conteúdo"}</a>}
      {resource.storePath && <a class="button button-primary" href={resource.storePath} data-analytics-cta={`resource-${resource.id}-store`}>Ver na DejotaStore</a>}
      {!resource.articlePath && !resource.storePath && <a class="button button-primary" href={resource.href} target="_blank" rel={resource.relationship === "affiliate" ? "sponsored nofollow noopener noreferrer" : "noopener noreferrer"} data-analytics-cta={`resource-${resource.id}`}>{resource.cta} <CategoryIcon icon="arrow-up-right" size={18} class="action-arrow" /></a>}
    </div>
    <details class="resource-card-v2__details">
      <summary>Critérios e limitações</summary>
      <p><strong>Contexto:</strong> {resource.description}</p>
      <p><strong>Ideal para:</strong> {resource.bestFor}</p>
      <p><strong>Registro editorial:</strong> {primaryMeta}</p>
      <p><strong>Custo:</strong> {resource.priceLabel}</p>
      <p><strong>Limitação:</strong> {resource.limitation}</p>
      <small>Revisado em {resource.lastReviewed}</small>
    </details>
  </div>
</article>

<style>
  .resource-card-v2__media :global(img[src$="-resource-v1.webp"]) { object-position: left top; }
</style>
