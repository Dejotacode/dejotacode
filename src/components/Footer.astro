---
import Brand from "./Brand.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container footer-grid">
    <div class="footer-brand">
      <Brand />
      <p>Tecnologia explicada para quem quer construir o futuro.</p>
    </div>

    <nav aria-label="Conteúdos">
      <h2>Conteúdos</h2>
      <a href="/blog/">Blog</a>
      <a href="/trilhas/">Trilhas</a>
      <a href="/recursos/">Recursos</a>
    </nav>

    <nav aria-label="Institucional">
      <h2>Institucional</h2>
      <a href="/sobre/">Sobre</a>
      <a href="/portfolio/">Portfólio</a>
      <a href="/servicos/">Serviços</a>
      <a href="/parcerias/">Parcerias</a>
      <a href="/contato/">Contato</a>
    </nav>

    <div>
      <h2>Conecte-se</h2>
      <div class="social-links">
        <a href="https://github.com/Dejotacode" target="_blank" rel="noopener noreferrer" aria-label="DejotaCode no GitHub">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.5 9.5 0 0 1 12 6.84a9.5 9.5 0 0 1 2.5.34c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path></svg>
        </a>
        <a href="/rss.xml" aria-label="Feed RSS da DejotaCode">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="5" cy="19" r="2"></circle><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path></svg>
        </a>
        <a href="/contato/" aria-label="Entre em contato com a DejotaCode">
          <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-container">
      <p>© {year} DejotaCode. Todos os direitos reservados.</p>
      <nav aria-label="Documentos legais">
        <a href="/politica-de-privacidade/">Política de Privacidade</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer { width: 100%; border-top: 1px solid var(--color-border); background: var(--color-footer); }
  .footer-container { width: min(calc(100% - (2 * var(--space-page))), var(--container)); margin-inline: auto; }
  .footer-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 2rem; padding-block: 3rem; }
  .footer-grid h2 { margin: 0 0 .75rem; font-size: .9rem; letter-spacing: 0; }
  .footer-grid nav > a { display: block; width: fit-content; margin-top: .45rem; color: var(--color-text-muted); font-size: .88rem; text-decoration: none; }
  .footer-grid a:hover { color: var(--color-accent-strong); }
  .footer-brand p { max-width: 22rem; margin: .75rem 0 0; font-size: .88rem; }
  .social-links { display: flex; flex-wrap: wrap; gap: .55rem; }
  .social-links a { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text-muted); }
  .social-links svg { width: 1.1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
  .social-links a:first-child svg { fill: currentColor; stroke: none; }
  .footer-bottom { border-top: 1px solid var(--color-border); }
  .footer-bottom .footer-container { min-height: 4.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--color-text-subtle); font-size: .78rem; }
  .footer-bottom p { margin: 0; color: inherit; }
  .footer-bottom a { color: inherit; }
  @media (max-width: 50rem) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 32rem) { .footer-grid { grid-template-columns: 1fr; } .footer-brand { grid-column: auto; } .footer-bottom .footer-container { align-items: flex-start; flex-direction: column; justify-content: center; padding-block: 1rem; } }
</style>
