        </a>
      </div>
    </div>

    <nav aria-label="Conteúdos">
      <h2>Explorar</h2>
      <a href="/blog/">Blog</a>
      <a href="/trilhas/">Trilhas</a>
      <a href="/recursos/">Recursos</a>
      <a href="/store/">DejotaStore</a>
    </nav>

    <nav aria-label="Institucional">
      <h2>Projeto</h2>
      <a href="/sobre/">Sobre</a>
      <a href="/portfolio/">Portfólio</a>
      <a href="/servicos/">Serviços</a>
      <a href="/parcerias/">Parcerias</a>
      <a href="/contato/">Contato</a>
      <a href="/store/setup-do-dejota/">Setup do Dejota</a>
    </nav>

    <nav class="footer-transparency" aria-label="Transparência">
      <h2>Transparência</h2>
      <a class="footer-text-link" href="/store/como-avaliamos/">Como avaliamos</a>
      <a class="footer-text-link" href="/politica-de-privacidade/">Política de Privacidade</a>
      <a class="footer-text-link" href="/rss.xml">RSS</a>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="footer-container">
      <p>© {year} DejotaCode. Todos os direitos reservados.</p>

    </div>
  </div>
</footer>

<style>
  .site-footer { width: 100%; border-top: 1px solid var(--color-border); background: var(--color-footer); }
  .footer-container { width: min(calc(100% - (2 * var(--space-page))), var(--container)); margin-inline: auto; }
  .footer-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); padding-block: 2.5rem 2.25rem; }
  .footer-grid h2 { margin: 0 0 .65rem; font-size: .9rem; letter-spacing: 0; }
  .footer-grid nav > a { display: block; width: fit-content; min-height: 1.5rem; margin-top: .35rem; color: var(--color-text-muted); font-size: .88rem; text-decoration: none; }
  .footer-grid a:hover { color: var(--color-accent-strong); }
  .footer-grid a:focus-visible { outline: 2px solid var(--color-accent-strong); outline-offset: 3px; }
  .footer-brand p { max-width: 23rem; margin: .75rem 0 0; font-size: .92rem; line-height: 1.65; }
  .footer-brand .footer-brand__tagline { font-size: .85rem; font-weight: 650; }
  .social-links { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1rem; }
  .social-links a { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text-muted); transition: color .18s ease, border-color .18s ease, background-color .18s ease, transform .18s ease; }
  .social-links a:hover { color: var(--color-accent-strong); border-color: color-mix(in srgb, var(--color-accent-strong) 55%, var(--color-border)); background: color-mix(in srgb, var(--color-accent-strong) 8%, transparent); transform: translateY(-1px); }
  .social-links svg { width: 1.1rem; height: 1.1rem; fill: currentColor; stroke: none; }
  .footer-bottom { border-top: 1px solid var(--color-border); }
  .footer-bottom .footer-container { min-height: 4.25rem; display: flex; align-items: center; padding-block: 1rem; color: var(--color-text-subtle); font-size: .78rem; }
  .footer-bottom p { margin: 0; color: inherit; }
  @media (max-width: 50rem) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; padding-block: 2rem; }
    .footer-brand { grid-column: 1 / -1; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
    .footer-transparency { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .social-links a { transition: none; }
    .social-links a:hover { transform: none; }
  }
</style>
