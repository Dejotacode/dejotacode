        </a>
        <a href="https://www.linkedin.com/in/dejotacode/" target="_blank" rel="noopener noreferrer" aria-label="DejotaCode no LinkedIn">
          <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="9" width="4" height="11" rx=".5"></rect><path d="M6 4.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM11 20V9h4v1.7c.9-1.3 2.1-2.1 4-2.1 3 0 4 2 4 5.3V20h-4v-5.4c0-1.5-.5-2.5-1.9-2.5-1.6 0-2.1 1.1-2.1 3V20h-4Z"></path></svg>
