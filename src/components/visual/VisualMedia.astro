---
interface Props {
  src?: string;
  alt?: string;
  label?: string;
  aspect?: "wide" | "card" | "square";
  loading?: "eager" | "lazy";
  fallbackSrc?: string;
}
const { src, alt = "", label = "DejotaCode", aspect = "wide", loading = "lazy", fallbackSrc } = Astro.props;
const dimensions = aspect === "square" ? { width: 900, height: 900 } : aspect === "card" ? { width: 1200, height: 900 } : { width: 1600, height: 900 };
---
<div class:list={["visual-media", `visual-media--${aspect}`, { "visual-media--fallback": !src }]}>
  {src ? (
    <img
      src={src}
      alt={alt}
      width={dimensions.width}
      height={dimensions.height}
      loading={loading}
      decoding="async"
      onerror={fallbackSrc ? `this.onerror=null;this.src=\'${fallbackSrc}\'` : undefined}
    />
  ) : (
    <div class="visual-media__fallback" aria-hidden="true">
      <span class="visual-media__brand" aria-hidden="true"></span>
      <span>{label}</span>
    </div>
  )}
</div>

<style>
  .visual-media { position: relative; overflow: hidden; width: 100%; border: 1px solid var(--color-border); background: var(--color-surface-soft); }
  .visual-media--wide { aspect-ratio: 16 / 9; }
  .visual-media--card { aspect-ratio: 4 / 3; }
  .visual-media--square { aspect-ratio: 1; }
  .visual-media img { width: 100%; height: 100%; object-fit: cover; }
  .visual-media img[src$="-capa-v1.webp"] { object-position: left top; }
  .visual-media__fallback { width: 100%; height: 100%; display: grid; place-items: center; align-content: center; gap: .7rem; padding: 1.2rem; background: radial-gradient(circle at 50% 35%, var(--color-glow), transparent 38%), var(--color-surface-soft); }
  .visual-media__brand { display:block; background: center / contain no-repeat var(--brand-symbol); width: 3.2rem; height: 3.2rem; object-fit: contain; opacity: .9; }
  .visual-media__fallback span { color: var(--color-text-muted); font: 700 .78rem/1 var(--font-code); letter-spacing: .08em; text-transform: uppercase; }
</style>
