---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import type { OfficialIconId } from "../../data/categoryIcons";
import { getPublishedPosts } from "../../lib/content";
import { availableTrails } from "../../data/trails";
import "../../styles/portfolio.css";
const posts = await getPublishedPosts();
const summary: {icon: OfficialIconId; title: string; description: string}[] = [
{icon:"browser",title:"Projeto próprio",description:"Idealizado e desenvolvido por Dejota."},
{icon:"news",title:"Portal educativo",description:"Conteúdo e trilhas para quem está começando."},
{icon:"code",title:"Design e desenvolvimento",description:"Da ideia à implementação, com foco na experiência."},
{icon:"workflow",title:"Em evolução",description:"Novas ideias e conteúdos são adicionados."}];
const views = [
{id:"home",href:"/",title:"Home — ponto de partida",description:"Apresenta o projeto e facilita o acesso a conteúdos, trilhas e recursos."},
{id:"blog",href:"/blog/",title:"Blog — conteúdo organizado",description:"Artigos e tutoriais por assunto, com leitura clara e próximos passos."},
{id:"trilhas",href:"/trilhas/",title:"Trilhas — aprendizado com direção",description:"Percursos que conectam os conteúdos e ajudam a escolher o que estudar depois."}];
const deliveries: {icon: OfficialIconId; title: string; description: string}[] = [
{icon:"news",title:"Conteúdo organizado",description:`${posts.length} artigos e tutoriais, com ${availableTrails.length} trilhas disponíveis para orientar o aprendizado.`},
{icon:"network",title:"Navegação consistente",description:"Blog, trilhas e recursos conectados, com uma identidade visual presente em todo o portal."},
{icon:"workflow",title:"Base preparada para evoluir",description:"Componentes reutilizáveis e verificações de qualidade para receber novos conteúdos e recursos."}];
---
<BaseLayout title="Case DejotaCode: produto, conteúdo e engenharia | DejotaCode" description="Estudo de caso do DejotaCode: problema, decisões de produto, arquitetura, SEO, conteúdo, conversão, CI e aprendizados verificáveis do projeto.">
<main id="conteudo" tabindex="-1" class="portfolio-page"><div class="container">
<header class="portfolio-hero"><div><p class="eyebrow">PORTFÓLIO</p><h1>Conteúdo, design e desenvolvimento na prática.</h1><p class="portfolio-lead">Conheça as decisões por trás do DejotaCode, um projeto próprio em constante evolução.</p><a class="button button-primary" href="#projeto">Conhecer o projeto <span aria-hidden="true">↓</span></a></div><div class="portfolio-browser"><div class="portfolio-browser__bar" aria-hidden="true"><span class="portfolio-browser__dots"><i></i><i></i><i></i></span><span>dejotacode.com</span></div><img src="/assets/portfolio/home.webp" alt="Captura real da página inicial do DejotaCode no tema escuro" width="1280" height="960" loading="eager" decoding="async" /></div></header>
<section class="portfolio-summary" aria-label="Resumo do projeto">{summary.map(item => <div><CategoryIcon icon={item.icon} size={30}/><div><h2>{item.title}</h2><p>{item.description}</p></div></div>)}</section>
<section id="projeto" class="portfolio-about portfolio-section" aria-labelledby="portfolio-project-title"><div><p class="eyebrow">SOBRE</p><h2 id="portfolio-project-title">O projeto DejotaCode</h2><p>O DejotaCode é um portal educativo criado para ajudar iniciantes a encontrar conteúdo sobre tecnologia, com trilhas de aprendizado e materiais organizados de forma simples e prática.</p></div><article class="portfolio-panel"><CategoryIcon icon="checklist" size={28}/><h3>O desafio</h3><p>Transformar opções demais e sequência de menos em um caminho compreensível para quem está começando.</p></article><article class="portfolio-panel"><CategoryIcon icon="browser" size={28}/><h3>A solução</h3><p>Um portal com artigos, trilhas e recursos conectados, com explicações práticas e uma continuação clara.</p></article></section>
<section class="portfolio-section" aria-labelledby="portfolio-views-title"><div class="portfolio-heading"><p class="eyebrow">VISUALIZAÇÃO</p><h2 id="portfolio-views-title">Uma experiência conectada</h2><p>As principais partes do DejotaCode trabalhando juntas para orientar o aprendizado.</p></div><div class="portfolio-gallery">{views.map(view => <a class="portfolio-view" href={view.href}><div class="portfolio-browser"><div class="portfolio-browser__bar" aria-hidden="true"><span class="portfolio-browser__dots"><i></i><i></i><i></i></span><span>DejotaCode</span></div><img src={`/assets/portfolio/${view.id}.webp`} alt={`Captura real: ${view.title}`} width="1280" height="960" loading="lazy" decoding="async" /></div><h3>{view.title} <span aria-hidden="true">↗</span></h3><p>{view.description}</p></a>)}</div></section>
<section class="portfolio-section" aria-labelledby="portfolio-deliveries-title"><div class="portfolio-heading"><p class="eyebrow">DETALHES</p><h2 id="portfolio-deliveries-title">O que foi construído</h2></div><div class="portfolio-deliveries">{deliveries.map(item => <article class="portfolio-panel"><CategoryIcon icon={item.icon} size={32}/><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div></section>
<section class="portfolio-section" aria-labelledby="portfolio-tech-title"><div class="portfolio-tech-heading"><div><p class="eyebrow">TECNOLOGIAS E PROCESSO</p><h2 id="portfolio-tech-title">Tecnologias e processo</h2><p>Ferramentas escolhidas para organizar o conteúdo, facilitar a manutenção e sustentar a evolução do projeto.</p></div><ul class="portfolio-technologies" aria-label="Tecnologias utilizadas"><li><CategoryIcon icon="code" size={28}/><span>Astro</span></li><li><strong aria-hidden="true">TS</strong><span>TypeScript</span></li><li><CategoryIcon icon="cloud-server" size={28}/><span>Cloudflare</span></li><li><CategoryIcon icon="workflow" size={28}/><span>GitHub</span></li></ul></div>
<div class="portfolio-details"><details><summary>Decisões técnicas <span aria-hidden="true">+</span></summary><div class="portfolio-detail-body"><h3>Responsabilidades separadas por camada</h3><p>O frontend é gerado estaticamente com Astro e TypeScript. Formulários e métricas ficam em uma API separada em Cloudflare Workers, mantendo leitura e navegação independentes desses serviços.</p><ul><li>Cloudflare Pages no frontend e D1 para persistência na API. R2 está previsto para mídia do ecossistema.</li><li>Conteúdo estruturado em Blog e Trilhas, com componentes reutilizáveis.</li><li>Metadados por rota, dados estruturados, canonical, RSS, sitemap e links internos contextuais.</li><li>Guia gratuito e newsletter com consentimento explícito no envio.</li><li>Analytics first-party agregado para páginas e chamadas, sem cookies ou fingerprinting nesse fluxo.</li><li>GitHub Actions executa instalação determinística, Astro check e build em pull requests e pushes para main, sem credenciais de deploy no workflow.</li></ul></div></details><details><summary>Como o projeto evolui <span aria-hidden="true">+</span></summary><div class="portfolio-detail-body"><h3>Auditar, ajustar e validar</h3><p>As mudanças partem de uma revisão do estado atual, seguem um escopo definido e passam por comparação visual e verificações de qualidade. Integração de código e publicação são etapas separadas.</p><p>Branches pequenas, revisão de diff e CI antes da integração ajudam a reduzir retrabalho. Deploy, tag e release permanecem separados desse fluxo.</p><h3>Aprendizados que orientam as próximas entregas</h3><ul><li>Conteúdo também é arquitetura: categorias, trilhas, links e próximas ações precisam funcionar juntos.</li><li>Métricas precisam responder perguntas úteis sobre o projeto.</li><li>Verificações automáticas fazem da qualidade básica uma condição do desenvolvimento.</li><li>Recomendações precisam de contexto; o projeto evita promessas de enriquecimento e resultados inventados.</li></ul><a href="/sobre/">Conhecer os princípios editoriais →</a></div></details></div><p class="portfolio-transparency">Este é um projeto próprio em evolução. As entregas descrevem o produto e seu desenvolvimento; não representam resultados de audiência, receita ou conversão.</p></section>
<section class="portfolio-cta" aria-labelledby="portfolio-cta-title"><div><p class="eyebrow">VAMOS CONVERSAR?</p><h2 id="portfolio-cta-title">Vamos tirar sua ideia do papel?</h2><p>Conheça os serviços e converse sobre seu projeto.</p></div><div class="portfolio-cta__actions"><a class="button button-primary" href="/servicos/" data-analytics-cta="portfolio-services">Conhecer serviços <span aria-hidden="true">→</span></a><a class="button button-secondary" href="/contato/">Conversar sobre um projeto</a></div></section>
</div></main></BaseLayout>
