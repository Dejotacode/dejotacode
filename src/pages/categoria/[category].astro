---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Pagination from "../../components/ui/Pagination.astro";
import PostCard from "../../components/content/PostCard.astro";
import CategoryIcon from "../../components/ui/CategoryIcon.astro";
import { getOfficialCategoryIcon } from "../../data/categoryIcons";
import {
  categories,
  categoryDescriptions,
  getPublishedPosts,
  postHref,
  type CategorySlug,
} from "../../lib/content";
import "../../styles/editorial.css";
import "../../styles/discovery.css";

const PAGE_SIZE = 6;

const categorySeoOverrides: Partial<Record<CategorySlug, string>> = {
  "linux-seguranca": "Linux e segurança digital para iniciantes | DejotaCode",
  "inteligencia-artificial": "Inteligência artificial para iniciantes | DejotaCode",
  "tecnologia-pratica": "Tecnologia prática para iniciantes | DejotaCode",
};

export function getStaticPaths() {
  return Object.entries(categories).map(([category, label]) => ({
    params: { category },
    props: { category: category as CategorySlug, label },
  }));
}

interface Props {
  category: CategorySlug;
  label: string;
}

const { category, label } = Astro.props;
const categoryIcon = getOfficialCategoryIcon(category);
const posts = (await getPublishedPosts()).filter(
  (post) => post.data.category === category,
);
const visiblePosts = posts.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const seoTitle =
  categorySeoOverrides[category] ?? `${label} para iniciantes | DejotaCode`;

const canonicalUrl = new URL(
  `/categoria/${category}/`,
  Astro.site ?? Astro.url.origin,
);

const categoryListId = `${canonicalUrl.href}#itemlist`;

const categorySchema =
  posts.length > 0
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "CollectionPage",
            "@id": canonicalUrl.href,
            url: canonicalUrl.href,
            name: seoTitle,
            description: categoryDescriptions[category],
            inLanguage: "pt-BR",
            mainEntity: { "@id": categoryListId },
            isPartOf: { "@id": "https://dejotacode.com.br/#website" },
          },
          {
            "@type": "ItemList",
            "@id": categoryListId,
            numberOfItems: visiblePosts.length,
            itemListOrder: "https://schema.org/ItemListOrderDescending",
            itemListElement: visiblePosts.map((post, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: post.data.title,
              url: new URL(postHref(post), canonicalUrl).href,
            })),
          },
          {
            "@type": "BreadcrumbList",
            itemListElement: [
              { "@type": "ListItem", position: 1, name: "Início", item: new URL("/", canonicalUrl).href },
              { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", canonicalUrl).href },
              { "@type": "ListItem", position: 3, name: label, item: canonicalUrl.href },
            ],
          },
        ],
      }
    : null;
---

<BaseLayout
  title={seoTitle}
  description={categoryDescriptions[category]}
  robots={posts.length > 0 ? "index, follow" : "noindex, follow"}
>
  {
    categorySchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(categorySchema)} />
    )
  }

  <main id="conteudo" tabindex="-1" class="editorial-page discovery-page category-page">
    <header class="editorial-hero container">
      <nav class="breadcrumbs" aria-label="Navegação estrutural">
        <a href="/">Início</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/">Blog</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{label}</span>
      </nav>

      <div class="discovery-category-kicker">
        {categoryIcon && <CategoryIcon icon={categoryIcon.iconId} size={24} label={`Ícone de ${label}`} />}
        <p class="eyebrow">CATEGORIA</p>
      </div>
      <h1>{label}</h1>
      <p class="editorial-hero__lead">{categoryDescriptions[category]}</p>

      <div class="discovery-summary">
        <strong>{posts.length}</strong>
        <span>{posts.length === 1 ? "conteúdo publicado" : "conteúdos publicados"}</span>
      </div>

      {
        category === "renda-digital" && (
          <p class="discovery-guided-path">
            Prefere aprender em sequência?
            <a href="/trilhas/primeira-renda-online/">Seguir a trilha Primeira Renda Online <CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></a>
          </p>
        )
      }
    </header>

    <nav class="container discovery-categories" aria-label="Assuntos do Blog">
      {Object.entries(categories).map(([slug, name]) => {
        const icon = getOfficialCategoryIcon(slug);
        return <a href={`/categoria/${slug}/`} aria-current={slug === category ? "page" : undefined}>{icon && <CategoryIcon icon={icon.iconId} size={18} />}<span>{name}</span></a>;
      })}
    </nav>

    <section class="editorial-section container" aria-labelledby="category-posts-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EXPLORE O ASSUNTO</p>
          <h2 id="category-posts-title">Publicações</h2>
        </div>
        <a class="discovery-link" href="/blog/">Ver todo o blog <CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></a>
      </div>

      {
        posts.length > 0 ? (
          <>
            <div class="post-grid">
              {visiblePosts.map((post) => <PostCard post={post} blogMetaIcons />)}
            </div>
            <Pagination
              currentPage={1}
              totalPages={totalPages}
              basePath={`/categoria/${category}/`}
            />
          </>
        ) : (
          <div class="empty-state">
            <p class="eyebrow">EM PREPARAÇÃO</p>
            <h2>Os primeiros conteúdos desta categoria estão a caminho.</h2>
            <p>Enquanto isso, você pode explorar as outras publicações do DejotaCode.</p>
            <a class="button button-primary" href="/blog/">Explorar o blog</a>
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>
