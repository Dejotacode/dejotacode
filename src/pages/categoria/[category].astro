---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import {
  categories,
  categoryDescriptions,
  getPublishedPosts,
  postHref,
  type CategorySlug,
} from "../../lib/content";
import "../../styles/editorial.css";
import "../../styles/discovery.css";

export function getStaticPaths() {
  return Object.entries(categories).map(([category, label]) => ({
    params: { category },
    props: { category: category as CategorySlug, label },
  }));
}

interface Props {
  category: CategorySlug;
  label: string;
}

const { category, label } = Astro.props;
const posts = (await getPublishedPosts()).filter(
  (post) => post.data.category === category,
);

const canonicalUrl = new URL(
  `/categoria/${category}/`,
  Astro.site ?? Astro.url.origin,
);

const categoryListId = `${canonicalUrl.href}#itemlist`;

const categorySchema =
  posts.length > 0
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "CollectionPage",
            "@id": canonicalUrl.href,
            url: canonicalUrl.href,
            name: `${label} | DejotaCode`,
            description: categoryDescriptions[category],
            inLanguage: "pt-BR",
            mainEntity: {
              "@id": categoryListId,
            },
            isPartOf: {
              "@id": "https://dejotacode.com.br/#website",
            },
          },
          {
            "@type": "ItemList",
            "@id": categoryListId,
            numberOfItems: posts.length,
            itemListOrder: "https://schema.org/ItemListOrderDescending",
            itemListElement: posts.map((post, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: post.data.title,
              url: new URL(postHref(post), canonicalUrl).href,
            })),
          },
          {
            "@type": "BreadcrumbList",
            itemListElement: [
              {
                "@type": "ListItem",
                position: 1,
                name: "Início",
                item: new URL("/", canonicalUrl).href,
              },
              {
                "@type": "ListItem",
                position: 2,
                name: "Blog",
                item: new URL("/blog/", canonicalUrl).href,
              },
              {
                "@type": "ListItem",
                position: 3,
                name: label,
                item: canonicalUrl.href,
              },
            ],
          },
        ],
      }
    : null;
---

<BaseLayout
  title={`${label} | DejotaCode`}
  description={categoryDescriptions[category]}
  robots={posts.length > 0 ? "index, follow" : "noindex, follow"}
>
  {
    categorySchema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(categorySchema)}
      />
    )
  }

  <main id="conteudo" tabindex="-1" class="editorial-page discovery-page">
    <header class="editorial-hero container">
      <nav class="breadcrumbs" aria-label="Navegação estrutural">
        <a href="/">Início</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/">Blog</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{label}</span>
      </nav>

      <p class="eyebrow">CATEGORIA</p>
      <h1>{label}</h1>
      <p class="editorial-hero__lead">{categoryDescriptions[category]}</p>

      <div class="discovery-summary">
        <strong>{posts.length}</strong>
        <span>{posts.length === 1 ? "conteúdo publicado" : "conteúdos publicados"}</span>
      </div>
    </header>

    <section class="editorial-section container" aria-labelledby="category-posts-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EXPLORE O ASSUNTO</p>
          <h2 id="category-posts-title">Publicações</h2>
        </div>
        <a class="discovery-link" href="/blog/">Ver todo o blog →</a>
      </div>

      {
        posts.length > 0 ? (
          <div class="post-grid">
            {posts.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <div class="empty-state">
            <p class="eyebrow">EM PREPARAÇÃO</p>
            <h2>Os primeiros conteúdos desta categoria estão a caminho.</h2>
            <p>Enquanto isso, você pode explorar as outras publicações do DejotaCode.</p>
            <a class="button button-primary" href="/blog/">Explorar o blog</a>
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>
