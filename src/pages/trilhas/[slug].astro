---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { availableTrails, type Trail } from "../../data/trails";
import VisualMedia from "../../components/visual/VisualMedia.astro";
import CategoryIcon from "../../components/ui/CategoryIcon.astro";
import { resolveTrailVisual } from "../../data/editorialVisuals";
import "../../styles/trails.css";

export function getStaticPaths() {
  return availableTrails.map((trail) => ({
    params: { slug: trail.slug },
    props: { trail },
  }));
}

interface Props {
  trail: Trail;
}

const { trail } = Astro.props;
const totalDuration = trail.lessons.reduce((total, lesson) => total + lesson.duration, 0);
const trailVisual = resolveTrailVisual(trail.slug);

const canonicalUrl = new URL(
  `/trilhas/${trail.slug}/`,
  Astro.site ?? Astro.url.origin,
);

const trailListId = `${canonicalUrl.href}#etapas`;

const trailBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Início",
      item: new URL("/", canonicalUrl).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Trilhas",
      item: new URL("/trilhas/", canonicalUrl).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: trail.title,
      item: canonicalUrl.href,
    },
  ],
};

const trailListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": trailListId,
  name: `Etapas da trilha ${trail.title}`,
  numberOfItems: trail.lessons.length,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: trail.lessons.map((lesson) => ({
    "@type": "ListItem",
    position: lesson.order,
    name: lesson.title,
    url: new URL(`/blog/${lesson.slug}/`, canonicalUrl).href,
  })),
};
---

<BaseLayout title={`${trail.title} | DejotaCode`} description={trail.description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(trailBreadcrumbSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(trailListSchema)}
  />

  <main id="conteudo" tabindex="-1" class="trail-detail" data-trail={trail.slug}>
    <header class="trail-detail__hero container">
      <nav class="trail-breadcrumbs" aria-label="Navegação estrutural">
        <a href="/">Início</a><span aria-hidden="true">/</span>
        <a href="/trilhas/">Trilhas</a><span aria-hidden="true">/</span>
        <span aria-current="page">{trail.title}</span>
      </nav>

      <div>
        <p class="eyebrow"><CategoryIcon icon={trail.iconId} size={24} /> APRENDA NO SEU RITMO</p>
        <h1>{trail.title}</h1>
        <p>{trail.description}</p>
        <div class="trail-detail__meta">
          <span>{trail.lessons.length} etapas</span>
          <span>{totalDuration} min de leitura estimada</span>
          <span>Progresso local</span>
        </div>
        <a class="button button-primary" href={`/blog/${trail.lessons[0].slug}/`} data-trail-start>Começar trilha →</a>
      </div>

      <div class="trail-detail__aside">
        <div class="trail-detail__media">
          <VisualMedia src={trailVisual} fallbackSrc="/assets/resources/category-aprendizado.svg" alt={`Ilustração editorial da trilha ${trail.title}`} label={trail.title} loading="eager" />
          <span><CategoryIcon icon={trail.iconId} size={24} /></span>
        </div>

      </div>
    </header>

    <section class="trail-outcome container">
      <div>
        <p class="eyebrow">OBJETIVO DA TRILHA</p>

        <p>{trail.outcome}</p>
      </div>
    </section>

    <section class="trail-lessons container" aria-labelledby="lessons-title">
      <div class="trails-heading">
        <div>
          <p class="eyebrow">PASSO A PASSO</p>
          <h2 id="lessons-title">Seu caminho de aprendizagem</h2>
        </div>
        <div class="trail-progress-card">
          <div class="trail-progress-card__top">
            <span>Seu progresso</span>
            <strong data-progress-percent>0%</strong>
          </div>
          <div
            class="trail-progress"
            role="progressbar"
            aria-label="Progresso na trilha"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            data-progress-bar
          ><span data-progress-fill></span></div>
          <p data-progress-label>Comece pela primeira etapa.</p>
        </div>
      </div>

      <ol class="lesson-list">
        {
          trail.lessons.map((lesson) => (
            <li class="lesson" data-lesson={lesson.slug} data-optional={lesson.optional ? "true" : "false"}>
              <span class="lesson__number" aria-hidden="true"><CategoryIcon icon="checklist" size={22} /></span>
              <div class="lesson__content">
                <div class="lesson__meta">
                  <span>{lesson.optional ? "Opcional" : "Essencial"}</span>
                  <span>{lesson.duration} min</span>
                </div>
                <h3>
                  <a
                    href={`/blog/${lesson.slug}/`}
                    data-lesson-link={lesson.slug}
                  >
                    {lesson.title}
                  </a>
                </h3>
                <p>{lesson.description}</p>
              </div>
              <a class="lesson__read" href={`/blog/${lesson.slug}/`} data-lesson-read={lesson.slug} aria-label={`Ler conteúdo: ${lesson.title}`}>Ler conteúdo <span aria-hidden="true">→</span></a>
              <button
                class="lesson__check"
                type="button"
                aria-pressed="false"
                aria-label={`Marcar “${lesson.title}” como concluída`}
                data-lesson-toggle
              ><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg><span>Concluir</span></button>
            </li>
          ))
        }
      </ol>



      {
        trail.slug === "primeira-renda-online" && (
          <aside class="trail-related" aria-label="Conteúdos relacionados à trilha">
            <p class="eyebrow">EXPLORE NO SEU RITMO</p>
            <h2>Quer navegar pelos conteúdos sem seguir a sequência?</h2>
            <p>A categoria Renda Digital reúne todos os artigos desta trilha e conteúdos complementares em uma única área.</p>
            <a class="button button-secondary" href="/categoria/renda-digital/">Explorar Renda Digital</a>
          </aside>
        )
      }

      <aside class="trail-privacy">
        <strong>Seu progresso fica neste navegador.</strong>
        <p>
          Não é necessário criar conta. O progresso detalhado não é enviado ao
          DejotaCode; apenas interações agregadas da trilha podem ser
          contabilizadas, sem identificação pessoal.
        </p>
        <button type="button" data-progress-reset>Reiniciar progresso</button>
      </aside>
    </section>
      {trail.slug === "linux-do-zero" && (
        <aside class="trail-interest container" aria-labelledby="linux-ebook-interest-title">
          <img src="/assets/products/linux-do-zero/cover.png" alt="Capa do e-book Linux do Zero" width="911" height="1287" loading="lazy" decoding="async" />
          <div><p class="eyebrow">PARA APROFUNDAR · PRODUTO DEJOTACODE</p>
          <h2 id="linux-ebook-interest-title">Aprofunde seus estudos com o e-book Linux do Zero</h2>
          <p><strong>88 páginas para iniciantes</strong>, com instalação segura, terminal, permissões e solução de problemas.</p>
          <p class="trail-interest__price"><span>Preço de lançamento</span><strong>R$ 19,90</strong></p>
          <a class="button button-primary" href="/produtos/linux-do-zero/" data-analytics-cta="trail-linux-ebook-product">Conhecer o e-book →</a></div>
        </aside>
      )}
    <p class="trail-back container"><a href="/trilhas/">← Todas as trilhas</a></p>
  </main>

  <script>
    import { sendAnalyticsEvent } from "../../scripts/analytics";

    const root = document.querySelector<HTMLElement>("[data-trail]");

    if (root) {
      const trailSlug = root.dataset.trail ?? "";
      const apiBase =
        typeof window.__DEJOTACODE_API_BASE__ === "string"
          ? window.__DEJOTACODE_API_BASE__
          : "";
      const storageKey = `dejotacode:trail:${trailSlug}`;
      const analyticsStartKey =
        `dejotacode:trail-session-start:${trailSlug}`;
      const analyticsCompleteKey =
        `dejotacode:trail-session-complete:${trailSlug}`;
      const lessons = Array.from(
        root.querySelectorAll<HTMLElement>("[data-lesson]"),
      );
      const requiredLessons = lessons.filter(
        (lesson) => lesson.dataset.optional !== "true",
      );
      const progressBar =
        root.querySelector<HTMLElement>("[data-progress-bar]");
      const progressFill =
        root.querySelector<HTMLElement>("[data-progress-fill]");
      const progressPercent =
        root.querySelector<HTMLElement>("[data-progress-percent]");
      const progressLabel =
        root.querySelector<HTMLElement>("[data-progress-label]");
      const resetButton =
        root.querySelector<HTMLButtonElement>("[data-progress-reset]");

      const readProgress = (): string[] => {
        try {
          const saved =
            JSON.parse(localStorage.getItem(storageKey) ?? "[]");

          return Array.isArray(saved)
            ? saved.filter((item) => typeof item === "string")
            : [];
        } catch {
          return [];
        }
      };

      const hasAnalyticsMarker = (key: string) => {
        try {
          return sessionStorage.getItem(key) === "1";
        } catch {
          return false;
        }
      };

      const setAnalyticsMarker = (key: string) => {
        try {
          sessionStorage.setItem(key, "1");
        } catch {
          // Analytics must never block trail progress.
        }
      };

      const trackTrailStart = () => {
        if (!trailSlug || hasAnalyticsMarker(analyticsStartKey)) return;

        setAnalyticsMarker(analyticsStartKey);
        sendAnalyticsEvent(apiBase, "trail_start", trailSlug);
      };

      const isTrailComplete = () =>
        requiredLessons.length > 0 &&
        requiredLessons.every((lesson) =>
          completed.has(lesson.dataset.lesson ?? ""),
        );

      let completed = new Set(readProgress());

      const renderProgress = () => {
        lessons.forEach((lesson) => {
          const slug = lesson.dataset.lesson ?? "";
          const isCompleted = completed.has(slug);
          const toggle =
            lesson.querySelector<HTMLButtonElement>("[data-lesson-toggle]");

          lesson.classList.toggle("is-complete", isCompleted);
          toggle?.setAttribute("aria-pressed", String(isCompleted));
          toggle?.setAttribute("aria-label", `${isCompleted ? "Desmarcar" : "Marcar"} “${lesson.querySelector("h3")?.textContent?.trim()}” como concluída`);
          const toggleLabel = toggle?.querySelector("span");
          if (toggleLabel) toggleLabel.textContent = isCompleted ? "Concluída" : "Concluir";
        });

        const completedCount = requiredLessons.filter((lesson) =>
          completed.has(lesson.dataset.lesson ?? ""),
        ).length;
        const percentage = requiredLessons.length
          ? Math.round((completedCount / requiredLessons.length) * 100)
          : 0;

        const startLink = root.querySelector<HTMLAnchorElement>("[data-trail-start]");
        const nextLesson = requiredLessons.find((lesson) => !completed.has(lesson.dataset.lesson ?? ""));
        if (startLink) {
          startLink.href = nextLesson?.querySelector<HTMLAnchorElement>("[data-lesson-link]")?.href ?? "#lessons-title";
          startLink.textContent = percentage === 100 ? "Rever etapas →" : completedCount ? "Continuar trilha →" : "Começar trilha →";
        }

        if (progressFill) progressFill.style.width = `${percentage}%`;
        if (progressPercent) progressPercent.textContent = `${percentage}%`;
        if (progressBar) {
          progressBar.setAttribute("aria-valuenow", String(percentage));
        }

        if (progressLabel) {
          progressLabel.textContent = percentage === 100
            ? "Trilha concluída. Parabéns por chegar até aqui!"
            : completedCount === 0
              ? "Comece pela primeira etapa."
              : `${completedCount} de ${requiredLessons.length} etapas essenciais concluídas.`;
        }
      };

      lessons.forEach((lesson) => {
        const lessonSlug = lesson.dataset.lesson ?? "";
        const link =
          lesson.querySelector<HTMLAnchorElement>("[data-lesson-link]");
        const toggle =
          lesson.querySelector<HTMLButtonElement>("[data-lesson-toggle]");

        link?.addEventListener("click", () => {
          trackTrailStart();

          if (trailSlug && lessonSlug) {
            sendAnalyticsEvent(
              apiBase,
              "trail_lesson_click",
              `${trailSlug}:${lessonSlug}`,
            );
          }
        });

        toggle?.addEventListener("click", () => {
          trackTrailStart();

          const wasComplete = isTrailComplete();

          completed.has(lessonSlug)
            ? completed.delete(lessonSlug)
            : completed.add(lessonSlug);

          try {
            localStorage.setItem(storageKey, JSON.stringify([...completed]));
          } catch {
            // Keep progress usable during this visit when storage is unavailable.
          }

          const becameComplete =
            !wasComplete && isTrailComplete();

          if (
            becameComplete &&
            trailSlug &&
            !hasAnalyticsMarker(analyticsCompleteKey)
          ) {
            setAnalyticsMarker(analyticsCompleteKey);
            sendAnalyticsEvent(
              apiBase,
              "trail_complete",
              trailSlug,
            );
          }

          renderProgress();
        });
      });

      resetButton?.addEventListener("click", () => {
        completed = new Set();
        try { localStorage.removeItem(storageKey); } catch { /* Storage unavailable. */ }
        renderProgress();
      });

      root.querySelector("[data-trail-start]")?.addEventListener("click", () => {
        trackTrailStart();
        const next = requiredLessons.find((lesson) => !completed.has(lesson.dataset.lesson ?? ""));
        if (next) sendAnalyticsEvent(apiBase, "trail_lesson_click", `${trailSlug}:${next.dataset.lesson}`);
      });
      root.querySelectorAll<HTMLElement>("[data-lesson-read]").forEach((link) => {
        link.addEventListener("click", () => {
          trackTrailStart();
          sendAnalyticsEvent(apiBase, "trail_lesson_click", `${trailSlug}:${link.dataset.lessonRead}`);
        });
      });
      renderProgress();
    }
  </script>
</BaseLayout>
