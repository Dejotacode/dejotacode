---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryIcon from "../../components/ui/CategoryIcon.astro";
import TrailCard from "../../components/content/TrailCard.astro";
import { trails } from "../../data/trails";
import "../../styles/trails.css";

const canonicalUrl = new URL("/trilhas/", Astro.site ?? Astro.url.origin);
const availableTrails = trails.filter((trail) => trail.available);
const trailsListId = `${canonicalUrl.href}#itemlist`;

const trailsSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonicalUrl.href,
      url: canonicalUrl.href,
      name: "Trilhas de tecnologia para iniciantes | DejotaCode",
      description:
        "Aprenda Linux, programação, inteligência artificial, segurança digital e renda online em trilhas passo a passo para iniciantes.",
      inLanguage: "pt-BR",
      mainEntity: {
        "@id": trailsListId,
      },
      isPartOf: {
        "@id": "https://dejotacode.com.br/#website",
      },
    },
    {
      "@type": "ItemList",
      "@id": trailsListId,
      numberOfItems: availableTrails.length,
      itemListOrder: "https://schema.org/ItemListOrderAscending",
      itemListElement: availableTrails.map((trail, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: trail.title,
        url: new URL(`/trilhas/${trail.slug}/`, canonicalUrl).href,
      })),
    },
  ],
};
---

<BaseLayout
  title="Trilhas de tecnologia para iniciantes | DejotaCode"
  description="Aprenda Linux, programação, inteligência artificial, segurança digital e renda online em trilhas passo a passo para iniciantes."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(trailsSchema)}
  />

  <main id="conteudo" tabindex="-1" class="trails-page">
    <header class="trails-hero container">
      <p class="eyebrow">APRENDA NO SEU RITMO</p>
      <h1>O que você quer aprender?</h1>
      <p>
        Cada trilha transforma um assunto amplo em passos pequenos e ordenados.
        Você sabe por onde começar e qual será o próximo conteúdo.
      </p>
    </header>

    <section class="trail-benefits" aria-label="Como funcionam as trilhas">
      <div class="container">
        <article><CategoryIcon icon="grid" /><span>Escolha seu objetivo</span></article>
        <article><CategoryIcon icon="workflow" /><span>Siga as etapas</span></article>
        <article><CategoryIcon icon="checklist" /><span>Acompanhe seu progresso</span></article>
      </div>
    </section>

    <section class="trails-list container" aria-labelledby="trails-title">
      <div class="trails-heading">
        <div>
          <p class="eyebrow">ESCOLHA UMA TRILHA</p>
          <h2 id="trails-title">Escolha sua trilha</h2>
        </div>
        <p>{availableTrails.length} caminhos para começar.</p>
      </div>

      <div class="trails-grid">
        {trails.map((trail) => <TrailCard trail={trail} editorial />)}
      </div>
    </section>
    <aside class="trails-note container">
      <CategoryIcon icon="workflow" size={28} />
      <div><h2>Um passo de cada vez</h2><p>Seu progresso fica salvo neste navegador. Prefere explorar um assunto? <a href="/blog/">Veja os conteúdos do Blog →</a></p></div>
    </aside>
  </main>
</BaseLayout>
