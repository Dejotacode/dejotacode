---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoreCard from "../../components/store/StoreCard.astro";
import StoreCategoryNav from "../../components/store/StoreCategoryNav.astro";

const allProducts = (await getCollection("storeProducts", ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const products = allProducts
  .filter((product) => product.data.catalogStage === "catalogo-v1")
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "pt-BR"));


---

<BaseLayout
  title="DejotaStore"
  description="Curadoria editorial do DejotaCode para produtos, ferramentas e serviços ligados a tecnologia, Linux, programação e criação de conteúdo."
>
  <main id="conteudo" class="store-page">
    <section class="store-hero">
      <div class="store-container store-hero__grid">
        <div class="store-hero__copy">
          <p class="store-eyebrow">DejotaStore</p>
          <h1>Escolha melhor antes de comprar.</h1>
          <p class="store-lead">
            Curadoria editorial do DejotaCode para produtos, ferramentas e serviços que realmente fazem sentido para quem aprende, trabalha e constrói com tecnologia.
          </p>
          <div class="store-actions">
            <a class="store-button store-button--primary" href="#recomendacoes">Explorar recomendações</a>
            <a class="store-button" href="/store/setup-do-dejota/" data-store-setup="home-hero">Setup do Dejota</a>
          </div>
          <aside class="store-principle">
            <strong>Ensinar primeiro, recomendar depois.</strong>
            A Store organiza soluções que complementam o conteúdo do DejotaCode. Ela não substitui os tutoriais.
          </aside>
        </div>
        <div class="store-hero__visual" aria-label="Seleção visual de produtos da DejotaStore">
          <div class="store-hero__collage">
            <img src="/assets/store/fifine-am8-usb-xlr.webp" alt="Microfone Fifine AM8 em ambiente de criação" width="720" height="405" loading="eager" decoding="async" />
            <img src="/assets/store/sandisk-portable-ssd-1tb.webp" alt="SSD portátil SanDisk em mesa de trabalho" width="720" height="405" loading="eager" decoding="async" />
            <img src="/assets/store/ugreen-hub-usb-c-6-em-1.webp" alt="Hub USB-C UGREEN em setup de tecnologia" width="720" height="405" loading="eager" decoding="async" />
          </div>
          <div class="store-hero__trust">
            <span>Curadoria editorial</span><span>Links verificados</span><span>Compra no parceiro</span>
          </div>
        </div>
      </div>
    </section>

    <section class="store-section store-section--compact">
      <div class="store-container">
        <div class="store-heading store-heading--inline">
          <div>
            <p class="store-eyebrow">Navegue por contexto</p>
            <h2>Encontre o que você precisa</h2>
          </div>
          <span class="store-heading__count">{allProducts.length} itens editoriais</span>
        </div>
        <StoreCategoryNav />
      </div>
    </section>

    <section class="store-section store-section--soft">
      <div class="store-container store-principles">
        <article><span>CURADORIA</span><strong>Contexto antes do clique</strong><p>Explicamos quando e por que uma recomendação faz sentido.</p></article>
        <article><span>STATUS</span><strong>Critério editorial claro</strong><p>Uso real, teste prático e pesquisa editorial ficam separados.</p></article>
        <article><span>CHECKOUT</span><strong>Compra fora da DejotaStore</strong><p>Você escolhe a plataforma parceira. Não existe checkout interno.</p></article>
      </div>
    </section>

    <section id="recomendacoes" class="store-section">
      <div class="store-container">
        <div class="store-heading store-heading--inline">
          <div>
            <p class="store-eyebrow">Catálogo inicial</p>
            <h2>Recomendações em destaque</h2>
            <p>{products.length} produtos formam o catálogo inicial. Todos têm oferta afiliada registrada e ficha editorial própria; preço e disponibilidade são conferidos no parceiro.</p>
          </div>
          <a class="store-heading__link" href="/store/setup-do-dejota/">Ver setup do Dejota →</a>
        </div>
        <div class="store-products">
          {products.map((product, productIndex) => (
            <StoreCard
              id={product.id}
              title={product.data.title}
              description={product.data.description}
              status={product.data.editorialStatus}
              category={product.data.category}
              brand={product.data.brand}
              offerCount={product.data.offers.filter((offer) => offer.active).length}
              relatedPost={product.data.relatedPosts?.[0]}
              loading={productIndex < 3 ? "eager" : "lazy"}
            />
          ))}
        </div>
      </div>
    </section>


    <section class="store-section store-section--trust-strip">
      <div class="store-container store-trust-strip" aria-label="Princípios de confiança da DejotaStore">
        <article><span>PARCEIROS</span><div><strong>Links verificados</strong><p>Shopee, Mercado Livre e outros parceiros identificados.</p></div></article>
        <article><span>COMPRA</span><div><strong>Fora da DejotaStore</strong><p>Pagamento, entrega e garantia ficam com a loja parceira.</p></div></article>
        <article><span>PREÇO</span><div><strong>Valor atualizado no parceiro</strong><p>Preço e disponibilidade são conferidos antes da compra.</p></div></article>
        <article><span>CRITÉRIO</span><div><strong>Curadoria editorial</strong><p>A recomendação precisa ter contexto, não apenas comissão.</p></div></article>
      </div>
    </section>

    <section class="store-section">
      <div class="store-container store-two-column">
        <article class="store-panel">
          <p class="store-eyebrow">Blog + Store</p>
          <h2>Aprenda antes de comprar</h2>
          <p>As recomendações surgem quando um tutorial cria uma necessidade real, como preparar um pendrive ou fazer backup antes de instalar Linux.</p>
          <a href="/blog/">Explorar conteúdos →</a>
        </article>
        <article class="store-panel">
          <p class="store-eyebrow">Transparência</p>
          <h2>Como avaliamos</h2>
          <p>Deixamos claro quando um item foi usado no DejotaCode, testado diretamente ou apenas pesquisado editorialmente.</p>
          <a href="/store/como-avaliamos/">Conhecer a metodologia →</a>
        </article>
      </div>
    </section>

    <section class="store-section">
      <div class="store-container store-disclosure">
        <strong>Transparência sobre afiliados</strong>
        <p>Alguns links poderão gerar comissão para o DejotaCode sem custo adicional para você. Uma comissão nunca deve ser o motivo principal de uma recomendação.</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .store-page { overflow: hidden; }
  .store-container { width: min(calc(100% - (2 * var(--space-page))), var(--container)); margin-inline: auto; }
  .store-hero { padding: clamp(2rem, 6vw, 5rem) 0 2rem; }
  .store-hero__grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 1rem; }
  .store-hero__copy, .store-hero__visual, .store-panel, .store-disclosure {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .store-hero__copy { padding: clamp(1.5rem, 4vw, 3rem); }
  .store-eyebrow { margin: 0; color: var(--color-accent-strong); font-size: .76rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .store-hero h1 { max-width: 10ch; margin: .8rem 0 1rem; font-size: clamp(2.65rem, 7vw, 5.4rem); line-height: .94; letter-spacing: -.055em; }
  .store-lead { max-width: 62ch; margin: 0; color: var(--color-text-muted); font-size: 1.04rem; }
  .store-actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.4rem; }
  .store-button { min-height: 2.8rem; display: inline-flex; align-items: center; justify-content: center; padding: 0 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); font-weight: 800; text-decoration: none; }
  .store-button:hover { border-color: var(--color-accent-strong); }
  .store-button--primary { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-accent-contrast); }
  .store-principle { margin-top: 1.3rem; padding: .9rem 1rem; border-left: 2px solid var(--color-accent); border-radius: 0 var(--radius-md) var(--radius-md) 0; background: linear-gradient(90deg, var(--color-glow), transparent); color: var(--color-text-muted); font-size: .9rem; }
  .store-principle strong { color: var(--color-text); }
  .store-hero__visual { position:relative;min-height:0;display:flex;align-self:stretch;overflow:hidden;padding:0;background:var(--color-surface-soft); }
  .store-hero__collage { flex:1;width:100%;min-height:100%;display:grid;grid-template-columns:1.25fr .75fr;grid-template-rows:1fr 1fr;gap:.35rem;padding:.35rem; }
  .store-hero__collage img { width: 100%; height: 100%; min-height: 0; object-fit: cover; border-radius: calc(var(--radius-lg) - .35rem); border: 0; }
  .store-hero__collage img:first-child { grid-row: 1 / 3; }
  .store-hero__trust { position:absolute;left:.8rem;right:.8rem;bottom:.8rem;display:flex;flex-wrap:wrap;gap:.45rem;padding:0;background:transparent; }
  .store-hero__trust span { padding:.4rem .6rem;border:1px solid color-mix(in srgb,var(--color-border) 85%,transparent);border-radius:999px;background:color-mix(in srgb,var(--color-surface) 92%,transparent);backdrop-filter:blur(10px);color:var(--color-text-muted);font-size:.7rem;font-weight:800;box-shadow:0 .25rem .7rem rgb(0 0 0 / .08); }
  .store-section { padding: 2rem 0; }
  .store-section--compact { padding-top: .75rem; }
  .store-heading--inline { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .store-heading__count { flex: none; color: var(--color-text-subtle); font: 700 .75rem/1.2 var(--font-code); }
  .store-heading__link { flex: none; color: var(--color-accent-strong); font-size: .85rem; font-weight: 850; text-decoration: none; }
  .store-section--soft { border-block: 1px solid var(--color-border); background: var(--color-surface-soft); }
  .store-heading { margin-bottom: 1rem; }
  .store-heading h2, .store-panel h2 { margin: .35rem 0; font-size: clamp(1.5rem, 3vw, 2rem); }
  .store-heading p:not(.store-eyebrow), .store-panel p { max-width: 60ch; margin: .35rem 0 0; color: var(--color-text-muted); }
  .store-principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  .store-principles article { padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .store-principles span { color:var(--color-accent-strong);font-size:.68rem;font-weight:850;letter-spacing:.06em; }
  .store-principles strong { display: block; margin: .35rem 0; }
  .store-principles p { margin: 0; color: var(--color-text-muted); font-size: .88rem; }
  .store-products { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
  .store-trust-strip { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .6rem; }
  .store-trust-strip article { display:grid;gap:.25rem;padding:.95rem;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface); }
  .store-trust-strip article>span { color:var(--color-accent-strong);font-size:.64rem;font-weight:850;letter-spacing:.06em; }
  .store-trust-strip strong { font-size: .86rem; }
  .store-trust-strip p { margin: .2rem 0 0; color: var(--color-text-muted); font-size: .76rem; }
  .store-two-column { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  .store-panel { padding: 1.2rem; }
  .store-panel a { display: inline-block; margin-top: 1rem; color: var(--color-accent-strong); font-weight: 800; text-decoration: none; }
  .store-disclosure { padding: 1rem 1.2rem; }
  .store-disclosure p { margin: .25rem 0 0; color: var(--color-text-muted); }
  @media (max-width: 60rem) {
    .store-hero__grid { grid-template-columns: 1fr; }
    .store-hero__visual { min-height: 14rem; }
    .store-products { grid-template-columns: repeat(2, 1fr); }
    .store-trust-strip { grid-template-columns: repeat(2,minmax(0,1fr)); }
  }
  @media (max-width: 42rem) {
    .store-heading--inline { align-items: start; flex-direction: column; }
    .store-principles, .store-products, .store-two-column, .store-trust-strip { grid-template-columns: 1fr; }
    .store-hero { padding-top:1.25rem; }
    .store-hero__copy { padding:1.2rem; }
    .store-hero__collage { min-height: 19rem; grid-template-columns: 1fr 1fr; grid-template-rows: 1.2fr .8fr; }
    .store-hero__collage img:first-child { grid-column: 1 / 3; grid-row: auto; }
  }
</style>
