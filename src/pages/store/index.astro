---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getStoreMerchants } from "../../lib/storeOffers";
import StoreCard from "../../components/store/StoreCard.astro";
import StoreCategoryNav from "../../components/store/StoreCategoryNav.astro";
import CategoryIcon from "../../components/ui/CategoryIcon.astro";
import Pagination from "../../components/ui/Pagination.astro";
import "../../styles/store-catalog.css";
const PAGE_SIZE = 12;
const products = (await getCollection("storeProducts", ({ data }) => !data.draft && data.catalogStage !== "avaliacao"))
  .sort((a,b) => a.data.title.localeCompare(b.data.title,"pt-BR"));
const totalPages = Math.max(1,Math.ceil(products.length/PAGE_SIZE));
const visibleProducts = products.slice(0,PAGE_SIZE);
---
<BaseLayout title="DejotaStore" description="Curadoria editorial do DejotaCode para produtos, ferramentas e serviços ligados a tecnologia, Linux, programação e criação de conteúdo.">
<main id="conteudo" tabindex="-1" class="store-catalog-page">
  <header class="catalog-hero container"><div><p class="eyebrow">DEJOTASTORE</p><h1>Escolha melhor antes de comprar.</h1><p class="catalog-lead">Produtos e ferramentas com contexto para quem aprende, trabalha e constrói com tecnologia.</p><div class="catalog-actions"><a class="button button-primary" href="#recomendacoes">Explorar recomendações <span aria-hidden="true">↓</span></a><a class="button button-secondary" href="/store/setup-do-dejota/" data-store-setup="home-hero">Setup do Dejota <span aria-hidden="true">→</span></a></div><p class="catalog-motto">Ensinar primeiro, recomendar depois.</p></div><figure><img src="/assets/store/logitech-mx-anywhere-3s.webp" alt="Imagem editorial de um mouse Logitech em um ambiente de trabalho tecnológico" width="1440" height="810" loading="eager" decoding="async" /></figure></header>
  <div class="container"><StoreCategoryNav compact />
  <section class="catalog-trust" aria-label="Como funciona a DejotaStore"><div><CategoryIcon icon="news" size={28}/><div><h2>Curadoria com contexto</h2><p>Recomendações ligadas ao conteúdo.</p></div></div><div><CategoryIcon icon="checklist" size={28}/><div><h2>Uso, teste e pesquisa separados</h2><p>Cada selo indica o nível de evidência.</p></div></div><div><CategoryIcon icon="browser" size={28}/><div><h2>Compra no parceiro</h2><p>Ofertas ativas levam à plataforma parceira.</p></div></div></section>
  <section id="recomendacoes" class="catalog-section" aria-labelledby="catalog-title"><div class="catalog-heading"><div><h2 id="catalog-title">Recomendações para o seu contexto</h2><p>Explore o catálogo. Preço e disponibilidade são consultados na plataforma parceira.</p></div><span>{products.length} itens no catálogo</span></div><div class="catalog-products">{visibleProducts.map((product,index)=><StoreCard editorial id={product.id} title={product.data.title} description={product.data.description} status={product.data.editorialStatus} category={product.data.category} brand={product.data.brand} offerCount={getStoreMerchants(product.data).length} relatedPost={product.data.relatedPosts?.[0]} loading={index<3 ? "eager" : "lazy"}/>)}</div><Pagination currentPage={1} totalPages={totalPages} basePath="/store/pagina/" firstPagePath="/store/" /></section>
  <section class="catalog-context" aria-label="Conteúdo e critérios editoriais"><a href="/blog/"><CategoryIcon icon="news" size={32}/><div><h2>Aprenda antes de comprar</h2><p>Veja os conteúdos que dão contexto às recomendações.</p><span>Explorar o Blog →</span></div></a><a href="/store/como-avaliamos/"><CategoryIcon icon="shield-check" size={32}/><div><h2>Como avaliamos</h2><p>Entenda os selos de uso, teste e pesquisa.</p><span>Conhecer os critérios →</span></div></a></section>
  <aside class="catalog-disclosure"><CategoryIcon icon="privacy" size={26}/><div><h2>Transparência sobre afiliados</h2><p>Alguns links podem gerar comissão para o DejotaCode, sem custo adicional para você. A compra, entrega e garantia ficam com o parceiro. Uma comissão nunca deve ser o motivo principal de uma recomendação.</p></div></aside>
  </div>
</main></BaseLayout>
