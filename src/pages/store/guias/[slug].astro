---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StoreBadge from "../../../components/store/StoreBadge.astro";
import VisualMedia from "../../../components/visual/VisualMedia.astro";
import CategoryIcon from "../../../components/CategoryIcon.astro";
import { resolveStoreVisual } from "../../../data/storeVisuals";
import "../../../styles/store-guide.css";

export async function getStaticPaths() {
  const guides = await getCollection("storeGuides", ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

interface Props { guide: CollectionEntry<"storeGuides">; }
const { guide } = Astro.props;
const { Content } = await render(guide);
const allProducts = await getCollection("storeProducts", ({ data }) => !data.draft);
const products = allProducts.filter((product) => guide.data.productIds.includes(product.id));
---

<BaseLayout title={guide.data.title} description={guide.data.description}>
  <main id="conteudo" tabindex="-1" class="store-guide-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Navegação estrutural"><a href="/">Início</a><span>›</span><a href="/store/">Store</a><span>›</span><span>Guias</span><span>›</span><span aria-current="page">{guide.data.title}</span></nav>
      <header class="guide-hero">
        <p class="eyebrow">Guia de compra</p>
        <h1>{guide.data.title}</h1>
        <p>{guide.data.description}</p>
      </header>
      <div class="guide-layout">
        <article class="guide-copy" aria-label="Conteúdo do guia"><Content /></article>
        <aside class="guide-principle" aria-labelledby="guide-principle-title">
          <CategoryIcon icon="shield-check" size={28} />
          <p class="eyebrow">Princípio</p>
          <h2 id="guide-principle-title">Escolha pelo seu uso</h2>
          <p>Não buscamos um “vencedor universal”. O guia explica critérios e mostra quais perfis combinam melhor com cada opção.</p>
        </aside>
      </div>
      {products.length > 0 && (
        <section class="guide-recommendations" aria-labelledby="guide-recommendations-title">
          <p class="eyebrow">Relacionados</p>
          <h2 id="guide-recommendations-title">Recomendações citadas</h2>
          <div class="guide-products">{products.map((product) => {
            const visual = resolveStoreVisual(product.id, product.data.category);
            return (
              <article class="guide-product">
                <VisualMedia src={visual.src} fallbackSrc={visual.fallbackSrc} alt={`Imagem editorial de ${product.data.title}`} label={product.data.title} loading="lazy" aspect="card" />
                <div class="guide-product__body">
                  <StoreBadge status={product.data.editorialStatus} />
                  <h3>{product.data.title}</h3>
                  <a href={`/store/${product.id}/`} data-store-origin={`internal:${Astro.url.pathname}`} data-analytics-cta={`store-card:${product.id}`}>Ver análise <span aria-hidden="true">→</span></a>
                  {product.data.relatedPosts?.[0] && <a class="guide-product__article" href={`/blog/${product.data.relatedPosts[0]}/`} data-analytics-cta={`store-card:${product.id}:article`}>Ver artigo <span aria-hidden="true">→</span></a>}
                </div>
              </article>
            );
          })}</div>
        </section>
      )}
      <nav class="guide-endlinks" aria-label="Continue na DejotaStore">
        <a href="/store/como-avaliamos/">Como avaliamos</a>
        <a href="/store/">Voltar à DejotaStore <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </main>
</BaseLayout>
