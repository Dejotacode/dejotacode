---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StoreCard from "../../../components/store/StoreCard.astro";

export async function getStaticPaths() {
  const guides = await getCollection("storeGuides", ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

interface Props { guide: CollectionEntry<"storeGuides">; }
const { guide } = Astro.props;
const { Content } = await render(guide);
const allProducts = await getCollection("storeProducts", ({ data }) => !data.draft);
const products = allProducts.filter((product) => guide.data.productIds.includes(product.id));
---

<BaseLayout title={guide.data.title} description={guide.data.description}>
  <main id="conteudo">
    <div class="container">
      <nav class="breadcrumbs"><a href="/">Início</a><span>›</span><a href="/store/">Store</a><span>›</span><span>Guias</span><span>›</span><span>{guide.data.title}</span></nav>
      <section class="guide-hero">
        <p class="eyebrow">Guia de compra</p>
        <h1>{guide.data.title}</h1>
        <p>{guide.data.description}</p>
      </section>
      <section class="guide-layout">
        <article class="panel copy"><Content /></article>
        <aside class="panel">
          <p class="eyebrow">Princípio</p>
          <h2>Escolha pelo seu uso</h2>
          <p>Não buscamos um “vencedor universal”. O guia explica critérios e mostra quais perfis combinam melhor com cada opção.</p>
        </aside>
      </section>
      {products.length > 0 && (
        <section class="section">
          <p class="eyebrow">Relacionados</p>
          <h2>Recomendações citadas</h2>
          <div class="products">{products.map((product) => (
            <StoreCard id={product.id} title={product.data.title} description={product.data.description} status={product.data.editorialStatus} category={product.data.category} />
          ))}</div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .container{width:min(calc(100% - (2 * var(--space-page))),var(--container));margin-inline:auto}.breadcrumbs{display:flex;flex-wrap:wrap;gap:.45rem;padding-top:1.5rem;color:var(--color-text-subtle);font-size:.82rem}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{color:var(--color-accent-strong)}
  .guide-hero{padding:2.7rem 0 2rem;border-bottom:1px solid var(--color-border)}.guide-hero h1{max-width:14ch;margin:.4rem 0;font-size:clamp(2.5rem,7vw,4.6rem);line-height:1;letter-spacing:-.05em}.guide-hero>p:last-child{max-width:60ch;color:var(--color-text-muted)}
  .eyebrow{margin:0;color:var(--color-accent-strong);font-size:.76rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.guide-layout{display:grid;grid-template-columns:1.25fr .75fr;gap:1rem;padding:2rem 0}.panel{padding:1.2rem;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface)}.panel p{color:var(--color-text-muted)}.copy :global(p),.copy :global(li){color:var(--color-text-muted)}.section{padding:0 0 2rem}.products{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}
  @media(max-width:50rem){.guide-layout,.products{grid-template-columns:1fr}}
</style>
