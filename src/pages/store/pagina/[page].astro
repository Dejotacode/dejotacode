---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getStoreMerchants } from "../../../lib/storeOffers";
import StoreCard from "../../../components/store/StoreCard.astro";
import StoreCategoryNav from "../../../components/store/StoreCategoryNav.astro";
import Pagination from "../../../components/Pagination.astro";
import "../../../styles/store-catalog.css";

const PAGE_SIZE = 12;

export async function getStaticPaths() {
  const PAGE_SIZE = 12;
  const products = (await getCollection("storeProducts", ({ data }) => !data.draft && data.catalogStage !== "avaliacao"))
    .sort((a, b) => a.data.title.localeCompare(b.data.title, "pt-BR"));
  const totalPages = Math.max(1, Math.ceil(products.length / PAGE_SIZE));
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page, totalPages } };
  });
}

interface Props { page: number; totalPages: number; }
const { page, totalPages } = Astro.props;
const products = (await getCollection("storeProducts", ({ data }) => !data.draft && data.catalogStage !== "avaliacao"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "pt-BR"));
const start = (page - 1) * PAGE_SIZE;
const visibleProducts = products.slice(start, start + PAGE_SIZE);
---

<BaseLayout
  title={`DejotaStore — Página ${page} | DejotaCode`}
  description={`Página ${page} do catálogo editorial da DejotaStore com produtos, ferramentas e serviços selecionados pelo DejotaCode.`}
>
  <main id="conteudo" tabindex="-1" class="store-archive-page store-catalog-page">
    <header class="store-archive-hero container">
      <p class="eyebrow">DEJOTASTORE</p>
      <h1>Escolha melhor antes de comprar.</h1>
      <p>Página {page} de {totalPages} da curadoria editorial de produtos, ferramentas e serviços do DejotaCode.</p>
      <StoreCategoryNav compact />
    </header>

    <section class="store-archive-section container" aria-labelledby="catalogo-title">
      <div class="store-archive-heading">
        <div><p class="eyebrow">CATÁLOGO</p><h2 id="catalogo-title">Mais recomendações</h2></div>
        <p>Página {page} de {totalPages}</p>
      </div>
      <div class="store-archive-products">
        {visibleProducts.map((product, productIndex) => (
          <StoreCard
            editorial
            id={product.id}
            title={product.data.title}
            description={product.data.description}
            status={product.data.editorialStatus}
            category={product.data.category}
            brand={product.data.brand}
            offerCount={getStoreMerchants(product.data).length}
            relatedPost={product.data.relatedPosts?.[0]}
            loading={productIndex < 3 ? "eager" : "lazy"}
          />
        ))}
      </div>
      <Pagination currentPage={page} totalPages={totalPages} basePath="/store/pagina/" firstPagePath="/store/" />
    </section>
  </main>
</BaseLayout>

<style>
.store-archive-hero{padding-block:2rem;text-align:left}.store-archive-hero h1{font-size:clamp(2rem,3.5vw,3rem);max-width:22ch;margin:.6rem 0 .8rem;line-height:1.12;letter-spacing:-.035em}.store-archive-hero>p:not(.eyebrow){color:var(--color-text-muted);margin:0 0 1.5rem}.store-archive-section{padding-top:1rem}.store-archive-heading{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1.2rem}.store-archive-heading h2{font-size:clamp(1.5rem,2.3vw,2rem);margin:.5rem 0 0}.store-archive-heading>p{color:var(--color-text-muted);font-size:.85rem}.store-archive-products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}@media(max-width:960px){.store-archive-products{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.store-archive-products{grid-template-columns:1fr}.store-archive-heading{align-items:start;flex-direction:column}}
</style>
