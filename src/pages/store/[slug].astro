---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoreBadge from "../../components/store/StoreBadge.astro";
import StoreCategoryNav from "../../components/store/StoreCategoryNav.astro";
import VisualMedia from "../../components/visual/VisualMedia.astro";
import { resolveStoreVisual } from "../../data/storeVisuals";

export async function getStaticPaths() {
  const products = await getCollection("storeProducts", ({ data }) => !data.draft);
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<"storeProducts">;
}

const { product } = Astro.props;
const { Content } = await render(product);
const links = product.data.affiliateLinks ?? {};
const providerLabels: Record<string, string> = {
  amazon: "Amazon",
  mercadolivre: "Mercado Livre",
  shopee: "Shopee",
  hotmart: "Hotmart",
  other: "Parceiro",
};
const structuredOffers = product.data.offers
  .filter((offer) => offer.active)
  .map((offer) => ({
    name: providerLabels[offer.provider] ?? "Parceiro",
    provider: offer.provider,
    href: offer.href,
    label: offer.label,
    lastChecked: offer.lastChecked,
  }));
const legacyMerchants = [
  { name: "Amazon", provider: "amazon", href: links.amazon, label: undefined, lastChecked: undefined },
  { name: "Mercado Livre", provider: "mercadolivre", href: links.mercadolivre, label: undefined, lastChecked: undefined },
  { name: "Shopee", provider: "shopee", href: links.shopee, label: undefined, lastChecked: undefined },
  { name: "Hotmart", provider: "hotmart", href: links.hotmart, label: undefined, lastChecked: undefined },
  { name: "Parceiro", provider: "other", href: links.other, label: undefined, lastChecked: undefined },
].filter((entry) => Boolean(entry.href));
const merchants = structuredOffers.length > 0 ? structuredOffers : legacyMerchants;
const { src: productVisual, fallbackSrc: productFallback, categoryLabel } = resolveStoreVisual(product.id, product.data.category);
const compatibilityLabels: Record<string, string> = {
  linux: "Linux",
  windows: "Windows",
  macos: "macOS",
  android: "Android",
  ios: "iOS",
};
const compatibilityItems = Object.entries(product.data.compatibility ?? {})
  .filter((entry): entry is [string, string] => Boolean(entry[1]?.trim()))
  .map(([platform, details]) => ({ label: compatibilityLabels[platform] ?? platform, details }));

---

<BaseLayout title={product.data.title} description={product.data.description}>
  <main id="conteudo" class="store-product-page">
    <div class="store-container">
      <nav class="breadcrumbs" aria-label="Navegação estrutural">
        <a href="/">Início</a><span>›</span><a href="/store/">Store</a><span>›</span><span aria-current="page">{product.data.title}</span>
      </nav>

      <section class="product-hero">
        <div class="product-visual">
          <VisualMedia
            src={productVisual}
            fallbackSrc={productFallback}
            alt={`Imagem editorial de ${product.data.title}`}
            label={product.data.title}
            loading="eager"
          />
          <div class="product-visual__overlay">
            <span>{categoryLabel}</span>
            <strong>{product.data.brand ?? "DejotaStore"}</strong>
          </div>
        </div>
        <div class="product-summary">
          <StoreBadge status={product.data.editorialStatus} />
          <h1>{product.data.title}</h1>
          <p class="lead">{product.data.description}</p>
          <div class="product-commercial-summary">
            <div><span>Preço</span><strong>Consultar no parceiro</strong></div>
            <div><span>Ofertas ativas</span><strong>{merchants.length}</strong></div>
            <div><span>Categoria</span><strong>{categoryLabel}</strong></div>
          </div>

          {product.data.recommendedFor.length > 0 && (
            <div class="recommended">
              <strong>Recomendado para</strong>
              <ul>{product.data.recommendedFor.map((item) => <li>{item}</li>)}</ul>
            </div>
          )}
          {compatibilityItems.length > 0 && (
            <div class="product-compatibility">
              <strong>Compatibilidade</strong>
              <dl class="product-compatibility__list">
                {compatibilityItems.map((item) => (
                  <div>
                    <dt>{item.label}</dt>
                    <dd>{item.details}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </div>
      </section>

      <section class="product-category-nav">
        <div class="product-category-nav__heading"><p class="eyebrow">Continue explorando</p><strong>Outras categorias da DejotaStore</strong></div>
        <StoreCategoryNav activeSlug={product.data.category} compact />
      </section>

      <section class="product-grid">
        <article class="product-panel product-copy">
          <p class="eyebrow">Análise editorial</p>
          <Content />
        </article>

        <aside class="product-panel">
          <p class="eyebrow">Resumo</p>
          <div class="pros-cons">
            <div><strong>Pontos positivos</strong><ul>{product.data.pros.map((item) => <li>{item}</li>)}</ul></div>
            <div><strong>Pontos de atenção</strong><ul>{product.data.cons.map((item) => <li>{item}</li>)}</ul></div>
          </div>
        </aside>
      </section>

      <section class="product-panel offers">
        <p class="eyebrow">Onde encontrar</p>
        <h2>Confira diretamente na plataforma parceira</h2>
        {merchants.length > 0 ? (
          <div class="offer-grid">
            {merchants.map((merchant) => (
              <a
                href={merchant.href}
                target="_blank"
                rel="nofollow sponsored noopener"
                data-analytics-cta={`store-offer:${product.id}:${merchant.provider}`}
                data-analytics-affiliate-provider={merchant.provider}
                data-analytics-affiliate-id={product.id}
              >
                <div><small>Parceiro</small><strong>{merchant.name}</strong></div><span>{merchant.label ?? "Ver oferta →"}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-offers">Ainda estamos validando os parceiros e links desta recomendação. Nenhum link comercial foi publicado nesta versão.</p>
        )}
        {product.data.verification && (
          <p class="verification-note">
            Última verificação editorial: <strong>{product.data.verification.lastChecked?.toLocaleDateString("pt-BR") ?? "não informada"}</strong>.
            {product.data.verification.notes && <> {product.data.verification.notes}</>}
          </p>
        )}
        <p class="affiliate-note">Alguns links podem gerar comissão para o DejotaCode sem custo adicional para você.</p>
      </section>

      {product.data.relatedPosts.length > 0 && (
        <section class="product-panel">
          <p class="eyebrow">Aprenda antes de comprar</p>
          <h2>Conteúdos relacionados</h2>
          <div class="related-list">
            {product.data.relatedPosts.map((slug) => (
              <a
                href={`/blog/${slug}/`}
                data-store-related-article={`product:${product.id}:${slug}`}
              >
                {slug.replaceAll("-", " ")} <span>→</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="product-panel methodology">
        <p class="eyebrow">Transparência</p>
        <h2>Por que esta recomendação existe?</h2>
        <p>Um produto só entra na DejotaStore quando ajuda a resolver uma necessidade real do conteúdo. Comissão de afiliado não deve ser o motivo principal da recomendação.</p>
        <a href="/store/como-avaliamos/">Conhecer a metodologia →</a>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .store-product-page { padding-bottom: 3rem; }
  .store-container { width: min(calc(100% - (2 * var(--space-page))), var(--container)); margin-inline: auto; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: .45rem; padding-top: 1.5rem; color: var(--color-text-subtle); font-size: .82rem; }
  .breadcrumbs a { color: inherit; text-decoration: none; }
  .breadcrumbs a:hover { color: var(--color-accent-strong); }
  .product-hero { display: grid; grid-template-columns: .9fr 1.1fr; gap: 1rem; padding: 1.5rem 0; }
  .product-visual, .product-summary, .product-panel { border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .product-visual { position:relative;min-height:24rem;overflow:hidden;padding:0;background:var(--color-surface-soft); }
  .product-visual > :global(.visual-media) { height:100%;min-height:24rem;border:0;border-radius:0; }
  .product-visual__overlay { position:absolute;left:1rem;right:1rem;bottom:1rem;display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.65rem .75rem;border:1px solid color-mix(in srgb,var(--color-border) 75%,transparent);border-radius:999px;background:color-mix(in srgb,var(--color-surface) 90%,transparent);backdrop-filter:blur(10px); }
  .product-visual__overlay span { color:var(--color-accent-strong);font-size:.72rem;font-weight:850; }
  .product-visual__overlay strong { font-size:.8rem; }
  .product-summary { display: flex; flex-direction: column; justify-content: center; padding: clamp(1.2rem, 4vw, 2rem); }
  .product-summary h1 { margin: .8rem 0; font-size: clamp(2rem, 5vw, 3.7rem); line-height: 1; letter-spacing: -.045em; }
  .lead { margin:0;color:var(--color-text-muted);font-size:1.02rem; }
  .product-commercial-summary { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin-top:1.2rem;padding-block:.75rem;border-block:1px solid var(--color-border); }
  .product-commercial-summary>div { display:grid;gap:.2rem; }
  .product-commercial-summary span { color:var(--color-text-subtle);font-size:.68rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase; }
  .product-commercial-summary strong { font-size:.82rem; }
  .recommended { margin-top: 1.2rem; }
  .recommended ul { margin-bottom: 0; color: var(--color-text-muted); }
  .product-compatibility { margin-top:1rem;padding-top:1rem;border-top:1px solid var(--color-border); }
  .product-compatibility__list { display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,9rem),1fr));gap:.65rem 1rem;margin:.65rem 0 0; }
  .product-compatibility__list div { display:grid;gap:.15rem; }
  .product-compatibility__list dt { color:var(--color-text-subtle);font-size:.72rem;font-weight:800; }
  .product-compatibility__list dd { margin:0;color:var(--color-text-muted);font-size:.9rem; }
  .product-category-nav { margin-bottom:1rem;padding:1rem 0;border-bottom:1px solid var(--color-border); }
  .product-category-nav__heading { display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:.75rem; }
  .product-category-nav__heading .eyebrow { margin:0; }
  .product-category-nav__heading strong { font-size:.95rem; }
  .product-grid { display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:1rem;margin-bottom:1rem; }
  .product-grid > .product-panel { min-width:0; }
  .product-panel { padding: 1.2rem; margin-bottom: 1rem; }
  .product-grid .product-panel { margin-bottom: 0; }
  .eyebrow { margin: 0 0 .5rem; color: var(--color-accent-strong); font-size: .76rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .product-copy :global(p), .product-panel > p:not(.eyebrow) { color: var(--color-text-muted); }
  .product-copy :global(a) { overflow-wrap:anywhere; }
  .pros-cons { display: grid; gap: .8rem; }
  .pros-cons > div { padding: .8rem 0; border-top: 1px solid var(--color-border); }
  .pros-cons ul { margin-bottom: 0; padding-left: 1.2rem; color: var(--color-text-muted); font-size: .9rem; }
  .offers h2, .methodology h2, .product-panel h2 { margin: .35rem 0 1rem; }
  .offer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
  .offer-grid a { display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface-soft);text-decoration:none; }
  .offer-grid a>div { display:grid;gap:.12rem; }
  .offer-grid small { color:var(--color-text-subtle);font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em; }
  .offer-grid a:hover { border-color: var(--color-accent-strong); }
  .offer-grid span { color: var(--color-accent-strong); font-size: .85rem; font-weight: 800; }
  .empty-offers { padding: 1rem; border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); }
  .verification-note { margin: .9rem 0 0; padding: .8rem; border-left: 2px solid var(--color-accent); background: var(--color-surface-soft); font-size: .82rem; }
  .affiliate-note { margin-bottom: 0; font-size: .8rem; }
  .related-list { display: grid; gap: .55rem; }
  .related-list a { display: flex; justify-content: space-between; gap: .75rem; padding: .75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); text-decoration: none; text-transform: capitalize; }
  .related-list a:hover { border-color: var(--color-accent-strong); }
  .related-list span, .methodology a { color: var(--color-accent-strong); font-weight: 800; }
  .methodology a { text-decoration: none; }
  @media (max-width: 50rem) {
    .product-hero { grid-template-columns: minmax(0,1fr); }
    .product-grid { grid-template-columns: minmax(0,1fr); }
    .product-visual,.product-visual > :global(.visual-media) { min-height:15rem; }
    .product-commercial-summary { grid-template-columns:1fr; }
    .product-category-nav__heading { align-items:start;flex-direction:column; }
    .offer-grid { grid-template-columns:1fr; }
  }
</style>
