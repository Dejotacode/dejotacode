---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoreBadge from "../../components/store/StoreBadge.astro";
import StoreCategoryNav from "../../components/store/StoreCategoryNav.astro";
import VisualMedia from "../../components/visual/VisualMedia.astro";
import { resolveStoreVisual } from "../../data/storeVisuals";
import CategoryIcon from "../../components/ui/CategoryIcon.astro";
import { getStoreMerchants } from "../../lib/storeOffers";
import { getPublishedPosts, postSlug } from "../../lib/content";
import "../../styles/store-catalog.css";
import "../../styles/store-product.css";

export async function getStaticPaths() {
  const products = await getCollection("storeProducts", ({ data }) => !data.draft);
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<"storeProducts">;
}

const { product } = Astro.props;
const { Content } = await render(product);
const merchants = getStoreMerchants(product.data);
const posts = await getPublishedPosts();
const relatedPosts = product.data.relatedPosts.flatMap(slug => {
  const post = posts.find(post => postSlug(post) === slug);
  return post ? [{ slug, title: post.data.title, description: post.data.description }] : [];
});
const { src: productVisual, fallbackSrc: productFallback, categoryLabel } = resolveStoreVisual(product.id, product.data.category);
const compatibilityLabels: Record<string, string> = {
  linux: "Linux",
  windows: "Windows",
  macos: "macOS",
  android: "Android",
  ios: "iOS",
};
const compatibilityItems = Object.entries(product.data.compatibility ?? {})
  .filter((entry): entry is [string, string] => Boolean(entry[1]?.trim()))
  .map(([platform, details]) => ({ label: compatibilityLabels[platform] ?? platform, details }));

---

<BaseLayout title={product.data.title} description={product.data.description}>
  <main id="conteudo" tabindex="-1" class="store-product-page store-catalog-page">
    <div class="store-container container">
      <nav class="breadcrumbs" aria-label="Navegação estrutural">
        <a href="/">Início</a><span>›</span><a href="/store/">Store</a><span>›</span><span aria-current="page">{product.data.title}</span>
      </nav>

      <section class="product-hero">
        <div class:list={["product-visual", { "product-visual--editorial-wide": productVisual.endsWith("-diversidade-assinatura-v1.webp") || productVisual === "/assets/resources/items/elevenlabs-assinatura-v2.webp" }]}>
          <VisualMedia
            src={productVisual}
            fallbackSrc={productFallback}
            alt={`Imagem editorial de ${product.data.title}`}
            label={product.data.title}
            loading="eager"
            aspect="card"
          />
        </div>
        <div class="product-summary">
          <StoreBadge status={product.data.editorialStatus} />
          <h1>{product.data.title}</h1>
          <p class="lead">{product.data.description}</p>
          <div class="product-commercial-summary">
            <div><span>Preço</span><strong>Consultar no parceiro</strong></div>
            <div><span>Ofertas ativas</span><strong>{merchants.length}</strong></div>
            <div><span>Categoria</span><strong>{categoryLabel}</strong></div>
          </div>

          <div class="product-actions">{merchants.length > 0 ? <a class="button button-secondary" href="#ofertas">Ver opções no parceiro <span aria-hidden="true"><CategoryIcon icon="arrow-down" size={18} class="action-arrow" /></span></a> : <span class="product-no-offer">Sem oferta ativa nesta recomendação</span>}<a href={`/store/${product.data.category}/`}>Explorar {categoryLabel} <CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></a></div>
        </div>
      </section>

      {(product.data.recommendedFor.length > 0 || compatibilityItems.length > 0) && <section class="product-usage" aria-label="Indicação de uso e compatibilidade">          {product.data.recommendedFor.length > 0 && (
            <div class="recommended">
              <strong>Recomendado para</strong>
              <ul>{product.data.recommendedFor.map((item) => <li>{item}</li>)}</ul>
            </div>
          )}
          {compatibilityItems.length > 0 && (
            <div class="product-compatibility">
              <strong>Compatibilidade</strong>
              <dl class="product-compatibility__list">
                {compatibilityItems.map((item) => (
                  <div>
                    <dt>{item.label}</dt>
                    <dd>{item.details}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
      </section>}
      <section class="product-category-nav">
        <div class="product-category-nav__heading"><p class="eyebrow">Continue explorando</p><strong>Outras categorias da DejotaStore</strong></div>
        <StoreCategoryNav activeSlug={product.data.category} compact />
      </section>

      <section class="product-grid">
        <article class="product-panel product-copy">
          <p class="eyebrow">Análise editorial</p>
          <Content />
        </article>

        <aside class="product-panel">
          <p class="eyebrow">Resumo</p>
          <div class="pros-cons">
            <div><strong>Pontos positivos</strong><ul>{product.data.pros.map((item) => <li>{item}</li>)}</ul></div>
            <div><strong>Pontos de atenção</strong><ul>{product.data.cons.map((item) => <li>{item}</li>)}</ul></div>
          </div>
        </aside>
      </section>

      <section id="ofertas" class="product-panel offers">
        <p class="eyebrow">Onde encontrar</p>
        <h2>Confira diretamente na plataforma parceira</h2>
        {merchants.length > 0 ? (
          <div class="offer-grid">
            {merchants.map((merchant) => (
              <a
                href={merchant.href}
                target="_blank"
                rel="nofollow sponsored noopener"
                data-analytics-cta={`store-offer:${product.id}:${merchant.provider}`}
                data-analytics-affiliate-provider={merchant.provider}
                data-analytics-affiliate-id={product.id}
              >
                <div><small>Parceiro</small><strong>{merchant.name}</strong></div><span>{merchant.label ?? "Ver oferta"}<CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-offers">Ainda estamos validando os parceiros e links desta recomendação. Nenhum link comercial foi publicado nesta versão.</p>
        )}
        {product.data.verification && (
          <p class="verification-note">
            Última verificação editorial: <strong>{product.data.verification.lastChecked?.toLocaleDateString("pt-BR") ?? "não informada"}</strong>.
            {product.data.verification.notes && <> {product.data.verification.notes}</>}
          </p>
        )}
        <p class="affiliate-note">Alguns links podem gerar comissão para o DejotaCode sem custo adicional para você.</p>
      </section>

      {relatedPosts.length > 0 && (
        <section class="product-panel">
          <p class="eyebrow">Aprenda antes de comprar</p>
          <h2>Conteúdos relacionados</h2>
          <div class="related-list">
            {relatedPosts.map(({ slug, title, description }) => (
              <a
                href={`/blog/${slug}/`}
                data-store-related-article={`product:${product.id}:${slug}`}
              >
                <CategoryIcon icon="news" size={26} /><div><strong>{title}</strong><p>{description}</p></div><span aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="product-panel methodology">
        <p class="eyebrow">Transparência</p>
        <h2>Por que esta recomendação existe?</h2>
        <p>Um produto só entra na DejotaStore quando ajuda a resolver uma necessidade real do conteúdo. Comissão de afiliado não deve ser o motivo principal da recomendação.</p>
        <a href="/store/como-avaliamos/">Conhecer a metodologia <CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></a>
      </section>
    </div>
  </main>
</BaseLayout>
