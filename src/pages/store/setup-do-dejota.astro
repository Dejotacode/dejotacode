---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryIcon from "../../components/ui/CategoryIcon.astro";
import "../../styles/setup.css";
import SetupIllustration from "../../components/visual/SetupIllustration.astro";
const specs = [
  { icon: "chip" as const, title: "Intel Core i5-3470", detail: "4 núcleos · 3,20 GHz" },
  { icon: "database" as const, title: "16 GB de RAM", detail: "Memória do sistema" },
  { icon: "grid" as const, title: "Placa-mãe H61", detail: "Versão 1.3" },
  { icon: "terminal" as const, title: "CachyOS", detail: "Sistema em uso" },
];
const peripherals = [
  { icon: "monitor" as const, title: 'TV Samsung 43″', detail: "Usada como monitor", pending: "Modelo UN43T5300AGXZD" },
  { icon: "keyboard" as const, title: "Teclado Logitech K270", detail: "Sem fio", pending: "Modelo informado por Dejota" },
  { icon: "mouse" as const, title: "Mouse Logitech M150", detail: "Sem fio", pending: "Modelo informado por Dejota" },
  { icon: "usb-hub" as const, title: "Hub USB 6 em 1 · KA-6051", detail: "Conexão de periféricos", pending: "Modelo informado por Dejota" },
];
const disks = [
  { purpose: "SISTEMA", title: "SSD Rapidin SATA · 128 GB", detail: "Para o sistema operacional" },
  { purpose: "USO PESSOAL", title: "HD Samsung · 160 GB", detail: "Modelo HM160HI · arquivos pessoais" },
  { purpose: "BACKUP E ARQUIVOS", title: "HD Western Digital · 640 GB", detail: "Modelo WD6400BPVT · backup e arquivos" },
];
---
<BaseLayout title="Setup do Dejota" description="Conheça o computador, os equipamentos e as ferramentas usados por Dejota na construção do DejotaCode.">
  <main id="conteudo" tabindex="-1" class="setup-page">
    <div class="container">
      <nav class="setup-breadcrumbs" aria-label="Navegação estrutural"><a href="/">Início</a><span aria-hidden="true">›</span><a href="/store/">Store</a><span aria-hidden="true">›</span><span aria-current="page">Setup do Dejota</span></nav>
      <header class="setup-hero"><div><p class="eyebrow">MEU AMBIENTE DE TRABALHO</p><h1>Setup do Dejota</h1><p class="setup-lead">O computador, os equipamentos e as ferramentas que uso para construir o DejotaCode.</p><p class="setup-updated"><CategoryIcon icon="calendar" size={18}/>Configuração em atualização · <time datetime="2026-10">Outubro de 2026</time></p></div><div class="setup-illustration" aria-hidden="true"><SetupIllustration /></div></header>
      <section class="setup-computer setup-panel" aria-labelledby="setup-computer-title"><div class="setup-section-heading"><CategoryIcon icon="chip" size={42}/><div><h2 id="setup-computer-title">Meu computador</h2><p>Uma base simples para estudar, desenvolver e organizar o projeto.</p></div></div><div class="setup-specs">{specs.map(item=><div><CategoryIcon icon={item.icon} size={30}/><div><h3>{item.title}</h3><p>{item.detail}</p></div></div>)}</div><p class="setup-video"><CategoryIcon icon="monitor" size={20}/>Vídeo integrado Intel</p></section>
      <section class="setup-section" aria-labelledby="setup-peripherals-title"><div class="setup-section-heading"><CategoryIcon icon="monitor" size={28}/><h2 id="setup-peripherals-title">Tela e periféricos</h2></div><div class="setup-peripherals">{peripherals.map(item=><article class="setup-panel"><CategoryIcon icon={item.icon} size={40}/><h3>{item.title}</h3><p>{item.detail}</p><small>{item.pending}</small></article>)}</div></section>
      <section class="setup-section" aria-labelledby="setup-storage-title"><div class="setup-section-heading"><CategoryIcon icon="database" size={28}/><h2 id="setup-storage-title">Como organizo o armazenamento</h2></div><div class="setup-storage">{disks.map(item=><article class="setup-panel"><CategoryIcon icon="database" size={38}/><div><p class="eyebrow">{item.purpose}</p><h3>{item.title}</h3><p>{item.detail}</p></div></article>)}</div><p class="setup-inventory-note"><CategoryIcon icon="checklist" size={22}/>Armazenamento conferido com a foto dos equipamentos, a leitura local e a confirmação de Dejota.</p></section>
      <section class="setup-section" aria-labelledby="setup-tools-title"><div class="setup-section-heading"><CategoryIcon icon="workflow" size={28}/><h2 id="setup-tools-title">Ferramentas de trabalho</h2></div><div class="setup-panel setup-tools"><div><CategoryIcon icon="code" size={30}/><div><h3>VS Code</h3><p>Desenvolvimento do projeto</p></div></div><div><CategoryIcon icon="workflow" size={30}/><div><h3>Git</h3><p>Histórico e organização do código</p></div></div><p>A lista de ferramentas será confirmada antes da publicação.</p></div></section>
      <aside class="setup-transparency setup-panel"><CategoryIcon icon="shield-check" size={34}/><div><h2>Uso real, com transparência</h2><p>Os equipamentos foram informados por Dejota; a configuração do computador foi consultada localmente. Modelos pendentes serão confirmados antes de vincular recomendações.</p></div></aside>
      <nav class="setup-destinations" aria-label="Saiba mais sobre a DejotaStore"><a class="setup-panel" href="/store/"><CategoryIcon icon="wallet" size={32}/><div><strong>DejotaStore</strong><p>Explore produtos e ferramentas pesquisados.</p></div><span aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></a><a class="setup-panel" href="/store/como-avaliamos/"><CategoryIcon icon="news" size={32}/><div><strong>Como avaliamos</strong><p>Entenda nossos critérios de recomendação.</p></div><span aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></a></nav>
    </div>
  </main>
</BaseLayout>
