---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StoreCard from "../../../components/store/StoreCard.astro";

const categoryMap = {
  linux: { label: "Linux", description: "Pendrives, SSDs e acessórios para aprender e testar com segurança." },
  setup: { label: "Setup", description: "Equipamentos para estudar e trabalhar com mais conforto." },
  programacao: { label: "Programação", description: "Ferramentas e periféricos para desenvolvimento." },
  criadores: { label: "Criadores", description: "Áudio, vídeo e iluminação para produção de conteúdo." },
  "ferramentas-digitais": { label: "Ferramentas digitais", description: "Hospedagem, IA, VPN, cursos e serviços." },
} as const;

export function getStaticPaths() {
  return [
    "linux",
    "setup",
    "programacao",
    "criadores",
    "ferramentas-digitais",
  ].map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as keyof typeof categoryMap;
const category = categoryMap[slug];
const products = await getCollection("storeProducts", ({ data }) => !data.draft && data.category === slug);
const guides = await getCollection("storeGuides", ({ data }) => !data.draft && data.category === slug);
---

<BaseLayout title={`${category.label} na DejotaStore`} description={category.description}>
  <main id="conteudo" class="category-page">
    <div class="container">
      <nav class="breadcrumbs"><a href="/">Início</a><span>›</span><a href="/store/">Store</a><span>›</span><span>{category.label}</span></nav>
      <section class="hero">
        <p class="eyebrow">Categoria DejotaStore</p>
        <h1>{category.label}</h1>
        <p>{category.description}</p>
      </section>

      <section class="section">
        <div class="heading">
          <div><p class="eyebrow">Curadoria</p><h2>Produtos e ferramentas</h2></div>
        </div>
        <div class="products">
          {products.length > 0 ? products.map((product) => (
            <StoreCard
              id={product.id}
              title={product.data.title}
              description={product.data.description}
              status={product.data.editorialStatus}
              category={product.data.category}
            />
          )) : <p class="empty">Ainda não há recomendações publicadas nesta categoria.</p>}
        </div>
      </section>

      <section class="section">
        <div class="heading"><div><p class="eyebrow">Guias de compra</p><h2>Aprenda a escolher</h2></div></div>
        <div class="guides">
          {guides.length > 0 ? guides.map((guide) => (
            <a href={`/store/guias/${guide.id}/`}>
              <strong>{guide.data.title}</strong>
              <span>{guide.data.description}</span>
            </a>
          )) : <p class="empty">Os primeiros guias desta categoria ainda estão sendo preparados.</p>}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .container { width: min(calc(100% - (2 * var(--space-page))), var(--container)); margin-inline: auto; }
  .breadcrumbs { display:flex;flex-wrap:wrap;gap:.45rem;padding-top:1.5rem;color:var(--color-text-subtle);font-size:.82rem; }
  .breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{color:var(--color-accent-strong)}
  .hero{padding:2.5rem 0 2rem;border-bottom:1px solid var(--color-border)}
  .hero h1{margin:.35rem 0;font-size:clamp(2.5rem,7vw,4.5rem);letter-spacing:-.045em}.hero>p:last-child{max-width:60ch;color:var(--color-text-muted)}
  .eyebrow{margin:0;color:var(--color-accent-strong);font-size:.76rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .section{padding:2rem 0}.heading h2{margin:.3rem 0 1rem}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}
  .guides{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.guides a{display:grid;gap:.35rem;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface);text-decoration:none}.guides a:hover{border-color:var(--color-accent-strong)}.guides span,.empty{color:var(--color-text-muted)}
  @media(max-width:55rem){.products{grid-template-columns:repeat(2,1fr)}}@media(max-width:38rem){.products,.guides{grid-template-columns:1fr}}
</style>
