---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryIcon from "../../components/ui/CategoryIcon.astro";
import type { OfficialIconId } from "../../data/categoryIcons";
import "../../styles/about.css";
const principles: {icon: OfficialIconId; title: string; description: string}[] = [
  {icon: "news", title: "Clareza", description: "Explicar de forma simples, sem esconder detalhes que mudam uma decisão. O conteúdo vem antes da indicação."},
  {icon: "checklist", title: "Prática com evidência", description: "Mostrar o processo e diferenciar pesquisa, opinião, teste e confirmação antes de apresentar uma conclusão."},
  {icon: "shield-check", title: "Responsabilidade", description: "Apresentar contexto e limitações, sem atalhos perigosos, resultados inventados ou promessas fáceis."},
];
const steps: {icon: OfficialIconId; title: string; description: string}[] = [
  {icon: "terminal", title: "Testar", description: "Experimentar a ferramenta, processo ou hipótese."},
  {icon: "news", title: "Registrar", description: "Anotar etapas, condições e resultados observados."},
  {icon: "database", title: "Medir", description: "Usar dados quando ajudam a responder uma pergunta."},
  {icon: "checklist", title: "Verificar", description: "Separar o anunciado, o observado e o confirmado."},
  {icon: "network", title: "Publicar", description: "Transformar a experiência em conteúdo claro e útil."},
];
const areas: {icon: OfficialIconId; title: string; description: string; href: string}[] = [
  {icon: "news", title: "Blog", description: "Entender um assunto", href: "/blog/"},
  {icon: "workflow", title: "Trilhas", description: "Seguir uma sequência", href: "/trilhas/"},
  {icon: "apps", title: "Recursos", description: "Escolher ferramentas", href: "/recursos/"},
  {icon: "browser", title: "Portfólio", description: "Ver como construímos", href: "/portfolio/"},
];
---
<BaseLayout title="Sobre o DejotaCode para iniciantes | DejotaCode" description="Conheça o propósito, os princípios editoriais e a abordagem do DejotaCode para ensinar tecnologia de forma simples, prática e responsável.">
  <main id="conteudo" tabindex="-1" class="about-page">
    <header class="about-hero container">
      <div class="about-hero__copy">
        <p class="eyebrow">SOBRE O DEJOTACODE</p>
        <h1>Tecnologia explicada para quem está começando.</h1>
        <p class="about-introduction">Eu sou Joceilton. Por aqui, assino como Dejota.</p>
        <p class="about-lead">Aprendo colocando a mão na massa e compartilho o caminho de forma simples, prática e responsável.</p>
        <ul class="about-signature" aria-label="O propósito do projeto"><li><CategoryIcon icon="news" size={28} />Aprender</li><li><CategoryIcon icon="code" size={28} />Construir</li><li><CategoryIcon icon="network" size={28} />Compartilhar</li></ul>
      </div>
      <figure class="about-portrait"><img src="/assets/brand/dejota-author.webp" alt="Joceilton, conhecido como Dejota, criador do DejotaCode" width="900" height="1197" loading="eager" decoding="async" /><figcaption><strong>Joceilton — Dejota</strong><span>Criador do DejotaCode</span></figcaption></figure>
    </header>

    <section class="about-section about-story" aria-labelledby="about-story-title"><div class="container about-story__grid"><div><p class="eyebrow">COMO TUDO SE CONECTA</p><h2 id="about-story-title">Da curiosidade ao DejotaCode</h2><div class="about-story__copy"><p>Meu interesse por tecnologia me acompanha há anos. Aprendo instalando sistemas, testando ferramentas, construindo projetos, errando e pesquisando até entender por que cada coisa funciona. Linux, desenvolvimento web, programação e ferramentas digitais fazem parte desse caminho.</p><p>Mais do que decorar comandos, gosto de entender o processo e registrar o que aprendo. No DejotaCode, organizo essas descobertas em conteúdo prático para quem também está começando — com contexto para decidir o que faz sentido e qual é o próximo passo.</p></div></div><aside class="about-panel"><CategoryIcon icon="news" size={30} /><h3>Um espaço para aprender e compartilhar</h3><p>Transformo testes, experiências e projetos em explicações que possam ser repetidas, melhoradas e compartilhadas.</p><p class="about-motto">Conhecimento abre caminhos.</p></aside></div></section>

    <section class="about-section" aria-labelledby="about-principles-title"><div class="container"><p class="eyebrow">O QUE ORIENTA CADA CONTEÚDO</p><h2 id="about-principles-title">Clareza, prática e responsabilidade</h2><div class="about-principles">{principles.map(item => <article class="about-panel"><CategoryIcon icon={item.icon} size={34} /><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div></div></section>

    <section class="about-section" aria-labelledby="about-method-title"><div class="container"><p class="eyebrow">DA EXPERIÊNCIA À PUBLICAÇÃO</p><h2 id="about-method-title">Do teste ao conteúdo que chega até você</h2><p class="about-section-lead">Uma sequência para reduzir achismos e deixar claro o que foi realmente observado.</p><ol class="about-method">{steps.map((step,index) => <li><div><span aria-hidden="true">{String(index+1).padStart(2,"0")}</span><CategoryIcon icon={step.icon} size={28} /></div><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol></div></section>

    <section class="about-section about-destinations" aria-labelledby="about-areas-title"><div class="container"><p class="eyebrow">ENCONTRE SEU PRÓXIMO PASSO</p><h2 id="about-areas-title">Conteúdos para o seu momento</h2><div class="about-areas">{areas.map(area => <a class="about-panel" href={area.href}><CategoryIcon icon={area.icon} size={30} /><h3>{area.title}</h3><p>{area.description}</p><span class="about-arrow" aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></a>)}</div>
      <aside class="about-transparency"><CategoryIcon icon="shield-check" size={32} /><div><h3>Transparência em cada recomendação</h3><p>Links de afiliados, produtos próprios e outras relações comerciais são identificados. Pesquisa, uso e testes têm contextos diferentes; testes em andamento não são apresentados como resultados confirmados.</p></div><a href="/store/como-avaliamos/">Como avaliamos recomendações <span aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></a></aside>
      <section class="about-next" aria-labelledby="about-next-title"><h2 id="about-next-title">Você não precisa aprender tudo de uma vez.</h2><p>Escolha uma trilha ou explore o Blog para resolver uma dúvida.</p><div><a class="button button-primary" href="/trilhas/">Explorar trilhas <span aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></a><a class="button button-secondary" href="/blog/">Ir para o Blog</a></div></section>
    </div></section>
  </main>
</BaseLayout>
