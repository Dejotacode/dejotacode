---
import Pagination from "../../components/Pagination.astro";
import PostCard from "../../components/PostCard.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import { getOfficialCategoryIcon } from "../../data/categoryIcons";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  categories,
  categoryHref,
  getPublishedPosts,
  getFeaturedPost,
  postHref,
} from "../../lib/content";
import "../../styles/editorial.css";
import "../../styles/blog.css";

const FIRST_PAGE_COUNT = 7;
const PAGE_SIZE = 6;
const posts = await getPublishedPosts();
const featuredPost = getFeaturedPost(posts);
const remainingPosts = posts.filter((post) => post.id !== featuredPost?.id);
const orderedPosts = featuredPost
  ? [featuredPost, ...remainingPosts]
  : remainingPosts;
const firstPagePosts = orderedPosts.slice(0, FIRST_PAGE_COUNT);
const visiblePosts = firstPagePosts.filter((post) => post.id !== featuredPost?.id);
const remainingCount = Math.max(orderedPosts.length - FIRST_PAGE_COUNT, 0);
const totalPages = 1 + Math.ceil(remainingCount / PAGE_SIZE);

const canonicalUrl = new URL("/blog/", Astro.site ?? Astro.url.origin);

const blogListId = `${canonicalUrl.href}#itemlist`;

const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonicalUrl.href,
      url: canonicalUrl.href,
      name: "Blog de tecnologia para iniciantes | DejotaCode",
      description:
        "Tutoriais e artigos sobre Linux, programação, inteligência artificial, renda digital e tecnologia prática, explicados sem complicação.",
      inLanguage: "pt-BR",
      mainEntity: { "@id": blogListId },
      isPartOf: { "@id": "https://dejotacode.com.br/#website" },
    },
    {
      "@type": "ItemList",
      "@id": blogListId,
      numberOfItems: firstPagePosts.length,
      itemListOrder: "https://schema.org/ItemListOrderDescending",
      itemListElement: firstPagePosts.map((post, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: post.data.title,
        url: new URL(postHref(post), canonicalUrl).href,
      })),
    },
  ],
};
---

<BaseLayout
  title="Blog de tecnologia para iniciantes | DejotaCode"
  description="Tutoriais e artigos sobre Linux, programação, inteligência artificial, renda digital e tecnologia prática, explicados sem complicação."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <main id="conteudo" tabindex="-1" class="editorial-page blog-page">
    <header class="editorial-hero container">
      <p class="eyebrow">APRENDA NO SEU RITMO</p>
      <h1>Conteúdo prático, sem complicação.</h1>
      <p class="editorial-hero__lead">
        Tutoriais passo a passo, explicações simples e experiências reais para
        você usar tecnologia com mais confiança.
      </p>

      <nav class="category-list" aria-label="Categorias do blog">
        {
          Object.entries(categories).map(([slug, label]) => {
            const icon = getOfficialCategoryIcon(slug);
            return (
              <a href={categoryHref(slug as keyof typeof categories)}>
                {icon && <CategoryIcon icon={icon.iconId} size={17} />}
                <span>{label}</span>
              </a>
            );
          })
        }
      </nav>
    </header>

    {
      featuredPost && (
        <section class="editorial-section container" aria-labelledby="destaque-title">
          <h2 id="destaque-title" class="blog-sr-only">Conteúdo em destaque</h2>
          <PostCard post={featuredPost} featured showReadLink />
        </section>
      )
    }

    <section class="editorial-section container" aria-labelledby="recentes-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">PUBLICAÇÕES</p>
          <h2 id="recentes-title">Conteúdos recentes</h2>
        </div>
        <p>{posts.length} conteúdos publicados</p>
      </div>

      <div class="post-grid">
        {visiblePosts.map((post) => <PostCard post={post} />)}
      </div>

      <Pagination currentPage={1} totalPages={totalPages} basePath="/blog/" />
    </section>

    <aside class="blog-trails container" aria-labelledby="blog-trails-title">
      <div>
        <h2 id="blog-trails-title">Prefere aprender em sequência?</h2>
        <p>Nossas trilhas organizam os conteúdos por tema, com um próximo passo claro.</p>
      </div>
      <a href="/trilhas/">Conheça nossas trilhas <span aria-hidden="true">→</span></a>
    </aside>
  </main>
</BaseLayout>
