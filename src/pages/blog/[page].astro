---
import Pagination from "../../components/Pagination.astro";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  categories,
  categoryHref,
  getPublishedPosts,
  postHref,
} from "../../lib/content";
import "../../styles/editorial.css";

export async function getStaticPaths() {
  const PAGE_SIZE = 9;
  const posts = await getPublishedPosts();
  const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
  const remainingPosts = posts.filter((post) => post.id !== featuredPost?.id);
  const orderedPosts = featuredPost ? [featuredPost, ...remainingPosts] : remainingPosts;
  const totalPages = Math.ceil(orderedPosts.length / PAGE_SIZE);

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page, totalPages } };
  });
}

interface Props {
  page: number;
  totalPages: number;
}

const PAGE_SIZE = 9;
const { page, totalPages } = Astro.props;
const posts = await getPublishedPosts();
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== featuredPost?.id);
const orderedPosts = featuredPost ? [featuredPost, ...remainingPosts] : remainingPosts;
const start = (page - 1) * PAGE_SIZE;
const visiblePosts = orderedPosts.slice(start, start + PAGE_SIZE);

const canonicalUrl = new URL(`/blog/${page}/`, Astro.site ?? Astro.url.origin);
const blogListId = `${canonicalUrl.href}#itemlist`;
const title = `Blog de tecnologia para iniciantes — Página ${page} | DejotaCode`;
const description = `Página ${page} do blog DejotaCode com tutoriais sobre Linux, programação, inteligência artificial, renda digital e tecnologia prática.`;

const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonicalUrl.href,
      url: canonicalUrl.href,
      name: title,
      description,
      inLanguage: "pt-BR",
      mainEntity: { "@id": blogListId },
      isPartOf: { "@id": "https://dejotacode.com.br/blog/" },
    },
    {
      "@type": "ItemList",
      "@id": blogListId,
      numberOfItems: visiblePosts.length,
      itemListOrder: "https://schema.org/ItemListOrderDescending",
      itemListElement: visiblePosts.map((post, index) => ({
        "@type": "ListItem",
        position: start + index + 1,
        name: post.data.title,
        url: new URL(postHref(post), canonicalUrl).href,
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <main id="conteudo" tabindex="-1" class="editorial-page">
    <header class="editorial-hero container">
      <p class="eyebrow">APRENDA NO SEU RITMO</p>
      <h1>Conteúdo prático,<br />sem complicação.</h1>
      <p class="editorial-hero__lead">
        Página {page} de {totalPages} do arquivo de conteúdos do DejotaCode.
      </p>

      <nav class="category-list" aria-label="Categorias do blog">
        {
          Object.entries(categories).map(([slug, label]) => (
            <a href={categoryHref(slug as keyof typeof categories)}>{label}</a>
          ))
        }
      </nav>
    </header>

    <section class="editorial-section container" aria-labelledby="publicacoes-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">PUBLICAÇÕES</p>
          <h2 id="publicacoes-title">Mais conteúdos</h2>
        </div>
        <p>Página {page} de {totalPages}</p>
      </div>

      <div class="post-grid">
        {visiblePosts.map((post) => <PostCard post={post} />)}
      </div>

      <Pagination currentPage={page} totalPages={totalPages} basePath="/blog/" />
    </section>
  </main>
</BaseLayout>
