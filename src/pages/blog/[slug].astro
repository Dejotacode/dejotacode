---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import SocialShare from "../../components/SocialShare.astro";
import ConversionCTA from "../../components/ConversionCTA.astro";
import ArticleGuideResources from "../../components/ArticleGuideResources.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import VisualMedia from "../../components/visual/VisualMedia.astro";
import { resolvePostVisual } from "../../data/editorialVisuals";
import { getOfficialCategoryIcon } from "../../data/categoryIcons";
import { availableTrails } from "../../data/trails";
import { getArticleResources } from "../../data/recommendedResources";
import {
  categories,
  categoryHref,
  formatPostDate,
  getPublishedPosts,
  postHref,
  postSlug,
} from "../../lib/content";
import "../../styles/article.css";
import "../../styles/editorial.css";
import "../../styles/resources.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const allPosts = await getPublishedPosts();
const currentSlug = postSlug(post);
const articleResources = getArticleResources(currentSlug);
const relatedPosts = allPosts
  .filter(
    (candidate) =>
      candidate.id !== post.id && candidate.data.category === post.data.category,
  )
  .slice(0, 2);

const currentTrail = availableTrails.find((trail) =>
  trail.lessons.some((lesson) => lesson.slug === currentSlug),
);
const canonicalUrl = new URL(postHref(post), Astro.site ?? Astro.url);
const categoryLabel = categories[post.data.category];
const categoryIcon = getOfficialCategoryIcon(post.data.category);
const articleVisual = resolvePostVisual(post.data.category, currentSlug);
const categoryUrl = new URL(
  categoryHref(post.data.category),
  Astro.site ?? Astro.url,
);
const siteUrl = new URL("/", canonicalUrl);
const articleOgKey = canonicalUrl.pathname
  .replace(/^\/+|\/+$/g, "")
  .replaceAll("/", "--");
const articleOgPath = `/assets/og/${articleOgKey}.png`;
const articleOgFile = join(process.cwd(), "public", articleOgPath);
const articleImagePath = existsSync(articleOgFile)
  ? articleOgPath
  : "/assets/brand/opengraph-dark.png";
const articleImageUrl = new URL(articleImagePath, canonicalUrl);
const authorUrl = new URL("/sobre/", canonicalUrl);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Início",
      item: new URL("/", canonicalUrl).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", canonicalUrl).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: categoryLabel,
      item: categoryUrl.href,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: post.data.title,
      item: canonicalUrl.href,
    },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt
    ? { dateModified: post.data.updatedAt.toISOString() }
    : {}),
  mainEntityOfPage: canonicalUrl.href,
  image: articleImageUrl.href,
  inLanguage: "pt-BR",
  articleSection: categoryLabel,
  keywords: post.data.tags.join(", "),
  isPartOf: {
    "@id": `${siteUrl.href}#website`,
  },
  author: {
    "@type": "Person",
    name: "Dejota",
    url: authorUrl.href,
  },
  publisher: {
    "@type": "Organization",
    "@id": `${siteUrl.href}#organization`,
    name: "DejotaCode",
    url: siteUrl.href,
    logo: {
      "@type": "ImageObject",
      url: new URL("/assets/brand/icon-512.png", canonicalUrl).href,
    },
  },
};
---

<BaseLayout
  title={`${post.data.title} | DejotaCode`}
  description={post.data.description}
  image={articleImagePath}
  ogType="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main id="conteudo" tabindex="-1" class="article-page">
    <article>
      <header class="article-hero container">
        <nav class="breadcrumbs" aria-label="Navegação estrutural">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">/</span>
          <a href={categoryHref(post.data.category)}>{categoryLabel}</a>
        </nav>

        <div class="article-hero__content">
          <p class="article-category">
            {categoryIcon && <CategoryIcon icon={categoryIcon.iconId} size={17} />}
            <span class="article-category__name">{categoryLabel}</span>
            <span aria-hidden="true">·</span>
            <span class="article-category__type">{post.data.type}</span>
          </p>
          <h1>{post.data.title}</h1>
          <p class="article-hero__description">{post.data.description}</p>
          <div class="article-author-meta">
          <p class="article-byline"><img src="/assets/brand/dejota-author.webp" alt="" width="32" height="32" /> Por <a href="/sobre/">Dejota</a></p>

          <div class="article-meta">
            <span class="article-meta__item">
              <CategoryIcon icon="calendar" size={15} />
              <time datetime={post.data.publishedAt.toISOString()}>
                {formatPostDate(post.data.publishedAt)}
              </time>
            </span>
            <span class="article-meta__item">
              <CategoryIcon icon="clock" size={15} />
              <span>{post.data.readingTime} min de leitura</span>
            </span>
            <span class="article-meta__difficulty">{post.data.difficulty}</span>
          </div>
          </div>
        </div>

        <div class="article-cover">
          <VisualMedia src={articleVisual} fallbackSrc="/assets/resources/category-aprendizado.svg" alt={`Imagem editorial relacionada à categoria ${categoryLabel}`} label={post.data.title} aspect="card" loading="eager" />
        </div>
      </header>

      <div class:list={["article-layout", "container", { "article-layout--no-toc": tocHeadings.length === 0 }]}>
        {tocHeadings.length > 0 && (
          <aside class="article-aside" aria-label="Sumário do artigo">
            <nav class="article-aside__desktop" aria-label="Neste conteúdo">
              <p class="article-aside__title">Neste conteúdo</p>
              <ol>
                {tocHeadings.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
            <details class="article-aside__mobile">
              <summary>Neste conteúdo</summary>
              <ol>
                {tocHeadings.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </details>
          </aside>
        )}

        <div class="article-content">
          <Content />

          <section class="article-tags" aria-label="Assuntos relacionados">
            <strong>Assuntos:</strong>
            {post.data.tags.map((tag) => <span>{tag}</span>)}
          </section>

          <ArticleGuideResources productIds={post.data.storeProducts} resources={articleResources} />
        </div>
      </div>

      <div class="article-ending container">

          <ConversionCTA compact
            eyebrow="CONTINUE APRENDENDO"
            title="Veja a próxima etapa da sua trilha"
            description="Aprofunde seus conhecimentos e avance no seu aprendizado."
            href={currentTrail ? `/trilhas/${currentTrail.slug}/` : "/trilhas/"}
            label="Ver trilha"
            campaign={currentTrail ? `article-trail-${currentSlug}` : "article-trails"}
          />

          {currentTrail?.slug === "linux-do-zero" && (
            <ConversionCTA compact
              eyebrow="APROFUNDE O APRENDIZADO"
              title="Quer continuar com o Linux do Zero em um material completo?"
              description="O e-book Linux do Zero reúne 88 páginas para iniciantes, com instalação segura, terminal, permissões e solução de problemas. Preço de lançamento: R$ 19,90."
              href="/produtos/linux-do-zero/"
              label="Conhecer o e-book"
              campaign={`article-linux-ebook-${currentSlug}`}
            />
          )}

          <SocialShare title={post.data.title} url={canonicalUrl.href} />
      </div>
    </article>

    {
      relatedPosts.length > 0 && (
        <section class="related-section container" aria-labelledby="related-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">CONTINUE APRENDENDO</p>
              <h2 id="related-title">Conteúdos relacionados</h2>
            </div>
          </div>
          <div class="post-grid">
            {relatedPosts.map((relatedPost) => <PostCard post={relatedPost} blogMetaIcons />)}
          </div>
        </section>
      )
    }
  <script>
    const copyText = async (text: string) => {
      if (!navigator.clipboard?.writeText) {
        throw new Error("Clipboard API indisponível");
      }

      await navigator.clipboard.writeText(text);
    };

    document.querySelectorAll<HTMLElement>(".article-content pre").forEach((block) => {
      if (block.querySelector("[data-code-copy]")) return;

      const code = block.querySelector("code");
      if (!code) return;

      const language = block.dataset.language?.toLowerCase() ?? "";
      const isCommand = ["bash", "sh", "shell", "zsh", "console", "terminal"].includes(language);
      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy-button";
      button.dataset.codeCopy = "";
      button.textContent = isCommand ? "Copiar comando" : "Copiar código";
      button.setAttribute("aria-label", isCommand ? "Copiar comando para a área de transferência" : "Copiar código para a área de transferência");

      button.addEventListener("click", async () => {
        const original = button.textContent ?? "Copiar";
        try {
          await copyText(code.textContent ?? "");
          button.dataset.state = "copied";
          button.textContent = "Copiado ✓";
          window.setTimeout(() => {
            button.dataset.state = "";
            button.textContent = original;
          }, 1800);
        } catch {
          button.textContent = "Não foi possível copiar";
          window.setTimeout(() => {
            button.textContent = original;
          }, 2200);
        }
      });

      block.prepend(button);
    });
  </script>

  </main>
</BaseLayout>
