---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import SocialShare from "../../components/SocialShare.astro";
import ConversionCTA from "../../components/ConversionCTA.astro";
import ResourceRecommendations from "../../components/ResourceRecommendations.astro";
import { availableTrails } from "../../data/trails";
import { getArticleResources } from "../../data/recommendedResources";
import {
  categories,
  categoryHref,
  formatPostDate,
  getPublishedPosts,
  postHref,
  postSlug,
} from "../../lib/content";
import "../../styles/article.css";
import "../../styles/editorial.css";
import "../../styles/resources.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getPublishedPosts();
const currentSlug = postSlug(post);
const articleResources = getArticleResources(currentSlug);
const relatedPosts = allPosts
  .filter(
    (candidate) =>
      candidate.id !== post.id && candidate.data.category === post.data.category,
  )
  .slice(0, 2);

const currentTrail = availableTrails.find((trail) =>
  trail.lessons.some((lesson) => lesson.slug === currentSlug),
);
const currentTrailLessonIndex = currentTrail?.lessons.findIndex(
  (lesson) => lesson.slug === currentSlug,
) ?? -1;
const nextTrailLesson = currentTrail && currentTrailLessonIndex >= 0
  ? currentTrail.lessons[currentTrailLessonIndex + 1]
  : undefined;

const conversion = currentTrail && nextTrailLesson
  ? {
      title: `Próxima etapa: ${nextTrailLesson.title}`,
      description: `Você está seguindo a trilha ${currentTrail.title}. Continue na sequência recomendada para avançar sem precisar escolher o próximo conteúdo sozinho.`,
      href: `/blog/${nextTrailLesson.slug}/`,
      label: "Continuar para a próxima etapa",
      campaign: `article-next-${currentTrail.slug}`,
    }
  : currentTrail
    ? {
        title: `Continue pela trilha ${currentTrail.title}`,
        description: "Veja a sequência completa, marque seu progresso neste navegador e revise as etapas quando precisar.",
        href: `/trilhas/${currentTrail.slug}/`,
        label: "Ver trilha completa",
        campaign: `article-trail-${currentTrail.slug}`,
      }
    : {
        title: "Receba o próximo conteúdo por e-mail",
        description: "A newsletter reúne novos tutoriais, guias e recursos do DejotaCode sem transformar sua caixa de entrada em um feed infinito.",
        href: "/newsletter/?resource=artigo",
        label: "Conhecer a newsletter",
        campaign: "article-newsletter",
      };

const canonicalUrl = new URL(postHref(post), Astro.site ?? Astro.url);
const categoryLabel = categories[post.data.category];
const categoryUrl = new URL(
  categoryHref(post.data.category),
  Astro.site ?? Astro.url,
);
const siteUrl = new URL("/", canonicalUrl);
const articleOgKey = canonicalUrl.pathname
  .replace(/^\/+|\/+$/g, "")
  .replaceAll("/", "--");
const articleOgPath = `/assets/og/${articleOgKey}.png`;
const articleOgFile = join(process.cwd(), "public", articleOgPath);
const articleImagePath = existsSync(articleOgFile)
  ? articleOgPath
  : "/assets/brand/opengraph-dark.png";
const articleImageUrl = new URL(articleImagePath, canonicalUrl);
const authorUrl = new URL("/sobre/", canonicalUrl);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Início",
      item: new URL("/", canonicalUrl).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", canonicalUrl).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: categoryLabel,
      item: categoryUrl.href,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: post.data.title,
      item: canonicalUrl.href,
    },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt
    ? { dateModified: post.data.updatedAt.toISOString() }
    : {}),
  mainEntityOfPage: canonicalUrl.href,
  image: articleImageUrl.href,
  inLanguage: "pt-BR",
  articleSection: categoryLabel,
  keywords: post.data.tags.join(", "),
  isPartOf: {
    "@id": `${siteUrl.href}#website`,
  },
  author: {
    "@type": "Person",
    name: "Dejota",
    url: authorUrl.href,
  },
  publisher: {
    "@type": "Organization",
    "@id": `${siteUrl.href}#organization`,
    name: "DejotaCode",
    url: siteUrl.href,
    logo: {
      "@type": "ImageObject",
      url: new URL("/assets/brand/icon-512.png", canonicalUrl).href,
    },
  },
};
---

<BaseLayout
  title={`${post.data.title} | DejotaCode`}
  description={post.data.description}
  image={articleImagePath}
  ogType="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main id="conteudo" tabindex="-1" class="article-page">
    <article>
      <header class="article-hero container">
        <nav class="breadcrumbs" aria-label="Navegação estrutural">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">/</span>
          <a href={categoryHref(post.data.category)}>{categoryLabel}</a>
        </nav>

        <div class="article-hero__content">
          <p class="eyebrow">{categoryLabel} · {post.data.type}</p>
          <h1>{post.data.title}</h1>
          <p class="article-hero__description">{post.data.description}</p>

          <div class="article-meta">
            <span>Por Dejota</span>
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatPostDate(post.data.publishedAt)}
            </time>
            <span>{post.data.readingTime} min de leitura</span>
            <span>{post.data.difficulty}</span>
          </div>
        </div>

        <div class="article-cover" aria-hidden="true">
          <span class="article-cover__label">GUIA PRÁTICO</span>
          <strong>{post.data.type === "tutorial" ? "</>" : "01"}</strong>
          <span>{categoryLabel}</span>
        </div>
      </header>

      <div class="article-layout container">
        <aside class="article-aside" aria-label="Sumário do artigo">
          <div class="article-aside__sticky">
            <p class="article-aside__title">Neste conteúdo</p>
            {
              headings.length > 0 ? (
                <ol>
                  {headings
                    .filter((heading) => heading.depth === 2)
                    .map((heading) => (
                      <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                    ))}
                </ol>
              ) : (
                <p>Leitura direta e prática.</p>
              )
            }
          </div>
        </aside>

        <div class="article-content">
          <Content />

          {articleResources.length > 0 && (
            <ResourceRecommendations resources={articleResources} />
          )}

          <section class="article-tags" aria-label="Assuntos relacionados">
            <strong>Assuntos:</strong>
            {post.data.tags.map((tag) => <span>{tag}</span>)}
          </section>

          <SocialShare title={post.data.title} url={canonicalUrl.href} />

          <ConversionCTA
            title={conversion.title}
            description={conversion.description}
            href={conversion.href}
            label={conversion.label}
            campaign={conversion.campaign}
          />

          {currentTrail?.slug === "linux-do-zero" && (
            <ConversionCTA
              eyebrow="APROFUNDE O APRENDIZADO"
              title="Quer continuar com o Linux do Zero em um material completo?"
              description="O e-book Linux do Zero reúne 88 páginas para iniciantes, com instalação segura, terminal, permissões e solução de problemas. Preço de lançamento: R$ 19,90."
              href="/produtos/linux-do-zero/"
              label="Conhecer o e-book"
              campaign="article-linux-ebook-product"
            />
          )}
        </div>
      </div>
    </article>

    {
      relatedPosts.length > 0 && (
        <section class="related-section container" aria-labelledby="related-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">CONTINUE APRENDENDO</p>
              <h2 id="related-title">Conteúdos relacionados</h2>
            </div>
          </div>
          <div class="post-grid">
            {relatedPosts.map((relatedPost) => <PostCard post={relatedPost} />)}
          </div>
        </section>
      )
    }
  <script>
    const copyText = async (text: string) => {
      if (!navigator.clipboard?.writeText) {
        throw new Error("Clipboard API indisponível");
      }

      await navigator.clipboard.writeText(text);
    };

    document.querySelectorAll<HTMLElement>(".article-content pre").forEach((block) => {
      if (block.querySelector("[data-code-copy]")) return;

      const code = block.querySelector("code");
      if (!code) return;

      const language = block.dataset.language?.toLowerCase() ?? "";
      const isCommand = ["bash", "sh", "shell", "zsh", "console", "terminal"].includes(language);
      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy-button";
      button.dataset.codeCopy = "";
      button.textContent = isCommand ? "Copiar comando" : "Copiar código";
      button.setAttribute("aria-label", isCommand ? "Copiar comando para a área de transferência" : "Copiar código para a área de transferência");

      button.addEventListener("click", async () => {
        const original = button.textContent ?? "Copiar";
        try {
          await copyText(code.textContent ?? "");
          button.dataset.state = "copied";
          button.textContent = "Copiado ✓";
          window.setTimeout(() => {
            button.dataset.state = "";
            button.textContent = original;
          }, 1800);
        } catch {
          button.textContent = "Não foi possível copiar";
          window.setTimeout(() => {
            button.textContent = original;
          }, 2200);
        }
      });

      block.prepend(button);
    });
  </script>

  </main>
</BaseLayout>
