---
import StudioToolLayout from "../../../layouts/StudioToolLayout.astro";
import "../../../styles/admin-metrics.css";

const api = import.meta.env.PUBLIC_API_URL?.trim() || "http://localhost:8787";
---

<StudioToolLayout title="Snapshot final de mídia" description="Registro append-only antes de qualquer etapa de exclusão.">
  <section aria-label="Ferramenta do Studio" class="admin-page" data-api={api}>
    <div class="admin-panel">
      <p class="admin-kicker">Evidência antes do risco</p>
      <h1>Snapshot final de mídia</h1>
      <p class="admin-intro">
        Registre a evidência final depois de um dry-run novo e válido. O snapshot não remove arquivos.
      </p>

      <section class="metrics-section" aria-labelledby="snapshot-title">
        <div class="snapshot-heading">
          <div>
            <h2 id="snapshot-title">Mídias aptas ao snapshot</h2>
            <p class="metrics-section__note">Aparecem somente candidatas com Gate cleanup aprovado. Execute um dry-run novo nesta tela antes de gerar o snapshot.</p>
          </div>
          <div class="snapshot-actions">
            <button class="button" type="button" data-refresh>Atualizar</button>
            <a class="button" href="/admin/midia/dry-run/">Voltar ao Dry-run</a>
          </div>
        </div>

        <output data-status aria-live="polite">Carregando mídias aprovadas…</output>
        <div class="snapshot-grid" data-grid></div>
      </section>

      <section class="metrics-section" aria-labelledby="snapshot-limit-title">
        <h2 id="snapshot-limit-title">Resultado desta etapa</h2>
        <p class="metrics-section__note">
          O snapshot preserva a evidência de pré-exclusão no servidor. A remoção continua fora desta rota.
        </p>
      </section>

      <div class="admin-actions">
        <a class="button" href="/admin/midia/">Biblioteca de Mídia</a>
        <a class="button" href="/admin/midia/cleanup/">Gate cleanup</a>
        <a class="button" href="/admin/midia/dry-run/">Dry-run</a>
        <button class="button" type="button" data-logout>Sair</button>
      </div>
    </div>
  </section>

  <script>
    import { logoutAdmin, requireAdminSession } from "../../../scripts/admin-session";

    type MediaItem = {
      id: number;
      objectKey: string;
      contentType: string;
      sizeBytes: number;
      altText: string;
      createdAt: string;
      reviewStatus?: "pending" | "keep" | "candidate";
      cleanupStatus?: "pending" | "approved";
      cleanupNote?: string | null;
    };

    type DryRunCheck = {
      token: string;
      expiresAt: string;
      r2Exists: boolean;
      coverUsage: number;
      markdownReferences: string[];
    };

    type SnapshotResult = {
      snapshotId: number;
      snapshotHash: string;
      capturedAt: string;
      expiresAt: string;
    };

    const root = document.querySelector<HTMLElement>("[data-api]");
    const api = root?.dataset.api;
    const grid = document.querySelector<HTMLElement>("[data-grid]");
    const status = document.querySelector<HTMLOutputElement>("[data-status]");
    const refreshButton = document.querySelector<HTMLButtonElement>("[data-refresh]");
    const logoutButton = document.querySelector<HTMLButtonElement>("[data-logout]");

    let csrf = "";
    let items: MediaItem[] = [];
    const checks = new Map<number, DryRunCheck>();
    const snapshots = new Map<number, SnapshotResult>();

    const publicUrl = (objectKey: string) => `${api}/api/media/public/${objectKey}`;
    const formatDate = (value?: string) => {
      if (!value) return "—";
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat("pt-BR", { dateStyle: "short", timeStyle: "short" }).format(date);
    };

    const validCheck = (itemId: number) => {
      const check = checks.get(itemId);
      if (!check) return null;
      if (new Date(check.expiresAt).getTime() <= Date.now()) {
        checks.delete(itemId);
        snapshots.delete(itemId);
        return null;
      }
      return check;
    };

    const render = () => {
      if (!grid || !status) return;
      grid.replaceChildren();

      if (!items.length) {
        const empty = document.createElement("p");
        empty.className = "metrics-section__note";
        empty.textContent = "Nenhuma mídia possui revisão candidata e Gate cleanup aprovado.";
        grid.append(empty);
        status.textContent = empty.textContent;
        return;
      }

      for (const item of items) {
        const card = document.createElement("article");
        card.className = "snapshot-card";

        const image = document.createElement("img");
        image.src = publicUrl(item.objectKey);
        image.alt = item.altText || "Imagem da biblioteca";
        image.loading = "lazy";

        const body = document.createElement("div");
        body.className = "snapshot-card__body";

        const title = document.createElement("strong");
        title.textContent = item.altText || `Mídia #${item.id}`;
        const key = document.createElement("code");
        key.textContent = item.objectKey;
        const gate = document.createElement("span");
        gate.className = "snapshot-badge";
        gate.textContent = "Candidata · Gate cleanup aprovado";
        body.append(title, key, gate);

        if (item.cleanupNote) {
          const note = document.createElement("small");
          note.textContent = `Segunda revisão: ${item.cleanupNote}`;
          body.append(note);
        }

        const checkBox = document.createElement("div");
        checkBox.className = "snapshot-check";
        const snapshotBox = document.createElement("div");
        snapshotBox.className = "snapshot-result";

        const actions = document.createElement("div");
        actions.className = "snapshot-actions";
        const dryRunButton = document.createElement("button");
        dryRunButton.className = "button";
        dryRunButton.type = "button";
        dryRunButton.textContent = "Executar dry-run novo";
        const snapshotButton = document.createElement("button");
        snapshotButton.className = "button button-primary";
        snapshotButton.type = "button";
        snapshotButton.textContent = "Gerar snapshot final";
        snapshotButton.hidden = true;
        const open = document.createElement("a");
        open.className = "button";
        open.href = publicUrl(item.objectKey);
        open.target = "_blank";
        open.rel = "noreferrer";
        open.textContent = "Abrir imagem";
        actions.append(dryRunButton, snapshotButton, open);

        const renderState = () => {
          const check = validCheck(item.id);
          const snapshot = snapshots.get(item.id);
          checkBox.replaceChildren();
          snapshotBox.replaceChildren();

          const checkText = document.createElement("p");
          if (!check) {
            checkText.textContent = "Dry-run ainda não executado ou expirado.";
            snapshotButton.hidden = true;
          } else {
            checkText.textContent = `Dry-run elegível · R2 ${check.r2Exists ? "disponível" : "não encontrado"} · capas D1 ${check.coverUsage} · referências Markdown ${check.markdownReferences.length} · válido até ${formatDate(check.expiresAt)}.`;
            snapshotButton.hidden = Boolean(snapshot);
          }
          checkBox.append(checkText);

          if (snapshot) {
            const result = document.createElement("strong");
            result.textContent = `Snapshot #${snapshot.snapshotId} registrado em ${formatDate(snapshot.capturedAt)}.`;
            const hash = document.createElement("code");
            hash.textContent = snapshot.snapshotHash;
            const note = document.createElement("small");
            note.textContent = "Nenhuma exclusão foi executada.";
            snapshotBox.append(result, hash, note);
          }
        };

        dryRunButton.addEventListener("click", async () => {
          if (!api || !csrf) return;
          if (!window.confirm("Executar novo dry-run antes do snapshot? O servidor revalidará GitHub, D1 e R2. Nenhum arquivo será removido.")) return;
          dryRunButton.disabled = true;
          if (status) status.textContent = `Executando dry-run para #${item.id}…`;
          checks.delete(item.id);
          snapshots.delete(item.id);
          try {
            const response = await fetch(`${api}/api/media/cms/${item.id}/delete-dry-run`, {
              method: "POST",
              credentials: "include",
              headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
              body: JSON.stringify({ objectKey: item.objectKey }),
            });
            const payload = await response.json();
            if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível executar o dry-run.");
            const data = payload.data ?? {};
            if (!data.eligible) {
              const blockers = Array.isArray(data.blockers) ? data.blockers.join(", ") : "verificação inconclusiva";
              if (status) status.textContent = `Dry-run bloqueado: ${blockers}. Nenhuma exclusão foi executada.`;
              renderState();
              return;
            }
            const token = String(data.dryRunToken ?? "");
            const expiresAt = String(data.expiresAt ?? "");
            if (!token || !expiresAt) throw new Error("A API não retornou um token de dry-run válido.");
            checks.set(item.id, {
              token,
              expiresAt,
              r2Exists: Boolean(data.r2Exists),
              coverUsage: Number(data.coverUsage ?? 0),
              markdownReferences: Array.isArray(data.markdownReferences) ? data.markdownReferences.map(String) : [],
            });
            if (status) status.textContent = `Dry-run aprovado para #${item.id}. O snapshot pode ser gerado enquanto o check estiver válido.`;
            renderState();
          } catch (error) {
            if (status) status.textContent = error instanceof Error ? error.message : "Não foi possível executar o dry-run.";
          } finally {
            dryRunButton.disabled = false;
          }
        });

        snapshotButton.addEventListener("click", async () => {
          if (!api || !csrf) return;
          const check = validCheck(item.id);
          if (!check) {
            if (status) status.textContent = "O dry-run expirou. Execute um novo dry-run antes do snapshot.";
            renderState();
            return;
          }
          if (!window.confirm("Gerar snapshot final de pré-exclusão? O servidor registrará uma evidência append-only. Nenhum arquivo será removido.")) return;
          snapshotButton.disabled = true;
          if (status) status.textContent = `Gerando snapshot final para #${item.id}…`;
          try {
            const response = await fetch(`${api}/api/media/cms/${item.id}/delete-snapshot`, {
              method: "POST",
              credentials: "include",
              headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
              body: JSON.stringify({ objectKey: item.objectKey, dryRunToken: check.token }),
            });
            const payload = await response.json();
            if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível gerar o snapshot final.");
            const data = payload.data ?? {};
            const snapshotId = Number(data.snapshotId ?? 0);
            const snapshotHash = String(data.snapshotHash ?? "");
            const capturedAt = String(data.capturedAt ?? "");
            const expiresAt = String(data.expiresAt ?? check.expiresAt);
            if (!Number.isInteger(snapshotId) || snapshotId < 1 || !snapshotHash || !capturedAt) throw new Error("A API não retornou um snapshot final válido.");
            snapshots.set(item.id, { snapshotId, snapshotHash, capturedAt, expiresAt });
            if (status) status.textContent = `Snapshot final #${snapshotId} registrado. Nenhuma exclusão foi executada.`;
            renderState();
          } catch (error) {
            snapshots.delete(item.id);
            if (status) status.textContent = error instanceof Error ? error.message : "Não foi possível gerar o snapshot final.";
            renderState();
          } finally {
            snapshotButton.disabled = false;
          }
        });

        renderState();
        card.append(image, body, actions, checkBox, snapshotBox);
        grid.append(card);
      }

      status.textContent = `${items.length} mídia(s) apta(s) ao fluxo de snapshot. Nenhuma exclusão disponível nesta tela.`;
    };

    const load = async () => {
      if (!api || !status) return;
      status.textContent = "Carregando mídias aprovadas…";
      try {
        const response = await fetch(`${api}/api/media/cms`, { credentials: "include" });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível carregar a biblioteca.");
        const all = Array.isArray(payload.data?.items) ? payload.data.items : [];
        items = all.filter((item: MediaItem) => item.contentType.startsWith("image/") && item.reviewStatus === "candidate" && item.cleanupStatus === "approved");
        checks.clear();
        snapshots.clear();
        render();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Não foi possível carregar as mídias aprovadas.";
      }
    };

    const start = async () => {
      if (!api) return;
      const session = await requireAdminSession(api);
      if (!session) return;
      csrf = session.csrf;
      await load();
    };

    refreshButton?.addEventListener("click", load);
    logoutButton?.addEventListener("click", async () => {
      if (!api) return;
      await logoutAdmin(api, csrf);
      location.href = "/admin/";
    });

    start().catch(() => {
      if (status) status.textContent = "Não foi possível iniciar o snapshot de mídia.";
    });
  </script>

  <style>
    .snapshot-heading,
    .snapshot-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .snapshot-grid {
      display: grid;
      gap: 1rem;
      margin-top: 1rem;
    }

    .snapshot-card {
      display: grid;
      grid-template-columns: minmax(10rem, 14rem) 1fr;
      gap: 1rem;
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
    }

    .snapshot-card > img {
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: var(--radius-md);
      background: var(--color-surface-soft);
    }

    .snapshot-card__body,
    .snapshot-check,
    .snapshot-result {
      display: grid;
      gap: 0.5rem;
      align-content: start;
      min-width: 0;
    }

    .snapshot-card__body code,
    .snapshot-result code {
      overflow-wrap: anywhere;
    }

    .snapshot-badge {
      width: fit-content;
      padding: 0.25rem 0.55rem;
      border: 1px solid var(--color-border-strong);
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 800;
    }

    .snapshot-actions,
    .snapshot-check,
    .snapshot-result {
      grid-column: 1 / -1;
    }

    .snapshot-check,
    .snapshot-result {
      padding-top: 0.8rem;
      border-top: 1px solid var(--color-border);
    }

    .snapshot-check p,
    .snapshot-result small,
    [data-status] {
      color: var(--color-text-muted);
    }

    @media (max-width: 760px) {
      .snapshot-card {
        grid-template-columns: 1fr;
      }
    }
  </style>
</StudioToolLayout>
