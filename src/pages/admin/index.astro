---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin-metrics.css";

const api = import.meta.env.PUBLIC_API_URL?.trim() || "http://localhost:8787";
const posts = await getCollection("posts");
const draftPosts = posts.filter((post) => post.data.draft).length;
---

<AdminLayout title="Dashboard" description="Centro operacional privado do DejotaCode.">
  <main id="conteudo" class="admin-page admin-page--dashboard" data-api={api}>
    <div class="admin-panel">
      <p class="admin-kicker">Admin</p>
      <h1>Dashboard</h1>
      <p class="admin-intro">Veja o que precisa da sua atenção e siga direto para a próxima ação.</p>

      <section class="admin-login-card" data-login>
        <form class="admin-login-form" data-login-form>
          <label>
            E-mail
            <input name="email" type="email" required autocomplete="username" />
          </label>
          <label>
            Senha
            <input name="password" type="password" minlength="12" required autocomplete="current-password" />
          </label>
          <button class="button button-primary" type="submit">Entrar</button>
          <output aria-live="polite"></output>
        </form>
      </section>

      <section class="admin-dashboard" data-session-status hidden aria-label="Visão geral administrativa">
        <div class="admin-dashboard__header">
          <div>
            <p class="admin-dashboard__eyebrow">Hoje</p>
            <h2>O que precisa de atenção</h2>
          </div>
          <div class="admin-actions">
            <a class="button button-primary" href="/admin/editor/">Novo conteúdo</a>
            <button class="button" type="button" data-logout>Sair</button>
          </div>
        </div>

        <div class="admin-dashboard__cards">
          <a class="admin-dashboard-card" href="/admin/editor/">
            <span>Rascunhos</span>
            <strong>{draftPosts}</strong>
            <small>{draftPosts === 1 ? "conteúdo aguardando continuidade" : "conteúdos aguardando continuidade"}</small>
          </a>
          <a class="admin-dashboard-card" href="/admin/midia/revisao/">
            <span>Mídia para revisar</span>
            <strong data-media-review-count>—</strong>
            <small data-media-review-label>Verificando pendências…</small>
          </a>
        </div>

        <section class="admin-dashboard__section" aria-labelledby="admin-shortcuts-title">
          <div class="admin-dashboard__section-heading">
            <div>
              <p class="admin-dashboard__eyebrow">Acesso rápido</p>
              <h2 id="admin-shortcuts-title">Continuar trabalhando</h2>
            </div>
          </div>
          <div class="admin-dashboard__actions">
            <a class="admin-dashboard-action" href="/admin/editor/">
              <strong>Conteúdo</strong>
              <span>Criar, editar, revisar e publicar.</span>
            </a>
            <a class="admin-dashboard-action" href="/admin/midia/">
              <strong>Mídia</strong>
              <span>Biblioteca, revisão e manutenção.</span>
            </a>
            <a class="admin-dashboard-action" href="/admin/metricas/">
              <strong>Métricas</strong>
              <span>Acompanhar desempenho do projeto.</span>
            </a>
          </div>
        </section>
      </section>
    </div>
  </main>

  <script>
    import { fetchAdminSession, logoutAdmin } from "../../scripts/admin-session";

    const root = document.querySelector<HTMLElement>("[data-api]");
    const api = root?.dataset.api;
    const login = document.querySelector<HTMLElement>("[data-login]");
    const sessionStatus = document.querySelector<HTMLElement>("[data-session-status]");
    const loginForm = document.querySelector<HTMLFormElement>("[data-login-form]");
    const logoutButton = document.querySelector<HTMLButtonElement>("[data-logout]");
    const adminNav = document.querySelector<HTMLElement>("[data-admin-nav]");
    const mediaReviewCount = document.querySelector<HTMLElement>("[data-media-review-count]");
    const mediaReviewLabel = document.querySelector<HTMLElement>("[data-media-review-label]");

    const parseError = async (response: Response) => {
      try {
        const payload = await response.json();
        return payload.error?.message ?? "Não foi possível concluir.";
      } catch {
        return "Não foi possível concluir.";
      }
    };

    const loadMediaAttention = async () => {
      if (!api || !mediaReviewCount || !mediaReviewLabel) return;
      try {
        const response = await fetch(`${api}/api/media/cms`, { credentials: "include" });
        if (!response.ok) throw new Error("media unavailable");
        const payload = await response.json();
        const items = Array.isArray(payload.data?.items) ? payload.data.items : [];
        const pending = items.filter((item: { contentType?: string; reviewStatus?: string }) =>
          item.contentType?.startsWith("image/") && (!item.reviewStatus || item.reviewStatus === "pending")
        ).length;
        mediaReviewCount.textContent = String(pending);
        mediaReviewLabel.textContent = pending === 1
          ? "imagem aguardando revisão"
          : "imagens aguardando revisão";
      } catch {
        mediaReviewCount.textContent = "Ver";
        mediaReviewLabel.textContent = "Abrir revisão de mídia";
      }
    };

    const showAuthenticated = () => {
      if (login) login.hidden = true;
      if (sessionStatus) sessionStatus.hidden = false;
      if (adminNav) adminNav.hidden = false;
      loadMediaAttention().catch(() => {});
    };

    const checkSession = async () => {
      if (!api) return;
      const session = await fetchAdminSession(api);
      if (session) showAuthenticated();
    };

    loginForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!api) return;

      const output = loginForm.querySelector<HTMLOutputElement>("output");
      const formData = new FormData(loginForm);
      const submitButton = loginForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (output) output.textContent = "Entrando…";
      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch(`${api}/api/auth/login`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: String(formData.get("email") ?? ""),
            password: String(formData.get("password") ?? ""),
          }),
        });

        if (!response.ok) {
          if (output) output.textContent = await parseError(response);
          return;
        }

        showAuthenticated();
      } catch {
        if (output) output.textContent = "Não foi possível conectar ao serviço de autenticação. Tente novamente.";
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });

    logoutButton?.addEventListener("click", async () => {
      if (!api) return;
      const session = await fetchAdminSession(api);
      if (!session) {
        location.reload();
        return;
      }

      await logoutAdmin(api, session.csrf);
      location.reload();
    });

    checkSession().catch(() => {});
  </script>
</AdminLayout>
