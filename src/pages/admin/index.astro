---
import { getCollection } from "astro:content";
import { resolvePostVisual } from "../../data/editorialVisuals";
import StudioIcon from "../../components/studio/StudioIcon.astro";
import StudioLayout from "../../layouts/StudioLayout.astro";

const posts = await getCollection("posts");

const drafts = posts.filter((post) => post.data.draft);
const published = posts.filter((post) => !post.data.draft);
const missingCover = posts.filter(post=>!resolvePostVisual(post.data.category,post.id, post.data.coverImage));
const recentPosts = [...posts]
  .sort((a, b) => {
    if (a.data.draft !== b.data.draft) return a.data.draft ? -1 : 1;
    const dateA = (a.data.updatedAt ?? a.data.publishedAt).getTime();
    const dateB = (b.data.updatedAt ?? b.data.publishedAt).getTime();
    return dateB - dateA;
  })
  .slice(0, 5);

---

<StudioLayout title="Dashboard" description="Visão operacional da DejotaCode.">
<div class="studio-content studio-final-dashboard">
 <header class="studio-final-page-head"><small>Visão geral</small><h1>Olá, Dejota.</h1><p>O que precisa da sua atenção agora, sem transformar o Studio em um painel genérico.</p></header>
 <section class="studio-final-stats" aria-label="Estado do conteúdo local">
  <article><span>Conteúdos</span><strong>{posts.length}</strong></article>
  <article><span>Rascunhos</span><strong>{drafts.length}</strong></article>
  <article title="Arquivos com draft false; não certifica a versão publicada"><span>Não rascunhos</span><strong>{published.length}</strong></article>
  <article title="Condição derivada do resolvedor visual"><span>Sem capa resolvida</span><strong>{missingCover.length}</strong></article>
 </section>
 <div class="studio-final-dashboard-grid">
 <section class="studio-final-card" aria-labelledby="recent-title"><h2 id="recent-title">Continuar trabalhando</h2>
 {recentPosts.map(post=><a class="studio-final-row" href={'/admin/conteudo/?post='+encodeURIComponent(post.id)}><span>{post.data.title}</span><small>{post.data.draft?"Rascunho":"Não rascunho"}</small><StudioIcon name="arrow-right" /></a>)}
 </section>
 <section class="studio-final-card"><h2>Fontes e integrações</h2><dl class="studio-final-facts">
 <div><dt>Fonte editorial</dt><dd>Markdown / Git</dd></div>
 <div><dt>GSC + GA4</dt><dd>Consultar snapshot no SEO</dd></div>
 <div><dt>Publicação automática</dt><dd>Desativada</dd></div>
 <div><dt>IA</dt><dd>Codex / ChatGPT · verificar no editor</dd></div>
 </dl></section>
 </div>
</div>
</StudioLayout>
