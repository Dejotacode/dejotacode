---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin-metrics.css";

const api = import.meta.env.PUBLIC_API_URL?.trim() || "http://localhost:8787";
const posts = await getCollection("posts");
const totalPosts = posts.length;
const draftPosts = posts.filter((post) => post.data.draft).length;
const publishedPosts = totalPosts - draftPosts;
---

<AdminLayout title="Dashboard" description="Centro operacional privado do DejotaCode.">
  <main id="conteudo" class="admin-page" data-api={api}>
    <div class="admin-panel">
      <p class="admin-kicker">Centro operacional</p>
      <h1>Dashboard DejotaCode</h1>
      <p class="admin-intro">
        Acompanhe o estado editorial do projeto e acesse as ferramentas administrativas sem criar uma segunda fonte de verdade para o conteúdo.
      </p>

      <section class="admin-login-card" data-login>
        <form class="admin-login-form" data-login-form>
          <label>
            E-mail
            <input name="email" type="email" required autocomplete="username" />
          </label>
          <label>
            Senha
            <input name="password" type="password" minlength="12" required autocomplete="current-password" />
          </label>
          <button class="button button-primary" type="submit">Entrar</button>
          <output aria-live="polite"></output>
        </form>
      </section>

      <section class="admin-dashboard" data-session-status hidden aria-label="Visão geral administrativa">
        <div class="admin-dashboard__header">
          <div>
            <p class="admin-dashboard__eyebrow">Sessão ativa</p>
            <h2>Visão geral</h2>
            <p>Git e Markdown continuam sendo a fonte canônica do conteúdo público.</p>
          </div>
          <button class="button" type="button" data-logout>Sair</button>
        </div>

        <div class="admin-dashboard__cards">
          <article class="admin-dashboard-card">
            <span>Conteúdos publicados</span>
            <strong>{publishedPosts}</strong>
            <small>Arquivos editoriais fora de rascunho.</small>
          </article>
          <article class="admin-dashboard-card">
            <span>Rascunhos</span>
            <strong>{draftPosts}</strong>
            <small>Conteúdos ainda marcados como draft.</small>
          </article>
          <article class="admin-dashboard-card">
            <span>Total editorial</span>
            <strong>{totalPosts}</strong>
            <small>Conteúdos encontrados em src/content/posts.</small>
          </article>
        </div>

        <section class="admin-dashboard__section" aria-labelledby="admin-quick-actions-title">
          <div class="admin-dashboard__section-heading">
            <div>
              <p class="admin-dashboard__eyebrow">Atalhos</p>
              <h2 id="admin-quick-actions-title">Ações rápidas</h2>
            </div>
          </div>
          <div class="admin-dashboard__actions">
            <a class="admin-dashboard-action" href="/admin/editor/">
              <strong>Novo conteúdo</strong>
              <span>Criar ou revisar Markdown com preview e Pull Request.</span>
            </a>
            <a class="admin-dashboard-action" href="/admin/editor/">
              <strong>Editor editorial</strong>
              <span>Acessar conteúdo, mídia, revisão e publicação assistida.</span>
            </a>
            <a class="admin-dashboard-action" href="/admin/metricas/">
              <strong>Ver métricas</strong>
              <span>Acompanhar tráfego, conversão, Store e campanhas.</span>
            </a>
          </div>
        </section>

        <section class="admin-dashboard__section" aria-labelledby="admin-flow-title">
          <div class="admin-dashboard__section-heading">
            <div>
              <p class="admin-dashboard__eyebrow">Fluxo protegido</p>
              <h2 id="admin-flow-title">Publicação</h2>
            </div>
          </div>
          <ol class="admin-dashboard__flow">
            <li><strong>1. Editar</strong><span>Conteúdo preparado no editor Git/Markdown.</span></li>
            <li><strong>2. Revisar</strong><span>Pull Request e CI validam a alteração.</span></li>
            <li><strong>3. Publicar</strong><span>Merge na main dispara deploy e smoke test.</span></li>
          </ol>
        </section>
      </section>
    </div>
  </main>

  <script>
    const root = document.querySelector<HTMLElement>("[data-api]");
    const api = root?.dataset.api;
    const login = document.querySelector<HTMLElement>("[data-login]");
    const sessionStatus = document.querySelector<HTMLElement>("[data-session-status]");
    const loginForm = document.querySelector<HTMLFormElement>("[data-login-form]");
    const logoutButton = document.querySelector<HTMLButtonElement>("[data-logout]");

    const parseError = async (response: Response) => {
      try {
        const payload = await response.json();
        return payload.error?.message ?? "Não foi possível concluir.";
      } catch {
        return "Não foi possível concluir.";
      }
    };

    const showAuthenticated = () => {
      if (login) login.hidden = true;
      if (sessionStatus) sessionStatus.hidden = false;
    };

    const checkSession = async () => {
      if (!api) return;

      const response = await fetch(`${api}/api/auth/session`, {
        credentials: "include",
      });

      if (response.ok) showAuthenticated();
    };

    loginForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!api) return;

      const output = loginForm.querySelector<HTMLOutputElement>("output");
      const formData = new FormData(loginForm);

      const submitButton = loginForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (output) output.textContent = "Entrando…";
      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch(`${api}/api/auth/login`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: String(formData.get("email") ?? ""),
            password: String(formData.get("password") ?? ""),
          }),
        });

        if (!response.ok) {
          if (output) output.textContent = await parseError(response);
          return;
        }

        showAuthenticated();
      } catch {
        if (output) {
          output.textContent = "Não foi possível conectar ao serviço de autenticação. Tente novamente.";
        }
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });

    logoutButton?.addEventListener("click", async () => {
      if (!api) return;

      const sessionResponse = await fetch(`${api}/api/auth/session`, {
        credentials: "include",
      });

      if (!sessionResponse.ok) {
        location.reload();
        return;
      }

      const payload = await sessionResponse.json();
      const csrf = payload.data?.csrf;

      await fetch(`${api}/api/auth/logout`, {
        method: "POST",
        credentials: "include",
        headers: csrf ? { "X-CSRF-Token": String(csrf) } : {},
      });

      location.reload();
    });

    checkSession().catch(() => {});
  </script>
</AdminLayout>
