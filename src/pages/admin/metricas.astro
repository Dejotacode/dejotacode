---
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin-metrics.css";

const api = import.meta.env.PUBLIC_API_URL?.trim() || "http://localhost:8787";
---

<AdminLayout title="Métricas" description="Métricas agregadas do DejotaCode nos últimos 30 dias.">
  <main id="conteudo" class="admin-page" data-api={api}>
    <div class="admin-panel">
      <p class="admin-kicker">Últimos 30 dias</p>
      <h1>Métricas e conversão</h1>
      <p class="admin-intro">
        Totais agregados para acompanhar conteúdo, conversão e trilhas sem identificação de visitantes.
      </p>

      <div class="admin-actions">
        <a class="button" href="/admin/">Painel</a>
        <button class="button" type="button" data-logout>Sair</button>
      </div>

      <p class="metrics-loading" data-loading>Carregando métricas…</p>

      <section aria-label="Totais de eventos">
        <div class="metric-cards" data-totals></div>
      </section>

      <section aria-label="Indicadores de conversão">
        <div class="funnel-cards" data-funnel></div>
      </section>

      <section class="metrics-section">
        <h2>Páginas mais lidas</h2>
        <p class="metrics-section__note">Ranking por visualizações agregadas no período.</p>
        <div class="metrics-ranking" data-pages></div>
      </section>

      <section class="metrics-section">
        <h2>Campanhas e ações</h2>
        <p class="metrics-section__note">Eventos agregados por campanha no período.</p>
        <div class="metrics-ranking metrics-ranking--campaigns" data-campaigns></div>
      </section>
    </div>
  </main>

  <script>
    type MetricItem = {
      event: string;
      total: number;
    };

    type PageItem = {
      path: string;
      total: number;
    };

    type CampaignItem = {
      campaign: string;
      event: string;
      total: number;
    };

    type SummaryData = {
      periodDays: number;
      totals: MetricItem[];
      pages: PageItem[];
      campaigns?: CampaignItem[];
    };

    const root = document.querySelector<HTMLElement>("[data-api]");
    const api = root?.dataset.api;
    const loading = document.querySelector<HTMLElement>("[data-loading]");
    const logoutButton = document.querySelector<HTMLButtonElement>("[data-logout]");

    const labels: Record<string, string> = {
      page_view: "Visualizações",
      cta_click: "Cliques em CTA",
      lead_submit: "Inscrições",
      contact_submit: "Contatos",
      form_start: "Formulários iniciados",
      guide_access: "Acessos ao guia",
      trail_start: "Trilhas iniciadas",
      trail_lesson_click: "Etapas acessadas",
      trail_complete: "Trilhas concluídas",
    };

    const numberFormat = new Intl.NumberFormat("pt-BR");
    const percentFormat = new Intl.NumberFormat("pt-BR", {
      style: "percent",
      maximumFractionDigits: 1,
    });

    let csrf = "";

    const totalFor = (data: SummaryData, event: string) =>
      Number(data.totals.find((item) => item.event === event)?.total ?? 0);

    const ratio = (value: number, base: number) => (base > 0 ? value / base : 0);

    const renderEmpty = (container: HTMLElement, message: string) => {
      const empty = document.createElement("p");
      empty.className = "metrics-empty";
      empty.textContent = message;
      container.replaceChildren(empty);
    };

    const createMetricCard = (label: string, value: string) => {
      const card = document.createElement("article");
      card.className = "metric-card";

      const strong = document.createElement("strong");
      const span = document.createElement("span");
      strong.textContent = value;
      span.textContent = label;
      card.append(strong, span);
      return card;
    };

    const renderSummary = (data: SummaryData) => {
      const totals = document.querySelector<HTMLElement>("[data-totals]");
      const funnel = document.querySelector<HTMLElement>("[data-funnel]");
      const pages = document.querySelector<HTMLElement>("[data-pages]");
      const campaigns = document.querySelector<HTMLElement>("[data-campaigns]");

      if (!totals || !funnel || !pages || !campaigns) return;

      totals.replaceChildren();
      data.totals.forEach((item) => {
        totals.append(createMetricCard(labels[item.event] ?? item.event, numberFormat.format(Number(item.total))));
      });

      const pageViews = totalFor(data, "page_view");
      const ctaClicks = totalFor(data, "cta_click");
      const formStarts = totalFor(data, "form_start");
      const leads = totalFor(data, "lead_submit");
      const trailStarts = totalFor(data, "trail_start");
      const trailCompletions = totalFor(data, "trail_complete");

      const funnelItems: Array<[string, string]> = [
        ["CTR de CTA", percentFormat.format(ratio(ctaClicks, pageViews))],
        ["Início de formulário", percentFormat.format(ratio(formStarts, pageViews))],
        ["Conversão em lead", percentFormat.format(ratio(leads, pageViews))],
        ["Lead após início", percentFormat.format(ratio(leads, formStarts))],
        ["Conclusão de trilha", percentFormat.format(ratio(trailCompletions, trailStarts))],
      ];

      funnel.replaceChildren();
      funnelItems.forEach(([label, value]) => funnel.append(createMetricCard(label, value)));

      pages.replaceChildren();
      if (!data.pages.length) {
        renderEmpty(pages, "Ainda não há visualizações no período.");
      } else {
        data.pages.forEach((item, index) => {
          const row = document.createElement("div");
          row.className = "metrics-ranking__row";

          const rank = document.createElement("b");
          rank.className = "metrics-ranking__rank";
          rank.textContent = String(index + 1);

          const path = document.createElement("span");
          path.className = "metrics-ranking__context";
          path.textContent = item.path;

          const total = document.createElement("strong");
          total.textContent = numberFormat.format(Number(item.total));

          row.append(rank, path, total);
          pages.append(row);
        });
      }

      campaigns.replaceChildren();
      const campaignItems = data.campaigns ?? [];

      if (!campaignItems.length) {
        renderEmpty(campaigns, "Ainda não há campanhas registradas no período.");
      } else {
        campaignItems.forEach((item, index) => {
          const row = document.createElement("div");
          row.className = "metrics-ranking__row";

          const rank = document.createElement("b");
          rank.className = "metrics-ranking__rank";
          rank.textContent = String(index + 1);

          const context = document.createElement("span");
          context.className = "metrics-ranking__context";
          context.textContent = `${item.campaign} · ${labels[item.event] ?? item.event}`;

          const total = document.createElement("strong");
          total.textContent = numberFormat.format(Number(item.total));

          row.append(rank, context, total);
          campaigns.append(row);
        });
      }
    };

    const start = async () => {
      if (!api) return;

      const session = await fetch(`${api}/api/auth/session`, {
        credentials: "include",
      });

      if (!session.ok) {
        location.href = "/admin/";
        return;
      }

      const sessionPayload = await session.json();
      csrf = String(sessionPayload.data?.csrf ?? "");

      const response = await fetch(`${api}/api/analytics/summary`, {
        credentials: "include",
      });

      if (!response.ok) {
        if (loading) loading.textContent = "Não foi possível carregar as métricas.";
        return;
      }

      const payload = await response.json();
      renderSummary(payload.data as SummaryData);
      if (loading) loading.hidden = true;
    };

    logoutButton?.addEventListener("click", async () => {
      if (!api) return;

      await fetch(`${api}/api/auth/logout`, {
        method: "POST",
        credentials: "include",
        headers: csrf ? { "X-CSRF-Token": csrf } : {},
      });

      location.href = "/admin/";
    });

    start().catch(() => {
      if (loading) loading.textContent = "Não foi possível carregar as métricas.";
    });
  </script>
</AdminLayout>
