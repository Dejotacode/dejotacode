---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin-metrics.css";

const api = import.meta.env.PUBLIC_API_URL?.trim() || "http://localhost:8787";
const posts = await getCollection("posts");
const mediaPattern = /https:\/\/api\.dejotacode\.com\.br\/api\/media\/public\/([^\s)]+)/g;
const canonicalMediaKeys = [...new Set(posts.flatMap((post) => {
  const keys: string[] = [];
  for (const match of (post.body ?? "").matchAll(mediaPattern)) {
    if (match[1]) keys.push(match[1]);
  }
  return keys;
}))];
---

<AdminLayout title="Mídia" description="Biblioteca de mídia do DejotaCode.">
  <main id="conteudo" class="admin-page" data-api={api}>
    <div class="admin-panel">
      <p class="admin-kicker">Biblioteca operacional</p>
      <h1>Mídia</h1>
      <p class="admin-intro">
        Consulte a biblioteca real de imagens do DejotaCode e gere um relatório de uso e segurança em modo leitura. Nenhuma ação desta tela altera ou remove arquivos.
      </p>

      <section class="metrics-section" aria-labelledby="media-library-title">
        <div class="media-toolbar__heading">
          <div>
            <h2 id="media-library-title">Biblioteca de imagens</h2>
            <p class="metrics-section__note">
              Busca, consulta, cópia de URL e classificação de segurança. Nenhuma ação desta tela grava decisões ou remove arquivos.
            </p>
          </div>
          <strong class="media-count" data-media-count>0 imagens</strong>
        </div>

        <div class="media-toolbar">
          <label class="media-search">
            <span>Buscar na biblioteca</span>
            <input type="search" placeholder="Alt text ou caminho do arquivo" data-media-search />
          </label>
          <label class="media-filter">
            <span>Segurança</span>
            <select data-media-safety-filter>
              <option value="all">Todas</option>
              <option value="used">Em uso</option>
              <option value="orphan">Possivelmente órfãs</option>
              <option value="review">Requer revisão</option>
            </select>
          </label>
          <button class="button" type="button" data-refresh-media>Atualizar biblioteca</button>
        </div>

        <output class="media-library-status" data-media-status>Carregando biblioteca…</output>
        <div class="media-library-grid" data-media-grid aria-live="polite"></div>
      </section>

      <section class="metrics-section" aria-labelledby="media-safety-title">
        <div class="media-toolbar__heading">
          <div>
            <h2 id="media-safety-title">Relatório de uso e segurança</h2>
            <p class="metrics-section__note">
              Cruza referências Markdown, capas do CMS e disponibilidade pública da mídia. “Possivelmente órfã” nunca autoriza exclusão automática.
            </p>
          </div>
          <button class="button" type="button" data-media-safety-run>Gerar relatório</button>
        </div>
        <output class="media-library-status" data-media-safety-status>Relatório ainda não executado.</output>
        <div class="media-safety-summary" data-media-safety-summary hidden></div>
      </section>

      <section class="metrics-section" aria-labelledby="media-safety-note-title">
        <h2 id="media-safety-note-title">Limite desta etapa</h2>
        <p class="metrics-section__note">
          Upload, revisão humana, cleanup, dry-run, snapshot e exclusão continuam no Editor. O relatório desta tela é somente leitura e exige revisão humana antes de qualquer etapa futura.
        </p>
      </section>

      <div class="admin-actions">
        <a class="button" href="/admin/editor/">Abrir Editor</a>
        <button class="button" type="button" data-logout>Sair</button>
      </div>
    </div>
  </main>

  <script is:inline id="canonical-media-keys" type="application/json" set:html={JSON.stringify(canonicalMediaKeys).replaceAll("<", "\\u003c").replaceAll(">", "\\u003e")} />

  <script>
    import { logoutAdmin, requireAdminSession } from "../../scripts/admin-session";

    type MediaItem = {
      id: number;
      objectKey: string;
      contentType: string;
      sizeBytes: number;
      altText: string;
      createdAt: string;
    };

    type SafetyState = "used" | "orphan" | "review";

    const root = document.querySelector<HTMLElement>("[data-api]");
    const api = root?.dataset.api;
    const logoutButton = document.querySelector<HTMLButtonElement>("[data-logout]");
    const refreshButton = document.querySelector<HTMLButtonElement>("[data-refresh-media]");
    const searchInput = document.querySelector<HTMLInputElement>("[data-media-search]");
    const safetyFilter = document.querySelector<HTMLSelectElement>("[data-media-safety-filter]");
    const safetyButton = document.querySelector<HTMLButtonElement>("[data-media-safety-run]");
    const safetyStatus = document.querySelector<HTMLOutputElement>("[data-media-safety-status]");
    const safetySummary = document.querySelector<HTMLElement>("[data-media-safety-summary]");
    const status = document.querySelector<HTMLOutputElement>("[data-media-status]");
    const grid = document.querySelector<HTMLElement>("[data-media-grid]");
    const count = document.querySelector<HTMLElement>("[data-media-count]");
    const keysNode = document.querySelector<HTMLScriptElement>("#canonical-media-keys");
    const canonicalMediaKeys = new Set<string>(keysNode?.textContent ? JSON.parse(keysNode.textContent) : []);

    let csrf = "";
    let mediaItems: MediaItem[] = [];
    let safetyStates = new Map<string, SafetyState>();

    const mediaPublicUrl = (objectKey: string) => api
      ? new URL(`/api/media/public/${objectKey}`, `${api}/`).toString()
      : "";

    const normalizedSearch = (input: string) => input
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();

    const formatBytes = (bytes: number) => {
      if (!Number.isFinite(bytes) || bytes < 0) return "—";
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    };

    const formatMediaDate = (input: string) => {
      const normalized = input.includes("T") ? input : `${input.replace(" ", "T")}Z`;
      const date = new Date(normalized);
      return Number.isNaN(date.getTime())
        ? input
        : new Intl.DateTimeFormat("pt-BR", { dateStyle: "short", timeStyle: "short" }).format(date);
    };

    const filteredMedia = () => {
      const query = normalizedSearch(searchInput?.value ?? "");
      const safety = safetyFilter?.value ?? "all";
      return mediaItems
        .filter((item) => item.contentType.startsWith("image/"))
        .filter((item) => safety === "all" || safetyStates.get(item.objectKey) === safety)
        .filter((item) => !query || normalizedSearch(`${item.altText} ${item.objectKey}`).includes(query))
        .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
    };

    const safetyLabel = (state: SafetyState) => state === "used"
      ? "Segurança: em uso"
      : state === "orphan"
        ? "Segurança: possivelmente órfã"
        : "Segurança: requer revisão";

    const renderLibrary = () => {
      if (!grid || !status || !count) return;
      grid.replaceChildren();
      const images = filteredMedia();
      const totalImages = mediaItems.filter((item) => item.contentType.startsWith("image/")).length;

      count.textContent = `${totalImages} ${totalImages === 1 ? "imagem" : "imagens"}`;

      if (!images.length) {
        const empty = document.createElement("p");
        empty.className = "media-empty";
        empty.textContent = totalImages
          ? "Nenhuma imagem corresponde aos filtros atuais."
          : "A biblioteca ainda não possui imagens disponíveis.";
        grid.append(empty);
        status.textContent = totalImages
          ? `0 de ${totalImages} imagem(ns) exibida(s).`
          : "Nenhuma imagem disponível na biblioteca.";
        return;
      }

      for (const item of images) {
        const card = document.createElement("article");
        card.className = "media-card";

        const image = document.createElement("img");
        image.src = mediaPublicUrl(item.objectKey);
        image.alt = item.altText || "Imagem editorial sem texto alternativo";
        image.loading = "lazy";
        image.decoding = "async";

        const body = document.createElement("div");
        body.className = "media-card__body";

        const title = document.createElement("strong");
        title.textContent = item.altText || "Sem texto alternativo";

        const meta = document.createElement("span");
        meta.textContent = `${formatBytes(Number(item.sizeBytes))} · ${formatMediaDate(item.createdAt)}`;

        const key = document.createElement("code");
        key.textContent = item.objectKey;

        const safetyState = safetyStates.get(item.objectKey);
        if (safetyState) {
          const badge = document.createElement("span");
          badge.className = "media-card__safety";
          badge.dataset.state = safetyState;
          badge.textContent = safetyLabel(safetyState);
          body.append(title, meta, key, badge);
        } else {
          body.append(title, meta, key);
        }

        const actions = document.createElement("div");
        actions.className = "media-card__actions";

        const openLink = document.createElement("a");
        openLink.className = "button";
        openLink.href = mediaPublicUrl(item.objectKey);
        openLink.target = "_blank";
        openLink.rel = "noreferrer";
        openLink.textContent = "Abrir imagem";

        const copyButton = document.createElement("button");
        copyButton.className = "button";
        copyButton.type = "button";
        copyButton.textContent = "Copiar URL";
        copyButton.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(mediaPublicUrl(item.objectKey));
            status.textContent = "URL pública da imagem copiada.";
          } catch {
            status.textContent = "O navegador bloqueou a cópia automática da URL.";
          }
        });

        actions.append(openLink, copyButton);
        body.append(actions);
        card.append(image, body);
        grid.append(card);
      }

      status.textContent = `${images.length} de ${totalImages} imagem(ns) exibida(s), mais recentes primeiro.`;
    };

    const renderSafetySummary = (counts: { used: number; orphan: number; review: number; checked: number }) => {
      if (!safetySummary) return;
      safetySummary.replaceChildren();
      const items: Array<[string, number]> = [
        ["Em uso", counts.used],
        ["Possivelmente órfãs", counts.orphan],
        ["Requer revisão", counts.review],
        ["R2 verificado", counts.checked],
      ];
      for (const [label, value] of items) {
        const card = document.createElement("span");
        const strong = document.createElement("strong");
        const small = document.createElement("small");
        strong.textContent = String(value);
        small.textContent = label;
        card.append(strong, small);
        safetySummary.append(card);
      }
      safetySummary.hidden = false;
    };

    const runSafetyReport = async () => {
      if (!api || !safetyButton || !safetyStatus) return;
      safetyButton.disabled = true;
      safetyStatus.textContent = "Cruzando referências e verificando objetos no R2…";
      try {
        if (!mediaItems.length) await loadMediaLibrary();
        const cmsResponse = await fetch(`${api}/api/cms/posts`, { credentials: "include" });
        const cmsPayload = await cmsResponse.json();
        if (!cmsResponse.ok) throw new Error(cmsPayload.error?.message ?? "Não foi possível consultar as capas do CMS.");
        const cmsPosts = Array.isArray(cmsPayload.data?.items) ? cmsPayload.data.items : [];
        const coverKeys = new Set<string>(cmsPosts.map((post: { coverKey?: string | null }) => post.coverKey).filter(Boolean));
        const states = new Map<string, SafetyState>();
        let checked = 0;

        for (const item of mediaItems) {
          if (!item.contentType.startsWith("image/")) continue;
          const used = canonicalMediaKeys.has(item.objectKey) || coverKeys.has(item.objectKey);
          let reachable = false;
          try {
            const response = await fetch(mediaPublicUrl(item.objectKey), { method: "HEAD", credentials: "omit" });
            reachable = response.ok;
            checked += 1;
          } catch {
            reachable = false;
          }
          const state: SafetyState = used
            ? "used"
            : reachable && item.objectKey.startsWith("posts/")
              ? "orphan"
              : "review";
          states.set(item.objectKey, state);
        }

        safetyStates = states;
        const counts = { used: 0, orphan: 0, review: 0, checked };
        for (const state of states.values()) counts[state] += 1;
        renderSafetySummary(counts);
        renderLibrary();
        safetyStatus.textContent = `Relatório concluído para ${states.size} imagem(ns). “Possivelmente órfã” exige revisão humana antes de qualquer ação.`;
      } catch (error) {
        safetyStatus.textContent = error instanceof Error ? error.message : "Não foi possível gerar o relatório de segurança.";
      } finally {
        safetyButton.disabled = false;
      }
    };

    const loadMediaLibrary = async () => {
      if (!api || !grid || !status) return;
      if (refreshButton) refreshButton.disabled = true;
      status.textContent = "Atualizando biblioteca…";
      try {
        const response = await fetch(`${api}/api/media/cms`, { credentials: "include" });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível carregar a biblioteca de imagens.");
        mediaItems = Array.isArray(payload.data?.items) ? payload.data.items : [];
        renderLibrary();
      } catch (error) {
        grid.replaceChildren();
        status.textContent = error instanceof Error ? error.message : "Não foi possível carregar a biblioteca de imagens.";
      } finally {
        if (refreshButton) refreshButton.disabled = false;
      }
    };

    const start = async () => {
      if (!api) return;
      const session = await requireAdminSession(api);
      if (!session) return;
      csrf = session.csrf;
      await loadMediaLibrary();
    };

    searchInput?.addEventListener("input", renderLibrary);
    safetyFilter?.addEventListener("change", renderLibrary);
    refreshButton?.addEventListener("click", loadMediaLibrary);
    safetyButton?.addEventListener("click", runSafetyReport);

    logoutButton?.addEventListener("click", async () => {
      if (!api) return;
      await logoutAdmin(api, csrf);
      location.href = "/admin/";
    });

    start().catch(() => {
      if (status) status.textContent = "Não foi possível iniciar a biblioteca de mídia.";
    });
  </script>

  <style>
    .media-toolbar__heading,
    .media-toolbar,
    .media-card__actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .media-toolbar {
      margin-top: 1.25rem;
      align-items: flex-end;
    }

    .media-search,
    .media-filter {
      display: grid;
      gap: 0.4rem;
      color: var(--color-text);
      font-weight: 700;
    }

    .media-search {
      flex: 1;
    }

    .media-search input,
    .media-filter select {
      width: 100%;
      min-height: 2.85rem;
      padding: 0.7rem 0.8rem;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-md);
      background: var(--color-surface-soft);
      color: var(--color-text);
    }

    .media-count,
    .media-library-status {
      color: var(--color-text-muted);
    }

    .media-library-status {
      display: block;
      min-height: 1.5rem;
      margin-top: 1rem;
      font-weight: 700;
    }

    .media-library-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }

    .media-card {
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
      box-shadow: var(--shadow-card);
    }

    .media-card img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      background: var(--color-surface-soft);
    }

    .media-card__body {
      display: grid;
      gap: 0.65rem;
      padding: 1rem;
    }

    .media-card__body > span,
    .media-card__body > code {
      color: var(--color-text-muted);
      font-size: 0.82rem;
    }

    .media-card__body > code {
      overflow-wrap: anywhere;
    }

    .media-card__safety {
      width: fit-content;
      padding: 0.35rem 0.55rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: var(--color-surface-soft);
      font-weight: 800;
    }

    .media-card__safety[data-state="used"] {
      color: var(--color-accent-strong);
    }

    .media-card__safety[data-state="orphan"],
    .media-card__safety[data-state="review"] {
      color: var(--color-text);
    }

    .media-card__actions {
      justify-content: flex-start;
      flex-wrap: wrap;
      margin-top: 0.25rem;
    }

    .media-safety-summary {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .media-safety-summary[hidden] {
      display: none;
    }

    .media-safety-summary > span {
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-surface-soft);
    }

    .media-safety-summary strong,
    .media-safety-summary small {
      display: block;
    }

    .media-safety-summary strong {
      color: var(--color-accent-strong);
      font: 800 1.7rem/1 var(--font-heading);
    }

    .media-safety-summary small {
      margin-top: 0.45rem;
      color: var(--color-text-muted);
    }

    .media-empty {
      grid-column: 1 / -1;
      margin: 0;
      padding: 1.25rem;
      border: 1px dashed var(--color-border-strong);
      border-radius: var(--radius-lg);
      color: var(--color-text-muted);
      background: var(--color-surface-soft);
    }

    @media (max-width: 56rem) {
      .media-library-grid,
      .media-safety-summary {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 38rem) {
      .media-toolbar__heading,
      .media-toolbar {
        align-items: stretch;
        flex-direction: column;
      }

      .media-library-grid,
      .media-safety-summary {
        grid-template-columns: 1fr;
      }
    }
  </style>
</AdminLayout>
