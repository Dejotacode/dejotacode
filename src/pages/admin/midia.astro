---
import fs from "node:fs";
import path from "node:path";
import StudioLayout from "../../layouts/StudioLayout.astro";
import "../../styles/studio-media.css";

const root = process.cwd();
const assetsRoot = path.join(root, "public/assets");
const extensions = new Set([".png", ".jpg", ".jpeg", ".webp", ".svg", ".avif"]);

const walk = (dir: string): string[] => fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {
  const full = path.join(dir, entry.name);
  return entry.isDirectory() ? walk(full) : [full];
});

const sourceFiles = walk(path.join(root, "src")).filter((file) => /\.(astro|ts|js|md|css)$/.test(file));
const sourceText = sourceFiles.map((file) => ({
  file,
  relative: path.relative(root, file),
  text: fs.readFileSync(file, "utf8"),
}));

const visualMaps = ["src/data/editorialVisuals.ts", "src/data/storeVisuals.ts"]
  .map((relative) => ({ relative, text: fs.existsSync(path.join(root, relative)) ? fs.readFileSync(path.join(root, relative), "utf8") : "" }));

const mapConsumers = new Map<string, string[]>();
for (const source of visualMaps) {
  const regex = /["']([^"']+)["']\s*:\s*["'](\/assets\/[^"']+)["']/g;
  for (const match of source.text.matchAll(regex)) {
    const [, key, asset] = match;
    const label = source.relative.includes("storeVisuals") ? `Produto: ${key}` : `Conteúdo: ${key}`;
    mapConsumers.set(asset, [...(mapConsumers.get(asset) ?? []), label]);
  }
}

const assets = walk(assetsRoot)
  .filter((file) => extensions.has(path.extname(file).toLowerCase()))
  .map((file) => {
    const publicPath = "/" + path.relative(path.join(root, "public"), file).split(path.sep).join("/");
    const stat = fs.statSync(file);
    const textualRefs = sourceText
      .filter((source) => source.text.includes(publicPath))
      .map((source) => source.relative)
      .filter((value, index, list) => list.indexOf(value) === index);
    const consumers = [...new Set([...(mapConsumers.get(publicPath) ?? []), ...textualRefs
      .filter((ref) => ref.startsWith("src/content/posts/"))
      .map((ref) => `Conteúdo: ${path.basename(ref, ".md")}`)])];
    const section = publicPath.startsWith("/assets/posts/") ? "Conteúdo"
      : publicPath.startsWith("/assets/store/") ? "Store"
      : publicPath.startsWith("/assets/brand/") ? "Marca"
      : publicPath.startsWith("/assets/resources/") ? "Recursos"
      : publicPath.startsWith("/assets/trails/") ? "Trilhas"
      : "Outros";
    return {
      path: publicPath,
      name: path.basename(file),
      section,
      size: stat.size,
      modified: stat.mtime.toISOString(),
      refs: textualRefs,
      consumers,
      used: textualRefs.length > 0,
      extension: path.extname(file).slice(1).toUpperCase(),
    };
  })
  .sort((a, b) => b.modified.localeCompare(a.modified));

const usedCount = assets.filter((asset) => asset.used).length;
const reviewCount = assets.length - usedCount;
const sections = [...new Set(assets.map((asset) => asset.section))].sort();
---

<StudioLayout title="Mídia" description="Biblioteca visual real da DejotaCode.">
  <section class="studio-main studio-media-page">
    <header class="studio-page-header studio-page-header--split">
      <div>
        <p class="studio-eyebrow">Biblioteca</p>
        <h1>Mídia</h1>
        <p>Encontre as imagens reais do projeto, veja onde são usadas e evite apagar arquivos ainda referenciados.</p>
      </div>
      <div class="studio-media-summary" aria-label="Resumo da biblioteca">
        <div><strong>{assets.length}</strong><span>arquivos</span></div>
        <div><strong>{usedCount}</strong><span>referenciados</span></div>
        <div><strong>{reviewCount}</strong><span>para auditar</span></div>
      </div>
    </header>

    <section class="studio-media-toolbar" aria-label="Filtros da biblioteca">
      <label class="studio-field studio-field--search">
        <span>Buscar</span>
        <input type="search" placeholder="Nome, caminho ou conteúdo…" data-media-search aria-label="Buscar mídia" />
      </label>
      <label class="studio-field">
        <span>Área</span>
        <select data-media-section aria-label="Filtrar mídia por área">
          <option value="all">Todas</option>
          {sections.map((section) => <option value={section}>{section}</option>)}
        </select>
      </label>
      <label class="studio-field">
        <span>Uso</span>
        <select data-media-usage aria-label="Filtrar mídia por uso">
          <option value="all">Todos</option>
          <option value="used">Em uso</option>
          <option value="review">Uso não confirmado</option>
        </select>
      </label>
    </section>

    <div class="studio-media-result-line"><span data-media-count>{assets.length} arquivos</span><small>Fonte: <code>public/assets</code></small></div>

    <section class="studio-media-grid" data-media-grid aria-label="Biblioteca de imagens"></section>

    <dialog class="studio-media-dialog" data-media-dialog aria-labelledby="studio-media-title">
      <button class="studio-icon-button studio-media-dialog__close" type="button" data-media-close aria-label="Fechar detalhes">×</button>
      <div data-media-dialog-content></div>
    </dialog>

    <script id="studio-media-data" type="application/json" set:html={JSON.stringify(assets).replaceAll("<", "\\u003c").replaceAll(">", "\\u003e")}></script>
  </section>
  <script src="../../scripts/studio-media.ts"></script>
</StudioLayout>
