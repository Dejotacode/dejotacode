---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin-metrics.css";
import "../../styles/admin-editor.css";
import "../../styles/article.css";

const api = import.meta.env.PUBLIC_API_URL?.trim() || "http://localhost:8787";
const posts = await getCollection("posts");
const editablePosts = posts
  .map((post) => ({
    slug: post.id.replace(/\.md$/, ""),
    title: post.data.title,
    description: post.data.description,
    publishedAt: post.data.publishedAt.toISOString().slice(0, 10),
    category: post.data.category,
    type: post.data.type,
    readingTime: post.data.readingTime,
    difficulty: post.data.difficulty,
    featured: post.data.featured,
    draft: post.data.draft,
    tags: post.data.tags,
    body: post.body ?? "",
  }))
  .sort((a, b) => a.title.localeCompare(b.title, "pt-BR"));
---
<AdminLayout title="Editor de conteúdo" description="Editor assistido e preview de conteúdos do DejotaCode.">
  <main id="conteudo" class="admin-page" data-api={api}>
    <div class="admin-panel admin-editor-shell">
      <div class="admin-editor-heading">
        <div>
          <p class="admin-kicker">Fluxo editorial Git/Markdown</p>
          <h1>Editor de conteúdo</h1>
          <p class="admin-intro">
            Crie ou revise artigos com preview, validação de campos e geração de Markdown sem publicar direto em produção.
          </p>
        </div>
        <div class="admin-actions">
          <a class="button" href="/admin/">Painel</a>
          <a class="button" href="/admin/metricas/">Métricas</a>
          <button class="button" type="button" data-logout>Sair</button>
        </div>
      </div>

      <section class="editor-toolbar" aria-label="Selecionar conteúdo">
        <label for="post-select">Conteúdo existente</label>
        <select id="post-select" data-post-select>
          <option value="">Novo conteúdo</option>          {editablePosts.map((post) => <option value={post.slug}>{post.title}</option>)}
        </select>
        <button class="button" type="button" data-new-content>Novo</button>
      </section>

      <div class="editor-layout">
        <form class="editor-form" data-editor-form novalidate>
          <div class="editor-fields editor-fields--two">
            <label>
              Título
              <input name="title" required maxlength="90" autocomplete="off" />
              <small data-count="title">0/90</small>
            </label>
            <label>
              Slug
              <input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" autocomplete="off" />
              <small>minúsculas, números e hífens</small>
            </label>
          </div>

          <label>
            Descrição
            <textarea name="description" rows="3" required maxlength="180"></textarea>
            <small data-count="description">0/180</small>
          </label>
          <div class="editor-fields editor-fields--three">
            <label>
              Categoria
              <select name="category" required>
                <option value="programacao">Programação</option>
                <option value="linux-seguranca">Linux & Segurança</option>
                <option value="inteligencia-artificial">Inteligência Artificial</option>
                <option value="tecnologia-pratica">Tecnologia prática</option>
              </select>
            </label>
            <label>
              Tipo
              <select name="type" required>
                <option value="artigo">Artigo</option>
                <option value="tutorial">Tutorial</option>
              </select>
            </label>
            <label>
              Dificuldade
              <select name="difficulty" required>
                <option value="iniciante">Iniciante</option>
                <option value="intermediario">Intermediário</option>
                <option value="avancado">Avançado</option>
              </select>
            </label>
          </div>
          <div class="editor-fields editor-fields--three">
            <label>
              Data de publicação
              <input name="publishedAt" type="date" required />
            </label>
            <label>
              Tempo de leitura (min)
              <input name="readingTime" type="number" min="1" max="120" value="5" required />
            </label>
            <label>
              Tags
              <input name="tags" placeholder="linux, terminal, iniciantes" autocomplete="off" />
            </label>
          </div>

          <div class="editor-checks">
            <label><input name="featured" type="checkbox" /> Destaque</label>
            <label><input name="draft" type="checkbox" /> Rascunho</label>
          </div>

          <section class="editor-media-panel" aria-labelledby="editor-media-title">
            <div>
              <strong id="editor-media-title">Imagem no conteúdo</strong>
              <p>Envie uma imagem ao R2 e insira o Markdown na posição atual do cursor.</p>
            </div>
            <div class="editor-media-fields">
              <label>
                Arquivo
                <input data-media-file type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
              </label>
              <label>
                Texto alternativo
                <input data-media-alt type="text" maxlength="220" placeholder="Descreva o que a imagem mostra" />
              </label>
            </div>
            <div class="editor-media-actions">
              <button class="button" type="button" data-upload-image>Enviar e inserir imagem</button>
              <output data-media-status aria-live="polite">JPG, PNG, WebP ou AVIF · até 10 MB.</output>
            </div>
            <details class="editor-media-library" open>
              <summary class="editor-media-library__summary">
                <span>
                  <strong>Biblioteca de imagens</strong>
                  <small>Reutilize imagens já enviadas ao R2 sem duplicar arquivos.</small>
                </span>
                <span aria-hidden="true">Mostrar / ocultar</span>
              </summary>
              <div class="editor-media-library__content">
                <div class="editor-media-library__toolbar">
                  <label>
                    Buscar
                    <input data-media-search type="search" placeholder="Alt ou caminho da imagem" autocomplete="off" />
                  </label>
                  <label>
                    Contexto
                    <select data-media-context>
                      <option value="all">Todas</option>
                      <option value="current">Enviadas para este post</option>
                      <option value="general">Biblioteca geral</option>
                    </select>
                  </label>
                  <label>
                    Uso
                    <select data-media-usage>
                      <option value="all">Todas</option>
                      <option value="used">Em uso</option>
                      <option value="unused">Não referenciadas</option>
                    </select>
                  </label>
                  <label>
                    Segurança
                    <select data-media-safety-filter>
                      <option value="all">Todas</option>
                      <option value="used">Em uso</option>
                      <option value="orphan">Possivelmente órfã</option>
                      <option value="review">Requer revisão</option>
                    </select>
                  </label>
                  <button class="button" type="button" data-refresh-media>Atualizar biblioteca</button>
                </div>
                <div class="editor-media-safety">
                  <div>
                    <strong>Relatório de segurança de mídia</strong>
                    <p>Cruza Markdown canônico, capas do CMS, metadados D1 e disponibilidade pública no R2. Nenhuma exclusão é executada.</p>
                  </div>
                  <button class="button" type="button" data-media-safety-run>Gerar relatório</button>
                  <output data-media-safety-status aria-live="polite">Relatório ainda não gerado.</output>
                  <div class="editor-media-safety__summary" data-media-safety-summary hidden></div>
                </div>
                <div class="editor-media-cleanup">
                  <div>
                    <strong>Gate de limpeza</strong>
                    <p>Segunda revisão para mídias já marcadas como candidatas. Gera plano; não executa exclusão.</p>
                  </div>
                  <button class="button" type="button" data-media-cleanup-plan>Gerar plano de remoção</button>
                  <output data-media-cleanup-status aria-live="polite">Nenhum plano gerado.</output>
                  <pre data-media-cleanup-plan-output hidden></pre>
                  <section class="editor-media-risk" data-media-risk hidden aria-live="polite">
                    <div class="editor-media-risk__header">
                      <div>
                        <strong>Zona de risco</strong>
                        <p>Exclusão individual somente após duas revisões, dry-run válido e nova revalidação no servidor.</p>
                      </div>
                      <span>Admin · ação irreversível</span>
                    </div>
                    <label>
                      Mídia aprovada
                      <select data-media-risk-select></select>
                    </label>
                    <div class="editor-media-risk__checks" data-media-risk-checks></div>
                    <div class="editor-media-risk__actions">
                      <button class="button" type="button" data-media-risk-dry-run>Executar dry-run</button>
                      <button class="button editor-media-risk__delete" type="button" data-media-risk-delete hidden>Excluir definitivamente</button>
                    </div>
                    <output data-media-risk-status>Execute o dry-run para liberar a confirmação final.</output>
                  </section>
                </div>
                <output data-media-library-status aria-live="polite">Carregando imagens…</output>
                <div class="editor-media-grid" data-media-grid></div>
              </div>
            </details>
          </section>

          <label>
            Conteúdo Markdown
            <textarea class="editor-markdown" name="body" rows="22" required spellcheck="true"></textarea>
            <small>Use títulos ##, listas, links, imagens, blocos ```bash e demais Markdown editorial.</small>
          </label>
          <div class="editor-actions">
            <button class="button button-primary" type="button" data-generate>Gerar Markdown</button>
            <button class="button" type="button" data-copy-markdown>Copiar Markdown</button>
            <button class="button" type="button" data-download>Baixar .md</button>
            <button class="button" type="button" data-create-pr disabled>Criar Pull Request</button>
          </div>
          <output class="editor-status" data-status aria-live="polite"></output>
          <p class="editor-github-state" data-github-state>GitHub: verificando integração…</p>
          <a class="editor-pr-link" data-pr-link href="#" target="_blank" rel="noopener noreferrer" hidden>Abrir Pull Request →</a>
          <section class="editor-publish-panel" data-publish-panel hidden aria-live="polite">
            <div>
              <strong data-publish-title>Publicação assistida</strong>
              <p data-publish-state>Aguardando Pull Request.</p>
            </div>
            <div class="editor-publish-actions">
              <a class="button" data-workflow-link href="#" target="_blank" rel="noopener noreferrer" hidden>Ver CI</a>
              <button class="button" type="button" data-refresh-pr>Atualizar status</button>
              <button class="button button-primary" type="button" data-merge-pr disabled>Mesclar e publicar</button>
            </div>
          </section>
        </form>

        <aside class="editor-preview" aria-label="Preview do conteúdo">
          <div class="editor-preview__bar">
            <span>PREVIEW</span>
            <span data-preview-state>Rascunho local</span>
          </div>
          <article>
            <p class="eyebrow" data-preview-eyebrow>Tecnologia prática · artigo</p>
            <h2 data-preview-title>Título do conteúdo</h2>
            <p class="editor-preview__description" data-preview-description>
              A descrição aparecerá aqui conforme você preencher o formulário.
            </p>
            <div class="editor-preview__body article-content" data-preview-body>
              <p>Escreva no campo Markdown para visualizar a estrutura do artigo.</p>
            </div>
          </article>
        </aside>
      </div>
    </div>
  </main>
  <script is:inline id="editor-posts" type="application/json" set:html={JSON.stringify(editablePosts).replaceAll("<", "\\u003c").replaceAll(">", "\\u003e")} />

  <script>
    type MediaItem = {
      id: number;
      objectKey: string;
      contentType: string;
      sizeBytes: number;
      altText: string;
      createdAt: string;
      reviewStatus?: "pending" | "keep" | "candidate";
      reviewNote?: string | null;
      reviewedAt?: string | null;
      reviewedBy?: number | null;
      cleanupStatus?: "pending" | "approved";
      cleanupNote?: string | null;
      cleanupApprovedAt?: string | null;
      cleanupApprovedBy?: number | null;
      deleteCheckExpiresAt?: string | null;
      deleteCheckedAt?: string | null;
    };

    type EditablePost = {
      slug: string;
      title: string;
      description: string;
      publishedAt: string;
      category: string;
      type: string;
      readingTime: number;
      difficulty: string;
      featured: boolean;
      draft: boolean;
      tags: string[];
      body: string;
    };

    const root = document.querySelector<HTMLElement>("[data-api]");
    const api = root?.dataset.api;
    const form = document.querySelector<HTMLFormElement>("[data-editor-form]");
    const select = document.querySelector<HTMLSelectElement>("[data-post-select]");
    const status = document.querySelector<HTMLOutputElement>("[data-status]");
    const createPrButton = document.querySelector<HTMLButtonElement>("[data-create-pr]");
    const githubState = document.querySelector<HTMLElement>("[data-github-state]");
    const prLink = document.querySelector<HTMLAnchorElement>("[data-pr-link]");
    const publishPanel = document.querySelector<HTMLElement>("[data-publish-panel]");
    const publishTitle = document.querySelector<HTMLElement>("[data-publish-title]");
    const publishState = document.querySelector<HTMLElement>("[data-publish-state]");
    const workflowLink = document.querySelector<HTMLAnchorElement>("[data-workflow-link]");
    const refreshPrButton = document.querySelector<HTMLButtonElement>("[data-refresh-pr]");
    const mergePrButton = document.querySelector<HTMLButtonElement>("[data-merge-pr]");
    const mediaFile = document.querySelector<HTMLInputElement>("[data-media-file]");
    const mediaAlt = document.querySelector<HTMLInputElement>("[data-media-alt]");
    const uploadImageButton = document.querySelector<HTMLButtonElement>("[data-upload-image]");
    const mediaStatus = document.querySelector<HTMLOutputElement>("[data-media-status]");
    const mediaGrid = document.querySelector<HTMLElement>("[data-media-grid]");
    const mediaLibraryStatus = document.querySelector<HTMLOutputElement>("[data-media-library-status]");
    const refreshMediaButton = document.querySelector<HTMLButtonElement>("[data-refresh-media]");
    const mediaSearch = document.querySelector<HTMLInputElement>("[data-media-search]");
    const mediaContext = document.querySelector<HTMLSelectElement>("[data-media-context]");
    const mediaUsage = document.querySelector<HTMLSelectElement>("[data-media-usage]");
    const mediaSafetyFilter = document.querySelector<HTMLSelectElement>("[data-media-safety-filter]");
    const mediaSafetyButton = document.querySelector<HTMLButtonElement>("[data-media-safety-run]");
    const mediaSafetyStatus = document.querySelector<HTMLOutputElement>("[data-media-safety-status]");
    const mediaSafetySummary = document.querySelector<HTMLElement>("[data-media-safety-summary]");
    const mediaCleanupPlanButton = document.querySelector<HTMLButtonElement>("[data-media-cleanup-plan]");
    const mediaCleanupStatus = document.querySelector<HTMLOutputElement>("[data-media-cleanup-status]");
    const mediaCleanupPlanOutput = document.querySelector<HTMLElement>("[data-media-cleanup-plan-output]");
    const mediaRisk = document.querySelector<HTMLElement>("[data-media-risk]");
    const mediaRiskSelect = document.querySelector<HTMLSelectElement>("[data-media-risk-select]");
    const mediaRiskChecks = document.querySelector<HTMLElement>("[data-media-risk-checks]");
    const mediaRiskDryRunButton = document.querySelector<HTMLButtonElement>("[data-media-risk-dry-run]");
    const mediaRiskDeleteButton = document.querySelector<HTMLButtonElement>("[data-media-risk-delete]");
    const mediaRiskStatus = document.querySelector<HTMLOutputElement>("[data-media-risk-status]");
    const postsNode = document.querySelector<HTMLScriptElement>("#editor-posts");
    const posts: EditablePost[] = postsNode?.textContent ? JSON.parse(postsNode.textContent) : [];
    let csrf = "";
    let generatedMarkdown = "";
    let mediaItems: MediaItem[] = [];
    let mediaSafetyStates = new Map<string, "used" | "orphan" | "review">();
    let mediaDeleteChecks = new Map<number, { token: string; expiresAt: string; coverUsage: number; markdownReferences: string[]; r2Exists: boolean }>();
    let currentPrNumber = Number(sessionStorage.getItem("dejotacode-editor-pr") || 0) || 0;
    let currentPrHeadSha = "";
    let ciPollTimer: number | undefined;
    let ciPollStartedAt = 0;
    const ciPollIntervalMs = 5_000;
    const ciPollMaxDurationMs = 3 * 60_000;
    const field = (name: string) => form?.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
    const checked = (name: string) => Boolean((form?.elements.namedItem(name) as HTMLInputElement | null)?.checked);
    const value = (name: string) => field(name)?.value.trim() ?? "";

    const escapeHtml = (input: string) => input
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

    const inlineMarkdown = (input: string) => escapeHtml(input)
      .replace(/`([^`]+)`/g, "<code>$1</code>")
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/\*([^*]+)\*/g, "<em>$1</em>")
      .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]+)\)/g, '<a href="$2">$1</a>');

    const renderMarkdown = (source: string) => {
      const lines = source.replace(/\r\n?/g, "\n").split("\n");
      const output: string[] = [];
      let inCode = false;
      let language = "";
      let code: string[] = [];
      let list: "ul" | "ol" | "" = "";

      const closeList = () => {
        if (!list) return;
        output.push(`</${list}>`);
        list = "";
      };
      for (const line of lines) {
        const fence = line.match(/^```([\w-]*)\s*$/);
        if (fence) {
          closeList();
          if (!inCode) {
            inCode = true;
            language = fence[1] ?? "";
            code = [];
          } else {
            output.push(`<pre data-language="${escapeHtml(language)}"><code>${escapeHtml(code.join("\n"))}</code></pre>`);
            inCode = false;
            language = "";
            code = [];
          }
          continue;
        }

        if (inCode) {
          code.push(line);
          continue;
        }

        if (!line.trim()) {
          closeList();
          continue;
        }

        const image = line.match(/^!\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]+)\)$/);
        if (image) {
          closeList();
          output.push(`<figure class="editor-preview-image"><img src="${escapeHtml(image[2])}" alt="${escapeHtml(image[1])}" loading="lazy" decoding="async"></figure>`);
          continue;
        }

        const heading = line.match(/^(#{2,4})\s+(.+)$/);
        if (heading) {
          closeList();
          const level = heading[1].length;
          output.push(`<h${level}>${inlineMarkdown(heading[2])}</h${level}>`);
          continue;
        }
        const unordered = line.match(/^[-*]\s+(.+)$/);
        if (unordered) {
          if (list !== "ul") {
            closeList();
            list = "ul";
            output.push("<ul>");
          }
          output.push(`<li>${inlineMarkdown(unordered[1])}</li>`);
          continue;
        }

        const ordered = line.match(/^\d+\.\s+(.+)$/);
        if (ordered) {
          if (list !== "ol") {
            closeList();
            list = "ol";
            output.push("<ol>");
          }
          output.push(`<li>${inlineMarkdown(ordered[1])}</li>`);
          continue;
        }

        const quote = line.match(/^>\s?(.+)$/);
        if (quote) {
          closeList();
          output.push(`<blockquote>${inlineMarkdown(quote[1])}</blockquote>`);
          continue;
        }

        closeList();
        output.push(`<p>${inlineMarkdown(line)}</p>`);
      }

      closeList();
      if (inCode) output.push(`<pre><code>${escapeHtml(code.join("\n"))}</code></pre>`);
      return output.join("");
    };
    const slugify = (input: string) => input
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

    const categoryLabels: Record<string, string> = {
      programacao: "Programação",
      "linux-seguranca": "Linux & Segurança",
      "inteligencia-artificial": "Inteligência Artificial",
      "tecnologia-pratica": "Tecnologia prática",
    };

    const updatePreview = () => {
      const title = value("title") || "Título do conteúdo";
      const description = value("description") || "A descrição aparecerá aqui conforme você preencher o formulário.";
      const category = categoryLabels[value("category")] ?? "Tecnologia prática";
      const type = value("type") || "artigo";
      const body = value("body");

      document.querySelector<HTMLElement>("[data-preview-title]")!.textContent = title;
      document.querySelector<HTMLElement>("[data-preview-description]")!.textContent = description;
      document.querySelector<HTMLElement>("[data-preview-eyebrow]")!.textContent = `${category} · ${type}`;
      const previewBody = document.querySelector<HTMLElement>("[data-preview-body]");
      if (previewBody) previewBody.innerHTML = body ? renderMarkdown(body) : "<p>Escreva no campo Markdown para visualizar a estrutura do artigo.</p>";
      const state = document.querySelector<HTMLElement>("[data-preview-state]");
      if (state) state.textContent = checked("draft") ? "Rascunho" : "Pronto para revisão";
    };
    const yamlString = (input: string) => JSON.stringify(input);

    const buildMarkdown = () => {
      if (!form?.reportValidity()) {
        if (status) status.textContent = "Revise os campos obrigatórios antes de gerar o arquivo.";
        return "";
      }

      const tags = value("tags")
        .split(",")
        .map((tag) => tag.trim())
        .filter(Boolean);

      const lines = [
        "---",
        `title: ${yamlString(value("title"))}`,
        `description: ${yamlString(value("description"))}`,
        `publishedAt: ${value("publishedAt")}`,
        `category: ${value("category")}`,
        `type: ${value("type")}`,
        `readingTime: ${Number(value("readingTime")) || 1}`,
        `difficulty: ${value("difficulty")}`,
        `featured: ${checked("featured")}`,
        `draft: ${checked("draft")}`,
        `tags: [${tags.map((tag) => yamlString(tag)).join(", ")}]`,
        "---",
        "",
        value("body"),
        "",
      ];

      generatedMarkdown = lines.join("\n");
      if (status) status.textContent = `Markdown válido preparado para src/content/posts/${value("slug")}.md`;
      return generatedMarkdown;
    };
    const fillPost = (post: EditablePost) => {
      if (!form) return;
      field("title")!.value = post.title;
      field("slug")!.value = post.slug;
      field("description")!.value = post.description;
      field("publishedAt")!.value = post.publishedAt;
      field("category")!.value = post.category;
      field("type")!.value = post.type;
      field("readingTime")!.value = String(post.readingTime);
      field("difficulty")!.value = post.difficulty;
      field("tags")!.value = post.tags.join(", ");
      field("body")!.value = post.body;
      (field("featured") as HTMLInputElement).checked = post.featured;
      (field("draft") as HTMLInputElement).checked = post.draft;
      generatedMarkdown = "";
      updateCounters();
      updatePreview();
      renderMediaLibrary();
      if (status) status.textContent = `Editando ${post.slug}.md localmente; nada foi publicado.`;
    };

    const resetForm = () => {
      form?.reset();
      if (field("publishedAt")) field("publishedAt")!.value = new Date().toISOString().slice(0, 10);
      if (field("readingTime")) field("readingTime")!.value = "5";
      if (field("category")) field("category")!.value = "tecnologia-pratica";
      if (field("type")) field("type")!.value = "artigo";
      if (field("difficulty")) field("difficulty")!.value = "iniciante";
      generatedMarkdown = "";
      if (select) select.value = "";
      updateCounters();
      updatePreview();
      renderMediaLibrary();
      if (status) status.textContent = "Novo conteúdo iniciado. Nenhuma alteração foi publicada.";
    };
    const updateCounters = () => {
      const title = value("title");
      const description = value("description");
      const titleCount = document.querySelector<HTMLElement>('[data-count="title"]');
      const descriptionCount = document.querySelector<HTMLElement>('[data-count="description"]');
      if (titleCount) titleCount.textContent = `${title.length}/90`;
      if (descriptionCount) descriptionCount.textContent = `${description.length}/180`;
    };

    const copyGenerated = async () => {
      const markdown = generatedMarkdown || buildMarkdown();
      if (!markdown) return;
      try {
        await navigator.clipboard.writeText(markdown);
        if (status) status.textContent = "Markdown copiado para a área de transferência.";
      } catch {
        if (status) status.textContent = "O navegador bloqueou a cópia automática. Use Baixar .md.";
      }
    };

    const downloadGenerated = () => {
      const markdown = generatedMarkdown || buildMarkdown();
      if (!markdown) return;
      const blob = new Blob([markdown], { type: "text/markdown;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `${value("slug")}.md`;
      link.click();
      URL.revokeObjectURL(url);
      if (status) status.textContent = `${value("slug")}.md preparado para revisão local.`;
    };
    const insertAtCursor = (textarea: HTMLTextAreaElement, text: string) => {
      const start = textarea.selectionStart ?? textarea.value.length;
      const end = textarea.selectionEnd ?? start;
      const before = textarea.value.slice(0, start);
      const after = textarea.value.slice(end);
      const prefix = before && !before.endsWith("\n") ? "\n\n" : "";
      const suffix = after && !after.startsWith("\n") ? "\n\n" : "";
      const insertion = `${prefix}${text}${suffix}`;
      textarea.value = `${before}${insertion}${after}`;
      const cursor = before.length + insertion.length;
      textarea.setSelectionRange(cursor, cursor);
      textarea.focus();
    };

    const mediaPublicUrl = (objectKey: string) => api
      ? new URL(`/api/media/public/${objectKey}`, `${api}/`).toString()
      : "";

    const sanitizeMarkdownAlt = (alt: string) => alt
      .replace(/[\[\]]/g, "")
      .replace(/\s+/g, " ")
      .trim();

    const formatBytes = (bytes: number) => {
      if (!Number.isFinite(bytes) || bytes < 0) return "—";
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    };

    const formatMediaDate = (input: string) => {
      const normalized = input.includes("T") ? input : `${input.replace(" ", "T")}Z`;
      const date = new Date(normalized);
      return Number.isNaN(date.getTime())
        ? input
        : new Intl.DateTimeFormat("pt-BR", { dateStyle: "short", timeStyle: "short" }).format(date);
    };

    const insertMediaItem = (item: MediaItem) => {
      const body = field("body");
      if (!(body instanceof HTMLTextAreaElement)) return;
      const alt = sanitizeMarkdownAlt(item.altText || "Imagem editorial");
      if (alt.length < 3) {
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Esta imagem não possui texto alternativo válido para reutilização.";
        return;
      }
      insertAtCursor(body, `![${alt}](${mediaPublicUrl(item.objectKey)})`);
      generatedMarkdown = "";
      updatePreview();
      if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Imagem existente inserida no Markdown.";
    };

    const normalizedSearch = (input: string) => input
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();

    const mediaKeysFromMarkdown = (markdown: string) => {
      const keys = new Set<string>();
      const pattern = /https:\/\/api\.dejotacode\.com\.br\/api\/media\/public\/([^\s)]+)/g;
      for (const match of markdown.matchAll(pattern)) {
        if (match[1]) keys.add(match[1]);
      }
      return keys;
    };

    const canonicalMediaKeys = new Set(posts.flatMap((post) => [...mediaKeysFromMarkdown(post.body)]));

    const currentPostMediaKeys = () => mediaKeysFromMarkdown(value("body"));

    const renderMediaSafetySummary = (counts: { used: number; orphan: number; review: number; checked: number }) => {
      if (!mediaSafetySummary) return;
      mediaSafetySummary.replaceChildren();
      const items = [
        ["Em uso", counts.used],
        ["Possivelmente órfãs", counts.orphan],
        ["Requer revisão", counts.review],
        ["R2 verificado", counts.checked],
      ];
      for (const [label, value] of items) {
        const card = document.createElement("span");
        const strong = document.createElement("strong");
        const text = document.createElement("small");
        strong.textContent = String(value);
        text.textContent = String(label);
        card.append(strong, text);
        mediaSafetySummary.append(card);
      }
      mediaSafetySummary.hidden = false;
    };

    const runMediaSafetyReport = async () => {
      if (!api || !mediaSafetyButton || !mediaSafetyStatus) return;
      mediaSafetyButton.disabled = true;
      mediaSafetyStatus.textContent = "Cruzando referências e verificando objetos no R2…";
      try {
        if (!mediaItems.length) await loadMediaLibrary();
        const cmsResponse = await fetch(`${api}/api/cms/posts`, { credentials: "include" });
        const cmsPayload = await cmsResponse.json();
        if (!cmsResponse.ok) throw new Error(cmsPayload.error?.message ?? "Não foi possível consultar as capas do CMS.");
        const cmsPosts = Array.isArray(cmsPayload.data?.items) ? cmsPayload.data.items : [];
        const coverKeys = new Set(cmsPosts.map((post: { coverKey?: string | null }) => post.coverKey).filter(Boolean));
        const states = new Map<string, "used" | "orphan" | "review">();
        let checked = 0;
        for (const item of mediaItems) {
          if (!item.contentType.startsWith("image/")) continue;
          const used = canonicalMediaKeys.has(item.objectKey) || coverKeys.has(item.objectKey);
          let reachable = false;
          try {
            const response = await fetch(mediaPublicUrl(item.objectKey), { method: "HEAD", credentials: "omit" });
            reachable = response.ok;
            checked += 1;
          } catch {
            reachable = false;
          }
          const state = used
            ? "used"
            : reachable && item.objectKey.startsWith("posts/")
              ? "orphan"
              : "review";
          states.set(item.objectKey, state);
        }
        mediaSafetyStates = states;
        const counts = { used: 0, orphan: 0, review: 0, checked };
        for (const state of states.values()) counts[state] += 1;
        renderMediaSafetySummary(counts);
        renderMediaLibrary();
        mediaSafetyStatus.textContent = `Relatório concluído para ${states.size} imagem(ns). “Possivelmente órfã” exige revisão humana antes de qualquer ação.`;
      } catch (error) {
        mediaSafetyStatus.textContent = error instanceof Error ? error.message : "Não foi possível gerar o relatório de segurança.";
      } finally {
        mediaSafetyButton.disabled = false;
      }
    };

    const filteredMediaItems = () => {
      const query = normalizedSearch(mediaSearch?.value ?? "");
      const context = mediaContext?.value ?? "all";
      const usage = mediaUsage?.value ?? "all";
      const safetyFilter = mediaSafetyFilter?.value ?? "all";
      const currentSlug = value("slug");
      return mediaItems.filter((item) => {
        if (!item.contentType.startsWith("image/")) return false;
        const isPostImage = item.objectKey.startsWith("posts/");
        const isCurrentPost = Boolean(currentSlug) && item.objectKey.startsWith(`posts/${currentSlug}/`);
        if (context === "current" && !isCurrentPost) return false;
        if (context === "general" && isPostImage) return false;
        const isUsed = canonicalMediaKeys.has(item.objectKey);
        if (usage === "used" && !isUsed) return false;
        if (usage === "unused" && isUsed) return false;
        const safetyState = mediaSafetyStates.get(item.objectKey);
        if (safetyFilter !== "all" && safetyState !== safetyFilter) return false;
        if (!query) return true;
        return normalizedSearch(`${item.altText} ${item.objectKey}`).includes(query);
      });
    };

    const updateMediaReview = async (item: MediaItem, reviewStatus: "pending" | "keep" | "candidate") => {
      if (!api) return;
      let note = item.reviewNote ?? "";
      if (reviewStatus !== "pending") {
        const entered = window.prompt(
          reviewStatus === "keep"
            ? "Nota da revisão (opcional): por que esta mídia deve ser mantida?"
            : "Nota da revisão (opcional): por que esta mídia é candidata à limpeza?",
          note
        );
        if (entered === null) return;
        note = entered.trim();
      } else {
        note = "";
      }
      if (reviewStatus === "candidate" && !window.confirm("Marcar esta mídia como candidata à limpeza? Isso NÃO exclui o arquivo.")) return;
      if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Registrando revisão humana…";
      try {
        const response = await fetch(`${api}/api/media/cms/${item.id}/review`, {
          method: "PATCH",
          credentials: "include",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
          body: JSON.stringify({ status: reviewStatus, note }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível registrar a revisão.");
        await loadMediaLibrary();
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = reviewStatus === "pending"
          ? "Revisão reaberta. Nenhum arquivo foi alterado no R2."
          : reviewStatus === "keep"
            ? "Decisão registrada: manter. Nenhum arquivo foi alterado no R2."
            : "Decisão registrada: candidata à limpeza. Nenhum arquivo foi alterado no R2.";
      } catch (error) {
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = error instanceof Error ? error.message : "Não foi possível registrar a revisão.";
      }
    };

    const updateMediaCleanupGate = async (item: MediaItem, cleanupStatus: "pending" | "approved") => {
      if (!api) return;
      if (cleanupStatus === "approved" && item.reviewStatus !== "candidate") {
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Somente mídias marcadas como candidatas podem avançar no gate.";
        return;
      }
      let note = item.cleanupNote ?? "";
      if (cleanupStatus === "approved") {
        const entered = window.prompt("Nota da segunda revisão (obrigatória): confirme por que esta mídia pode entrar no plano de remoção.", note);
        if (entered === null) return;
        note = entered.trim();
        if (note.length < 10) {
          if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Informe uma nota de pelo menos 10 caracteres para a segunda aprovação.";
          return;
        }
        if (!window.confirm("Aprovar esta candidata para o plano de remoção? Isso NÃO exclui o arquivo.")) return;
      } else {
        note = "";
      }
      if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Registrando gate de limpeza…";
      try {
        const response = await fetch(`${api}/api/media/cms/${item.id}/cleanup`, {
          method: "PATCH",
          credentials: "include",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
          body: JSON.stringify({ status: cleanupStatus, note }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível atualizar o gate de limpeza.");
        await loadMediaLibrary();
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = cleanupStatus === "approved"
          ? "Segunda aprovação registrada. Nenhum arquivo foi removido."
          : "Gate reaberto. Nenhum arquivo foi removido.";
      } catch (error) {
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = error instanceof Error ? error.message : "Não foi possível atualizar o gate de limpeza.";
      }
    };

    const generateCleanupPlan = () => {
      if (!mediaCleanupPlanOutput || !mediaCleanupStatus) return;
      const approved = mediaItems.filter((item) => item.reviewStatus === "candidate" && item.cleanupStatus === "approved");
      const generatedAt = new Date().toISOString();
      const lines = [
        "# DejotaCode — Plano de remoção de mídia (somente leitura)",
        "",
        `Gerado em: ${generatedAt}`,
        `Itens aprovados: ${approved.length}`,
        "",
        "Este plano NÃO executa DELETE e não autoriza remoção automática.",
        "",
      ];
      for (const item of approved) {
        lines.push(`- ID ${item.id}: ${item.objectKey}`);
        lines.push(`  Alt: ${item.altText || "—"}`);
        lines.push(`  Revisão: ${item.reviewNote || "—"}`);
        lines.push(`  Segunda aprovação: ${item.cleanupNote || "—"}`);
        lines.push(`  URL: ${mediaPublicUrl(item.objectKey)}`);
      }
      const plan = lines.join("\n");
      mediaCleanupPlanOutput.textContent = plan;
      mediaCleanupPlanOutput.hidden = false;
      mediaCleanupStatus.textContent = approved.length
        ? `Plano gerado com ${approved.length} item(ns) aprovado(s). Nenhuma exclusão foi executada.`
        : "Nenhuma candidata possui segunda aprovação. Plano vazio; nenhuma exclusão foi executada.";
    };

    const approvedCleanupItems = () => mediaItems.filter((item) => item.reviewStatus === "candidate" && item.cleanupStatus === "approved");

    const selectedRiskMedia = () => {
      const approved = approvedCleanupItems();
      if (!approved.length) return null;
      const selectedId = Number(mediaRiskSelect?.value || 0);
      return approved.find((item) => item.id === selectedId) ?? approved[0];
    };

    const renderMediaRiskZone = () => {
      if (!mediaRisk || !mediaRiskSelect || !mediaRiskChecks || !mediaRiskDeleteButton || !mediaRiskStatus) return;
      const approved = approvedCleanupItems();
      if (!approved.length) {
        mediaRisk.hidden = true;
        mediaRiskSelect.replaceChildren();
        mediaRiskChecks.replaceChildren();
        mediaRiskDeleteButton.hidden = true;
        return;
      }
      mediaRisk.hidden = false;
      const previous = Number(mediaRiskSelect.value || 0);
      mediaRiskSelect.replaceChildren();
      for (const item of approved) {
        const option = document.createElement("option");
        option.value = String(item.id);
        option.textContent = `#${item.id} — ${item.altText || item.objectKey}`;
        mediaRiskSelect.append(option);
      }
      const selected = approved.find((item) => item.id === previous) ?? approved[0];
      mediaRiskSelect.value = String(selected.id);
      const check = mediaDeleteChecks.get(selected.id);
      const validCheck = check && new Date(check.expiresAt).getTime() > Date.now() ? check : null;
      if (check && !validCheck) mediaDeleteChecks.delete(selected.id);
      mediaRiskChecks.replaceChildren();
      const rows = [
        ["Revisão humana", "Candidata"],
        ["Gate final", "Aprovado"],
        ["R2", validCheck ? (validCheck.r2Exists ? "Disponível" : "Não encontrado") : "Aguardando dry-run"],
        ["Capas D1", validCheck ? String(validCheck.coverUsage) : "—"],
        ["Referências Markdown", validCheck ? String(validCheck.markdownReferences.length) : "—"],
        ["Validade", validCheck ? formatMediaDate(validCheck.expiresAt) : "Dry-run necessário"],
      ];
      for (const [label, value] of rows) {
        const row = document.createElement("span");
        const strong = document.createElement("strong");
        const small = document.createElement("small");
        strong.textContent = label;
        small.textContent = value;
        row.append(strong, small);
        mediaRiskChecks.append(row);
      }
      mediaRiskDeleteButton.hidden = !validCheck;
      mediaRiskStatus.textContent = validCheck
        ? "Dry-run aprovado e temporário. A exclusão continua exigindo duas confirmações textuais e nova revalidação no servidor."
        : "Execute o dry-run para revalidar GitHub, D1 e R2. Nenhuma exclusão ocorre nesta etapa.";
    };

    const runMediaDeleteDryRun = async (item: MediaItem) => {
      if (!api || item.reviewStatus !== "candidate" || item.cleanupStatus !== "approved") return;
      if (!window.confirm("Executar dry-run de exclusão? O servidor revalidará GitHub, D1 e R2. Nenhum arquivo será removido.")) return;
      if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Executando dry-run seguro…";
      mediaDeleteChecks.delete(item.id);
      try {
        const response = await fetch(`${api}/api/media/cms/${item.id}/delete-dry-run`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
          body: JSON.stringify({ objectKey: item.objectKey }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível executar o dry-run.");
        const data = payload.data ?? {};
        if (!data.eligible) {
          renderMediaLibrary();
          if (mediaLibraryStatus) mediaLibraryStatus.textContent = `Dry-run bloqueado: ${(data.blockers ?? []).join(", ") || "verificação inconclusiva"}. Nenhuma exclusão foi executada.`;
          return;
        }
        const token = String(data.dryRunToken ?? "");
        const expiresAt = String(data.expiresAt ?? "");
        if (!token || !expiresAt) throw new Error("A API não retornou um token de dry-run válido.");
        mediaDeleteChecks.set(item.id, {
          token,
          expiresAt,
          coverUsage: Number(data.coverUsage ?? 0),
          markdownReferences: Array.isArray(data.markdownReferences) ? data.markdownReferences.map(String) : [],
          r2Exists: Boolean(data.r2Exists),
        });
        renderMediaRiskZone();
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Dry-run aprovado. Consulte a Zona de risco; nenhuma exclusão foi executada.";
      } catch (error) {
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = error instanceof Error ? error.message : "Não foi possível executar o dry-run.";
      }
    };

    const deleteMediaItem = async (item: MediaItem) => {
      if (!api) return;
      const check = mediaDeleteChecks.get(item.id);
      if (!check || new Date(check.expiresAt).getTime() <= Date.now()) {
        mediaDeleteChecks.delete(item.id);
        renderMediaRiskZone();
        if (mediaRiskStatus) mediaRiskStatus.textContent = "O dry-run expirou. Execute uma nova verificação antes de excluir.";
        return;
      }
      const objectKey = window.prompt("Confirmação 1/2: digite exatamente o objectKey da mídia que será removida.", "");
      if (objectKey === null) return;
      if (objectKey.trim() !== item.objectKey) {
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = "objectKey incorreto. Exclusão cancelada.";
        return;
      }
      const confirmation = window.prompt('Confirmação 2/2: digite EXCLUIR em letras maiúsculas.', "");
      if (confirmation !== "EXCLUIR") {
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Confirmação final inválida. Exclusão cancelada.";
        return;
      }
      if (!window.confirm("Última confirmação: remover definitivamente esta mídia do R2 e seus metadados do D1?")) return;
      if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Revalidando referências antes da exclusão…";
      try {
        const response = await fetch(`${api}/api/media/cms/${item.id}`, {
          method: "DELETE",
          credentials: "include",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
          body: JSON.stringify({ confirmation: "EXCLUIR", objectKey: item.objectKey, dryRunToken: check.token }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "A exclusão foi bloqueada pelo servidor.");
        mediaDeleteChecks.delete(item.id);
        await loadMediaLibrary();
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Mídia removida após dry-run e revalidação final.";
        renderMediaRiskZone();
      } catch (error) {
        mediaDeleteChecks.delete(item.id);
        renderMediaRiskZone();
        if (mediaRiskStatus) mediaRiskStatus.textContent = error instanceof Error ? error.message : "A exclusão foi bloqueada.";
      }
    };

    const renderMediaLibrary = () => {
      if (!mediaGrid) return;
      mediaGrid.replaceChildren();
      const images = filteredMediaItems();
      if (!images.length) {
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Nenhuma imagem corresponde aos filtros atuais.";
        return;
      }
      for (const item of images) {
        const card = document.createElement("article");
        card.className = "editor-media-card";
        const image = document.createElement("img");
        image.src = mediaPublicUrl(item.objectKey);
        image.alt = item.altText || "Imagem editorial sem texto alternativo";
        image.loading = "lazy";
        image.decoding = "async";
        const info = document.createElement("div");
        info.className = "editor-media-card__info";
        const alt = document.createElement("strong");
        alt.textContent = item.altText || "Sem texto alternativo";
        const meta = document.createElement("span");
        meta.textContent = `${formatBytes(Number(item.sizeBytes))} · ${formatMediaDate(item.createdAt)}`;
        const usage = document.createElement("span");
        usage.className = "editor-media-card__usage";
        const usedCanonically = canonicalMediaKeys.has(item.objectKey);
        const usedInCurrentPost = currentPostMediaKeys().has(item.objectKey);
        usage.textContent = usedInCurrentPost
          ? "Usada neste post"
          : usedCanonically
            ? "Em uso no conteúdo canônico"
            : "Não referenciada no Markdown canônico";
        usage.dataset.state = usedInCurrentPost ? "current" : usedCanonically ? "used" : "unused";
        info.append(alt, meta, usage);
        const safetyState = mediaSafetyStates.get(item.objectKey);
        if (safetyState) {
          const safety = document.createElement("span");
          safety.className = "editor-media-card__safety";
          safety.dataset.state = safetyState;
          safety.textContent = safetyState === "used"
            ? "Segurança: em uso"
            : safetyState === "orphan"
              ? "Segurança: possivelmente órfã"
              : "Segurança: requer revisão";
          info.append(safety);
        }
        const reviewStatus = item.reviewStatus ?? "pending";
        const cleanupStatus = item.cleanupStatus ?? "pending";
        if (safetyState && safetyState !== "used") {
          const review = document.createElement("span");
          review.className = "editor-media-card__review";
          review.dataset.state = reviewStatus;
          review.textContent = reviewStatus === "keep"
            ? "Revisão humana: manter"
            : reviewStatus === "candidate"
              ? "Revisão humana: candidata"
              : "Revisão humana: pendente";
          info.append(review);
          if (item.reviewNote) {
            const note = document.createElement("small");
            note.className = "editor-media-card__review-note";
            note.textContent = `Nota: ${item.reviewNote}`;
            info.append(note);
          }
          if (reviewStatus === "candidate") {
            const cleanup = document.createElement("span");
            cleanup.className = "editor-media-card__cleanup";
            cleanup.dataset.state = cleanupStatus;
            cleanup.textContent = cleanupStatus === "approved" ? "Gate final: aprovado para plano" : "Gate final: aguardando segunda revisão";
            info.append(cleanup);
            if (item.cleanupNote) {
              const cleanupNote = document.createElement("small");
              cleanupNote.className = "editor-media-card__review-note";
              cleanupNote.textContent = `Segunda revisão: ${item.cleanupNote}`;
              info.append(cleanupNote);
            }
          }
        }
        const actions = document.createElement("div");
        actions.className = "editor-media-card__actions";
        const insertButton = document.createElement("button");
        insertButton.className = "button button-primary";
        insertButton.type = "button";
        insertButton.textContent = "Inserir";
        insertButton.addEventListener("click", () => insertMediaItem(item));
        const copyButton = document.createElement("button");
        copyButton.className = "button";
        copyButton.type = "button";
        copyButton.textContent = "Copiar URL";
        copyButton.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(mediaPublicUrl(item.objectKey));
            if (mediaLibraryStatus) mediaLibraryStatus.textContent = "URL pública da imagem copiada.";
          } catch {
            if (mediaLibraryStatus) mediaLibraryStatus.textContent = "O navegador bloqueou a cópia automática da URL.";
          }
        });
        actions.append(insertButton, copyButton);
        if (safetyState && safetyState !== "used") {
          if (reviewStatus !== "keep") {
            const keepButton = document.createElement("button");
            keepButton.className = "button";
            keepButton.type = "button";
            keepButton.textContent = "Manter";
            keepButton.addEventListener("click", () => updateMediaReview(item, "keep"));
            actions.append(keepButton);
          }
          if (reviewStatus !== "candidate") {
            const candidateButton = document.createElement("button");
            candidateButton.className = "button";
            candidateButton.type = "button";
            candidateButton.textContent = "Marcar candidata";
            candidateButton.addEventListener("click", () => updateMediaReview(item, "candidate"));
            actions.append(candidateButton);
          }
          if (reviewStatus !== "pending") {
            const reopenButton = document.createElement("button");
            reopenButton.className = "button";
            reopenButton.type = "button";
            reopenButton.textContent = "Reabrir revisão";
            reopenButton.addEventListener("click", () => updateMediaReview(item, "pending"));
            actions.append(reopenButton);
          }
          if (reviewStatus === "candidate") {
            const cleanupButton = document.createElement("button");
            cleanupButton.className = "button";
            cleanupButton.type = "button";
            cleanupButton.textContent = cleanupStatus === "approved" ? "Reabrir gate" : "Aprovar para plano";
            cleanupButton.addEventListener("click", () => updateMediaCleanupGate(item, cleanupStatus === "approved" ? "pending" : "approved"));
            actions.append(cleanupButton);
          }
        }
        card.append(image, info, actions);
        mediaGrid.append(card);
      }
      if (mediaLibraryStatus) {
        const totalImages = mediaItems.filter((item) => item.contentType.startsWith("image/")).length;
        mediaLibraryStatus.textContent = `${images.length} de ${totalImages} imagem(ns) exibida(s), mais recentes primeiro.`;
      }
    };

    const loadMediaLibrary = async () => {
      if (!api || !mediaGrid) return;
      if (refreshMediaButton) refreshMediaButton.disabled = true;
      if (mediaLibraryStatus) mediaLibraryStatus.textContent = "Atualizando biblioteca…";
      try {
        const response = await fetch(`${api}/api/media/cms`, { credentials: "include" });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível carregar a biblioteca de imagens.");
        mediaItems = Array.isArray(payload.data?.items) ? payload.data.items : [];
        renderMediaLibrary();
        renderMediaRiskZone();
      } catch (error) {
        mediaGrid.replaceChildren();
        if (mediaLibraryStatus) mediaLibraryStatus.textContent = error instanceof Error ? error.message : "Não foi possível carregar a biblioteca de imagens.";
      } finally {
        if (refreshMediaButton) refreshMediaButton.disabled = false;
      }
    };

    const uploadAndInsertImage = async () => {
      if (!api || !mediaFile || !mediaAlt || !uploadImageButton) return;
      const file = mediaFile.files?.[0];
      const alt = mediaAlt.value.trim();
      const slug = value("slug");
      const allowedImageTypes = new Set(["image/jpeg", "image/png", "image/webp", "image/avif"]);
      const maxImageSize = 10 * 1024 * 1024;
      if (!slug) { if (mediaStatus) mediaStatus.textContent = "Defina o slug do conteúdo antes de enviar a imagem."; return; }
      if (!file) { if (mediaStatus) mediaStatus.textContent = "Selecione uma imagem para enviar."; return; }
      if (!allowedImageTypes.has(file.type)) { if (mediaStatus) mediaStatus.textContent = "Use JPG, PNG, WebP ou AVIF."; return; }
      if (file.size > maxImageSize) { if (mediaStatus) mediaStatus.textContent = "A imagem deve ter no máximo 10 MB."; return; }
      if (alt.length < 3) { if (mediaStatus) mediaStatus.textContent = "Escreva um texto alternativo descritivo."; return; }
      const body = field("body");
      if (!(body instanceof HTMLTextAreaElement)) return;

      uploadImageButton.disabled = true;
      if (mediaStatus) mediaStatus.textContent = "Enviando imagem ao R2…";
      try {
        const payload = new FormData();
        payload.append("file", file);
        payload.append("alt", alt);
        payload.append("postSlug", slug);
        const response = await fetch(`${api}/api/media/cms`, {
          method: "POST",
          credentials: "include",
          headers: { "X-CSRF-Token": csrf },
          body: payload,
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error?.message ?? "Não foi possível enviar a imagem.");
        const publicPath = String(result.data?.publicPath ?? "");
        if (!publicPath) throw new Error("A API não retornou o caminho público da imagem.");
        const imageUrl = new URL(publicPath, `${api}/`).toString();
        const markdownAlt = sanitizeMarkdownAlt(alt);
        if (markdownAlt.length < 3) throw new Error("O texto alternativo precisa conter uma descrição válida.");
        insertAtCursor(body, `![${markdownAlt}](${imageUrl})`);
        mediaFile.value = "";
        mediaAlt.value = "";
        generatedMarkdown = "";
        updatePreview();
        await loadMediaLibrary();
        if (mediaStatus) mediaStatus.textContent = "Imagem enviada e inserida no Markdown.";
      } catch (error) {
        if (mediaStatus) mediaStatus.textContent = error instanceof Error ? error.message : "Não foi possível enviar a imagem.";
      } finally {
        uploadImageButton.disabled = false;
      }
    };

    const configureGithub = async () => {
      if (!api || !createPrButton || !githubState) return;
      try {
        const response = await fetch(`${api}/api/editor/status`, { credentials: "include" });
        if (!response.ok) {
          createPrButton.disabled = true;
          githubState.textContent = "GitHub: integração indisponível.";
          return;
        }
        const payload = await response.json();
        const configured = Boolean(payload.data?.configured);
        createPrButton.disabled = !configured;
        githubState.textContent = configured
          ? `GitHub: conectado a ${payload.data?.repository ?? "Dejotacode/dejotacode"}.`
          : "GitHub: integração segura ainda não configurada no Worker.";
      } catch {
        createPrButton.disabled = true;
        githubState.textContent = "GitHub: não foi possível validar a integração agora.";
      }
    };

    const stopCiPolling = () => {
      if (ciPollTimer !== undefined) window.clearTimeout(ciPollTimer);
      ciPollTimer = undefined;
      ciPollStartedAt = 0;
    };

    const refreshPullRequest = async (showLoading = true) => {
      if (!api || !currentPrNumber || !publishPanel || !publishState || !mergePrButton) return null;
      publishPanel.hidden = false;
      if (publishTitle) publishTitle.textContent = `Pull Request #${currentPrNumber}`;
      if (showLoading) publishState.textContent = "Consultando GitHub e CI…";
      mergePrButton.disabled = true;
      try {
        const response = await fetch(`${api}/api/editor/pull-request/${currentPrNumber}`, { credentials: "include" });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível consultar o Pull Request.");
        const data = payload.data ?? {};
        currentPrHeadSha = String(data.headSha ?? "");
        const ciLabel = data.ci === "success" ? "CI aprovado" : data.ci === "failure" ? "CI com falha" : data.ci === "pending" ? "CI em andamento" : "CI indisponível";
        const stateLabel = data.merged ? "mesclado" : data.state === "open" ? "aberto" : "fechado";
        publishState.textContent = `Estado: ${stateLabel} · ${ciLabel}${data.mergeable === false ? " · conflito detectado" : ""}.`;
        if (workflowLink && data.workflowUrl) { workflowLink.href = data.workflowUrl; workflowLink.hidden = false; }
        if (prLink && data.url) { prLink.href = data.url; prLink.hidden = false; }
        const canMerge = data.state === "open" && !data.merged && data.ci === "success" && data.mergeable === true && currentPrHeadSha;
        mergePrButton.hidden = Boolean(data.merged || data.state !== "open");
        mergePrButton.disabled = !canMerge;
        return data;
      } catch (error) {
        publishState.textContent = error instanceof Error ? error.message : "Não foi possível consultar o Pull Request.";
        return null;
      }
    };

    const startCiPolling = () => {
      stopCiPolling();
      ciPollStartedAt = Date.now();
      const poll = async () => {
        const data = await refreshPullRequest(false);
        if (!data || data.merged || data.state !== "open" || data.ci !== "pending") {
          stopCiPolling();
          return;
        }
        if (Date.now() - ciPollStartedAt >= ciPollMaxDurationMs) {
          stopCiPolling();
          if (publishState) publishState.textContent = "CI ainda em andamento. Atualização automática pausada; use Atualizar status para consultar novamente.";
          return;
        }
        ciPollTimer = window.setTimeout(poll, ciPollIntervalMs);
      };
      ciPollTimer = window.setTimeout(poll, ciPollIntervalMs);
    };

    const mergePullRequest = async () => {
      if (!api || !currentPrNumber || !mergePrButton || !publishState) return;
      if (!currentPrHeadSha) {
        publishState.textContent = "Atualize o status do Pull Request antes de publicar.";
        return;
      }
      if (!confirm(`Mesclar o Pull Request #${currentPrNumber} na main e iniciar a publicação?`)) return;
      mergePrButton.disabled = true;
      publishState.textContent = "Validando CI e solicitando merge…";
      try {
        const response = await fetch(`${api}/api/editor/pull-request/${currentPrNumber}/merge`, {
          method: "POST", credentials: "include",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
          body: JSON.stringify({ confirmation: "PUBLICAR", expectedHeadSha: currentPrHeadSha }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível publicar o conteúdo.");
        publishState.textContent = "Merge concluído. O Cloudflare Pages iniciou o fluxo de publicação da main.";
        if (status) status.textContent = `Pull Request #${currentPrNumber} mesclado com segurança.`;
        await refreshPullRequest();
        stopCiPolling();
      } catch (error) {
        const message = error instanceof Error ? error.message : "Não foi possível publicar o conteúdo.";
        await refreshPullRequest();
        publishState.textContent = `${message} Atualize o status antes de tentar novamente.`;
      }
    };

    const createPullRequest = async () => {
      if (!api || !createPrButton) return;
      const markdown = generatedMarkdown || buildMarkdown();
      if (!markdown) return;
      createPrButton.disabled = true;
      if (status) status.textContent = "Criando branch editorial e Pull Request…";
      if (prLink) prLink.hidden = true;
      try {
        const response = await fetch(`${api}/api/editor/pull-request`, {
          method: "POST", credentials: "include",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
          body: JSON.stringify({ slug: value("slug"), title: value("title"), markdown }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error?.message ?? "Não foi possível criar o Pull Request.");
        currentPrNumber = Number(payload.data?.pullRequestNumber ?? 0);
        if (currentPrNumber) sessionStorage.setItem("dejotacode-editor-pr", String(currentPrNumber));
        if (status) status.textContent = `Pull Request #${currentPrNumber || ""} criado para revisão.`;
        if (prLink && payload.data?.pullRequestUrl) { prLink.href = payload.data.pullRequestUrl; prLink.hidden = false; }
        const prState = await refreshPullRequest();
        if (prState?.ci === "pending") startCiPolling();
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : "Não foi possível criar o Pull Request.";
      } finally {
        await configureGithub();
      }
    };

    const start = async () => {
      if (!api) return;
      const session = await fetch(`${api}/api/auth/session`, { credentials: "include" });
      if (!session.ok) {
        location.href = "/admin/";
        return;
      }
      const payload = await session.json();
      csrf = String(payload.data?.csrf ?? "");
      resetForm();
      await Promise.all([configureGithub(), loadMediaLibrary()]);
      if (currentPrNumber) {
        const prState = await refreshPullRequest();
        if (prState?.ci === "pending") startCiPolling();
      }
    };

    document.querySelector("[data-new-content]")?.addEventListener("click", resetForm);
    document.querySelector("[data-generate]")?.addEventListener("click", () => buildMarkdown());
    document.querySelector("[data-copy-markdown]")?.addEventListener("click", copyGenerated);
    document.querySelector("[data-download]")?.addEventListener("click", downloadGenerated);
    uploadImageButton?.addEventListener("click", uploadAndInsertImage);
    refreshMediaButton?.addEventListener("click", loadMediaLibrary);
    mediaSearch?.addEventListener("input", renderMediaLibrary);
    mediaContext?.addEventListener("change", renderMediaLibrary);
    mediaUsage?.addEventListener("change", renderMediaLibrary);
    mediaSafetyFilter?.addEventListener("change", renderMediaLibrary);
    mediaSafetyButton?.addEventListener("click", runMediaSafetyReport);
    mediaCleanupPlanButton?.addEventListener("click", generateCleanupPlan);
    mediaRiskSelect?.addEventListener("change", renderMediaRiskZone);
    mediaRiskDryRunButton?.addEventListener("click", () => {
      const item = selectedRiskMedia();
      if (item) runMediaDeleteDryRun(item);
    });
    mediaRiskDeleteButton?.addEventListener("click", () => {
      const item = selectedRiskMedia();
      if (item) deleteMediaItem(item);
    });
    createPrButton?.addEventListener("click", createPullRequest);
    refreshPrButton?.addEventListener("click", async () => {
      const prState = await refreshPullRequest();
      if (prState?.ci === "pending") startCiPolling();
      else stopCiPolling();
    });
    mergePrButton?.addEventListener("click", mergePullRequest);

    select?.addEventListener("change", () => {
      if (!select.value) {
        resetForm();
        return;
      }
      const post = posts.find((item) => item.slug === select.value);
      if (post) fillPost(post);
    });

    form?.addEventListener("input", (event) => {
      const target = event.target;
      let slugChanged = target instanceof HTMLInputElement && target.name === "slug";
      if (target instanceof HTMLInputElement && target.name === "title" && !value("slug")) {
        field("slug")!.value = slugify(target.value);
        slugChanged = true;
      }
      generatedMarkdown = "";
      updateCounters();
      updatePreview();
      if (slugChanged || (target instanceof HTMLTextAreaElement && target.name === "body")) renderMediaLibrary();
    });
    document.querySelector("[data-logout]")?.addEventListener("click", async () => {
      if (!api) return;
      await fetch(`${api}/api/auth/logout`, {
        method: "POST",
        credentials: "include",
        headers: csrf ? { "X-CSRF-Token": csrf } : {},
      });
      location.href = "/admin/";
    });

    start().catch(() => {
      if (status) status.textContent = "Não foi possível validar a sessão administrativa.";
    });
  </script>
</AdminLayout>
