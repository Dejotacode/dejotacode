---
import "../../../styles/institutional.css";
import CategoryIcon from "../../../components/CategoryIcon.astro";
import "../../../styles/acquisition.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { guide } from "../../../data/guide";
---

<BaseLayout
  title={guide.meta.title}
  description={guide.meta.description}
  robots={guide.meta.robots}
>
  <main id="conteudo" tabindex="-1" class="institutional-page beginner-guide-page">
    <header class="institutional-hero institutional-hero--media container">
      <div class="institutional-hero__copy">
        <p class="eyebrow">{guide.hero.eyebrow}</p>
        <h1>{guide.hero.title}</h1>
        <p>{guide.hero.description}</p>
        <div class="institutional-hero__chips"><span>Comece do zero</span><span>Pratique</span><span>Avance por etapas</span></div>
      </div>
      <aside class="guide-overview" aria-label="Como usar o guia">
        <CategoryIcon icon="news" size={40} />
        <h2>Escolha como começar</h2>
        <p>Leia o guia nesta página ou baixe o PDF para consultar depois.</p>
        <a class="button button-primary" href="/downloads/guia-do-iniciante-em-tecnologia.pdf" download data-guide-download data-analytics-cta="guide-download-pdf">Baixar o guia em PDF <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="#antes-de-comecar">Começar a leitura <span aria-hidden="true">→</span></a>
      </aside>
    </header>

    <nav class="container guide-section-nav" aria-label="Seções do guia">
      <a href="#antes-de-comecar">Antes de começar</a><a href="#fundamentos">Fundamentos</a><a href="#primeiro-projeto">Primeiro projeto</a><a href="#erros-comuns">Erros comuns</a><a href="#ia-aprendizado">IA como apoio</a><a href="#checklist">Checklist</a><a href="#plano-30-dias">Plano de 30 dias</a>
    </nav>


    <section id="antes-de-comecar" class="institutional-section container">
      <div class="institutional-heading">
        <div>
          <p class="eyebrow">{guide.beforeStart.eyebrow}</p>
          <h2>{guide.beforeStart.title}</h2>
        </div>

        <p>{guide.beforeStart.description}</p>
      </div>

      <div class="institutional-grid">
        {
          guide.beforeStart.cards.map((card) => (
            <article class="institutional-card">
              <span>{card.number}</span>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="fundamentos" class="statement">
      <div class="container">
        <p class="eyebrow">{guide.fundamentals.eyebrow}</p>

        <h2>{guide.fundamentals.title}</h2>

        <p>{guide.fundamentals.description}</p>
      </div>
    </section>

    <section id="primeiro-projeto" class="institutional-section container">
      <div class="institutional-heading">
        <div>
          <p class="eyebrow">{guide.firstProject.eyebrow}</p>
          <h2>{guide.firstProject.title}</h2>
        </div>

        <p>{guide.firstProject.description}</p>
      </div>
    </section>

    <section id="erros-comuns" class="institutional-section container">
      <div class="institutional-heading">
        <div>
          <p class="eyebrow">{guide.commonMistakes.eyebrow}</p>
          <h2>{guide.commonMistakes.title}</h2>
        </div>
      </div>

      <div class="institutional-grid">
        {
          guide.commonMistakes.cards.map((card) => (
            <article class="institutional-card">
              <span>{card.number}</span>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="ia-aprendizado" class="institutional-section container">
      <div class="institutional-heading">
        <div>
          <p class="eyebrow">{guide.aiForLearning.eyebrow}</p>
          <h2>{guide.aiForLearning.title}</h2>
        </div>

        <p>{guide.aiForLearning.description}</p>
      </div>

      <div class="institutional-grid">
        {
          guide.aiForLearning.principles.map((principle) => (
            <article class="institutional-card">
              <span>{principle.number}</span>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="checklist" class="institutional-section container">
      <div class="institutional-heading">
        <div>
          <p class="eyebrow">{guide.checklist.eyebrow}</p>
          <h2>{guide.checklist.title}</h2>
        </div>

        <p>{guide.checklist.description}</p>
      </div>

      <div class="institutional-card wide-card">
        <ul>
          {guide.checklist.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section id="plano-30-dias" class="statement">
      <div class="container">
        <p class="eyebrow">{guide.plan.eyebrow}</p>

        <h2>{guide.plan.title}</h2>

        <div class="institutional-grid">
          {
            guide.plan.weeks.map((week) => (
              <article class="institutional-card">
                <span>{week.label}</span>
                <h3>{week.title}</h3>
                <p>{week.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="proximo-passo" class="institutional-section container">
      <div class="notice">
        <strong>{guide.nextStep.title}</strong>

        <p>{guide.nextStep.description}</p>

        <p>
          <a
            class="button button-primary"
            href="/downloads/guia-do-iniciante-em-tecnologia.pdf"
            download
            data-guide-download
            data-analytics-cta="guide-download-pdf"
          >
            Baixar o guia em PDF
          </a>
        </p>

        <p>
          <a class="button" href={guide.nextStep.cta.href}>
            {guide.nextStep.cta.label}
          </a>
        </p>
      </div>
    </section>
  </main>

  <script>
    import { sendAnalyticsEvent } from "../../../scripts/analytics";

    const download =
      document.querySelectorAll<HTMLAnchorElement>("[data-guide-download]");

    download.forEach((link) => link.addEventListener("click", () => {
      const apiBase =
        typeof window.__DEJOTACODE_API_BASE__ === "string"
          ? window.__DEJOTACODE_API_BASE__
          : "";

      sendAnalyticsEvent(
        apiBase,
        "guide_access",
        "guia-iniciante-tecnologia",
      );
    }));
  </script>
</BaseLayout>
