---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { recommendedResources } from "../../data/recommendedResources";
import "../../styles/institutional.css";
import "../../styles/resources.css";

const groups = [
  { id: "desenvolvimento", label: "Desenvolvimento", description: "Ferramentas para escrever, testar e versionar projetos." },
  { id: "infraestrutura", label: "Infraestrutura", description: "Serviços usados para publicar e manter projetos web." },
  { id: "aprendizado", label: "Aprendizado", description: "Referências para continuar estudando com fontes confiáveis." },
] as const;
const hasAffiliateLinks = recommendedResources.some((resource) => resource.relationship === "affiliate");
---

<BaseLayout title="Ferramentas e recursos para tecnologia | DejotaCode" description="Recursos avaliados com critérios claros, limitações e identificação transparente de qualquer relação comercial.">
  <main id="conteudo" tabindex="-1" class="institutional-page">
    <header class="institutional-hero container">
      <p class="eyebrow">FERRAMENTAS E REFERÊNCIAS</p>
      <h1>Recursos com contexto, não apenas links.</h1>
      <p>Cada indicação informa para quem serve, suas limitações e se existe alguma relação comercial.</p>
    </header>

    <section class="institutional-section container resource-intro" aria-labelledby="transparencia-title">
      <div class="notice">
        <strong id="transparencia-title">Transparência comercial</strong>
        <p>{hasAffiliateLinks ? "Esta página contém links de afiliados identificados no próprio card. Se você comprar por meio deles, o DejotaCode poderá receber uma comissão, sem custo adicional para você. Essa relação não garante avaliação positiva." : "Atualmente, os recursos desta página usam links oficiais e não geram comissão. Se um link de afiliado for ativado, ele será identificado no próprio card antes do clique."}</p>
      </div>
      <ol class="resource-principles" aria-label="Critérios de recomendação">
        <li>Relação direta com os conteúdos do site.</li>
        <li>Benefícios e limitações apresentados juntos.</li>
        <li>Revisão periódica de links e informações.</li>
      </ol>
    </section>

    <section class="institutional-section container resource-groups" aria-label="Recursos recomendados">
      {groups.map((group) => (
        <section aria-labelledby={`group-${group.id}`}>
          <header class="resource-group__heading">
            <div>
              <p class="eyebrow">SELEÇÃO EDITORIAL</p>
              <h2 id={`group-${group.id}`}>{group.label}</h2>
            </div>
            <p>{group.description}</p>
          </header>
          <div class="institutional-grid">
            {recommendedResources.filter((resource) => resource.category === group.id).map((resource) => (
              <article class="institutional-card resource-card">
                <div class="resource-card__meta">
                  <span>{resource.priceLabel}</span>
                  <span>{resource.relationship === "affiliate" ? "Link de afiliado" : "Sem comissão"}</span>
                </div>
                <h3>{resource.name}</h3>
                <p>{resource.description}</p>
                <p><strong>Indicado para:</strong> {resource.bestFor}</p>
                <p><strong>Limitação:</strong> {resource.limitation}</p>
                <a class="resource-link" href={resource.href} target="_blank" rel={resource.relationship === "affiliate" ? "sponsored nofollow noopener noreferrer" : "noopener noreferrer"} data-analytics-cta={`resource-${resource.id}`}>{resource.cta} ↗</a>
                <p class="resource-review-date">Revisado em {resource.lastReviewed}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </section>
  </main>
</BaseLayout>
