---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { recommendedResources } from "../../data/recommendedResources";
import "../../styles/institutional.css";
import "../../styles/resources.css";

const groups = [
  { id: "desenvolvimento", label: "Desenvolvimento", description: "Ferramentas para escrever, testar e versionar projetos." },
  { id: "digitais", label: "Ferramentas digitais", description: "Serviços usados para criação, publicação, automação e operação de conteúdo." },
  { id: "infraestrutura", label: "Infraestrutura", description: "Serviços e equipamentos usados para publicar, manter e operar projetos web." },
  { id: "aprendizado", label: "Aprendizado", description: "Referências, cursos e materiais para continuar estudando com contexto." },
  { id: "seguranca", label: "Segurança", description: "Ferramentas e referências para proteção de contas, dados e navegação." },
] as const;

const activeGroups = groups.filter((group) => recommendedResources.some((resource) => resource.category === group.id));
const hasCommercialRelationships = recommendedResources.some((resource) => resource.relationship === "affiliate");
---

<BaseLayout title="Ferramentas e recursos para tecnologia | DejotaCode" description="Recursos avaliados com critérios claros, limitações e caminhos separados para aprender, avaliar e acessar ferramentas.">
  <main id="conteudo" tabindex="-1" class="institutional-page">
    <header class="institutional-hero container">
      <p class="eyebrow">FERRAMENTAS E REFERÊNCIAS</p>
      <h1>Recursos com contexto, não apenas links.</h1>
      <p>Descubra ferramentas por categoria e escolha o próximo passo: aprender no Blog, avaliar na DejotaStore ou consultar a fonte oficial.</p>
    </header>

    <section class="institutional-section container resource-intro" aria-labelledby="transparencia-title">
      <div class="notice">
        <strong id="transparencia-title">Transparência comercial</strong>
        <p>{hasCommercialRelationships ? "Alguns recursos têm relação comercial com o DejotaCode. Quando existe uma recomendação monetizada, o card direciona primeiro para a DejotaStore ou identifica claramente o link externo. A relação comercial não garante avaliação positiva." : "Atualmente, os recursos desta página usam links oficiais e não geram comissão. Se uma relação comercial for ativada, ela será identificada antes do clique."}</p>
      </div>
      <ol class="resource-principles" aria-label="Critérios de recomendação">
        <li>Aprender antes de comprar ou assinar.</li>
        <li>Benefícios e limitações apresentados juntos.</li>
        <li>Separação clara entre Blog, DejotaStore e site oficial.</li>
      </ol>
    </section>

    <section class="institutional-section container" aria-labelledby="materials-title">
      <header class="resource-group__heading">
        <div>
          <p class="eyebrow">MATERIAIS DO DEJOTACODE</p>
          <h2 id="materials-title">Criados aqui para aprofundar o aprendizado</h2>
        </div>
        <p>Produtos próprios aparecem separados das recomendações de terceiros para deixar clara a autoria e a relação comercial.</p>
      </header>

      <article class="institutional-card dejotacode-material-card">
        <img src="/assets/products/linux-do-zero/cover.png" alt="Capa real do e-book Linux do Zero" width="1159" height="1638" loading="lazy" decoding="async" />
        <div>
          <div class="resource-card__meta">
            <span>Produto próprio</span>
            <span>Disponível agora</span>
          </div>
          <h3>Linux do Zero</h3>
          <p>E-book de 88 páginas para iniciantes, com instalação segura, primeiros passos, terminal, permissões e solução de problemas.</p>
          <p><strong>Indicado para:</strong> quem quer começar no Linux sem depender de conhecimento técnico prévio.</p>
          <a class="button button-primary" href="/produtos/linux-do-zero/" data-analytics-cta="resource-linux-ebook-own">Conhecer o e-book</a>
        </div>
      </article>
    </section>

    <section class="institutional-section container resource-groups" aria-label="Recursos recomendados">
      {activeGroups.map((group) => (
        <section aria-labelledby={`group-${group.id}`}>
          <header class="resource-group__heading">
            <div>
              <p class="eyebrow">SELEÇÃO EDITORIAL</p>
              <h2 id={`group-${group.id}`}>{group.label}</h2>
            </div>
            <p>{group.description}</p>
          </header>
          <div class="institutional-grid">
            {recommendedResources.filter((resource) => resource.category === group.id).map((resource) => (
              <article class="institutional-card resource-card">
                <div class="resource-card__meta">
                  <span>{resource.priceLabel}</span>
                  {resource.editorialLabel && <span>{resource.editorialLabel}</span>}
                  <span>{resource.storePath ? "Detalhes na DejotaStore" : resource.relationship === "affiliate" ? "Link de afiliado" : "Sem comissão"}</span>
                </div>
                <h3>{resource.name}</h3>
                <p>{resource.description}</p>
                <p><strong>Indicado para:</strong> {resource.bestFor}</p>
                <p><strong>Limitação:</strong> {resource.limitation}</p>

                <div class="resource-card__actions" aria-label={`Caminhos para ${resource.name}`}>
                  {resource.articlePath && (
                    <a class="button button-secondary" href={resource.articlePath} data-analytics-cta={`resource-${resource.id}-article`}>Ver tutorial</a>
                  )}
                  {resource.storePath && (
                    <a class="button button-primary" href={resource.storePath} data-analytics-cta={`resource-${resource.id}-store`}>Ver na DejotaStore</a>
                  )}
                  {!resource.articlePath && !resource.storePath && (
                    <a class="resource-link" href={resource.href} target="_blank" rel={resource.relationship === "affiliate" ? "sponsored nofollow noopener noreferrer" : "noopener noreferrer"} data-analytics-cta={`resource-${resource.id}`} data-analytics-affiliate-provider={resource.affiliateProvider} data-analytics-affiliate-id={resource.id}>{resource.cta} ↗</a>
                  )}
                  {resource.officialHref && !resource.storePath && (
                    <a class="resource-link resource-link--secondary" href={resource.officialHref} target="_blank" rel="noopener noreferrer" data-analytics-cta={`resource-${resource.id}-official`}>Site oficial ↗</a>
                  )}
                </div>
                <p class="resource-review-date">Revisado em {resource.lastReviewed}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </section>
  </main>
</BaseLayout>
