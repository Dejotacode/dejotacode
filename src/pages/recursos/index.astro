---
import BaseLayout from "../../layouts/BaseLayout.astro";import "../../styles/institutional.css";
const resources=[{n:"01",name:"Astro",text:"Framework usado para construir páginas rápidas e orientadas a conteúdo.",url:"https://docs.astro.build/"},{n:"02",name:"Visual Studio Code",text:"Editor usado para escrever, organizar e revisar os arquivos do projeto.",url:"https://code.visualstudio.com/docs"},{n:"03",name:"Git",text:"Ferramenta que registra a evolução do código e permite retornar a pontos seguros.",url:"https://git-scm.com/doc"},{n:"04",name:"GitHub",text:"Serviço usado para hospedar repositórios e colaborar em projetos.",url:"https://docs.github.com/"},{n:"05",name:"Cloudflare",text:"Plataforma de infraestrutura usada no projeto para publicação e serviços de borda.",url:"https://developers.cloudflare.com/"},{n:"06",name:"Linux",text:"Sistema usado no ambiente de desenvolvimento e tema central das primeiras trilhas.",url:"https://www.linuxfoundation.org/"}];
---
<BaseLayout title="Recursos | DejotaCode" description="Ferramentas e referências usadas na construção do DejotaCode."><main id="conteudo" tabindex="-1" class="institutional-page"><header class="institutional-hero container"><p class="eyebrow">FERRAMENTAS E REFERÊNCIAS</p><h1>Recursos que usamos de verdade.</h1><p>Uma seleção transparente de ferramentas presentes no trabalho e nos conteúdos do DejotaCode.</p></header><section class="institutional-section container"><div class="institutional-grid">{resources.map(r=><article class="institutional-card"><span>{r.n}</span><h2>{r.name}</h2><p>{r.text}</p><a class="resource-link" href={r.url} target="_blank" rel="noopener noreferrer">Documentação oficial ↗</a></article>)}</div></section><section class="institutional-section container"><div class="notice"><strong>Transparência comercial</strong><p>Quando um recurso possuir link de afiliado ou patrocínio, essa relação será identificada claramente junto ao link.</p></div></section></main></BaseLayout>
