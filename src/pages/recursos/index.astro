---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceCard from "../../components/resources/ResourceCard.astro";
import VisualMedia from "../../components/visual/VisualMedia.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import { resourceCategories } from "../../data/resourceCategories";
import { recommendedResources, sortResourcesNewestFirst } from "../../data/recommendedResources";
import "../../styles/institutional.css";
import "../../styles/resources.css";

const activeGroups = resourceCategories.filter((group) => recommendedResources.some((resource) => resource.category === group.id));
const editorialGroups = [
  { id: "criacao-produtividade", label: "Criação e Produtividade", description: "Ferramentas para trabalhar com vídeos, áudio e documentos.", iconId: "apps" as const },
  { id: "manutencao-recuperacao", label: "Manutenção e Recuperação", description: "Ferramentas para avaliar recuperação de arquivos e cuidar de dados em dispositivos.", iconId: "shield-check" as const },
];
const hasCommercialRelationships = recommendedResources.some((resource) => resource.relationship === "affiliate");
---

<BaseLayout title="Ferramentas e recursos para tecnologia | DejotaCode" description="Recursos avaliados com critérios claros, limitações e caminhos separados para aprender, avaliar e acessar ferramentas.">
  <main id="conteudo" tabindex="-1" class="resources-page">
    <section class="resources-hero container">
      <div class="resources-hero__copy">
        <p class="eyebrow">RECURSOS DEJOTACODE</p>
        <h1>Ferramentas com contexto para você decidir melhor.</h1>
        <p>Guias, serviços, referências e produtos organizados pelo que ajudam a resolver — sem transformar a página em uma lista de links.</p>
        <div class="resources-hero__actions">
          <a class="button button-primary" href="#categorias">Explorar recursos</a>
          <a class="button" href="/store/">Conhecer a DejotaStore</a>
        </div>
      </div>
      <VisualMedia src="/assets/resources/hero-recursos.svg" alt="Ilustração de tecnologia e recursos do DejotaCode" loading="eager" />
    </section>

    <section id="categorias" class="resource-directory container" aria-labelledby="resource-directory-title">
      <div class="resource-directory__heading">
        <div><p class="eyebrow">NAVEGUE POR NECESSIDADE</p><h2 id="resource-directory-title">Encontre o tipo de recurso certo</h2></div>
        <p>Use as categorias como atalhos para chegar direto ao que você precisa.</p>
      </div>
      <nav class="resource-category-nav" aria-label="Categorias de recursos">
        {editorialGroups.map((group) => <a href={`#${group.id}`}><CategoryIcon icon={group.iconId} size={18} /><span>{group.label}</span></a>)}
        {activeGroups.map((group) => <a href={`#${group.id}`}><CategoryIcon icon={group.iconId} size={18} /><span>{group.label}</span></a>)}
      </nav>
    </section>

    <section class="container resource-trust-grid" aria-label="Critérios de transparência">
      <article class="resource-trust-card">
        <span>01</span><strong>Aprenda antes do clique</strong><p>Quando existe conteúdo explicando o contexto, ele aparece antes da recomendação comercial.</p>
      </article>
      <article class="resource-trust-card">
        <span>02</span><strong>Limitações visíveis</strong><p>Benefícios, custo e pontos de atenção ficam disponíveis no próprio card.</p>
      </article>
      <article class="resource-trust-card">
        <span>03</span><strong>Relação comercial clara</strong><p>{hasCommercialRelationships ? "Recursos monetizados são identificados e direcionados de forma transparente." : "Nenhum recurso atual gera comissão para o DejotaCode."}</p>
      </article>
    </section>

    <section class="container resource-featured" aria-labelledby="materials-title">
      <div class="resource-section-heading">
        <div><p class="eyebrow">MATERIAL DO DEJOTACODE</p><h2 id="materials-title">Criado aqui para quem está começando</h2></div>
        <p>Produtos próprios ficam separados das recomendações de terceiros para preservar autoria e transparência.</p>
      </div>
      <article class="resource-featured-card">
        <div class="resource-featured-card__cover"><img src="/assets/products/linux-do-zero/cover.png" alt="Capa do e-book Linux do Zero" width="1159" height="1638" loading="lazy" decoding="async" /></div>
        <div class="resource-featured-card__copy">
          <p class="resource-featured-card__eyebrow">Material DejotaCode</p>
          <h3>Linux do Zero</h3>
          <p>E-book para iniciantes com instalação segura, primeiros passos, terminal, permissões e solução de problemas.</p>
          <div class="resource-featured-card__facts"><span>88 páginas</span><span>Para iniciantes</span><span>Conteúdo próprio</span></div>
          <p class="resource-featured-card__fit"><strong>Ideal para:</strong> quem quer começar no Linux sem depender de conhecimento técnico prévio.</p>
          <a class="button button-primary" href="/produtos/linux-do-zero/" data-analytics-cta="resource-linux-ebook-own">Conhecer o e-book</a>
        </div>
      </article>
    </section>

    <section class="container resource-groups" aria-label="Recursos recomendados">
      {editorialGroups.map((group) => (
        <section id={group.id} class="resource-group" aria-labelledby={`group-${group.id}`}>
          <header class="resource-section-heading resource-section-heading--category">
            <div><p class="eyebrow">SELEÇÃO EDITORIAL</p><div class="resource-section-title"><CategoryIcon icon={group.iconId} size={24} /><h2 id={`group-${group.id}`}>{group.label}</h2></div></div>
            <p>{group.description}</p>
          </header>
          <div class="resource-grid-v2">
            {recommendedResources.filter((resource) => resource.editorialGroup === group.id).map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      ))}
      {activeGroups.map((group, groupIndex) => {
        const groupResources = sortResourcesNewestFirst(recommendedResources.filter((resource) => resource.category === group.id));
        const visibleResources = groupResources.filter((resource) => !resource.editorialGroup).slice(0, 3);
        return (
          <section id={group.id} class="resource-group" aria-labelledby={`group-${group.id}`}>
            <header class="resource-section-heading resource-section-heading--category">
              <div>
                <p class="eyebrow">SELEÇÃO EDITORIAL</p>
                <div class="resource-section-title"><CategoryIcon icon={group.iconId} size={24} /><h2 id={`group-${group.id}`}>{group.label}</h2></div>
              </div>
              <p>{group.description}</p>
            </header>
            <div class="resource-grid-v2">
              {visibleResources.map((resource, resourceIndex) => <ResourceCard resource={resource} loading={groupIndex === 0 && resourceIndex < 3 ? "eager" : "lazy"} />)}
            </div>
            <div class="resource-group__footer">
              <span>{groupResources.length} {groupResources.length === 1 ? "recurso" : "recursos"} nesta categoria</span>
              <a class="resource-group__all" href={`/recursos/${group.id}/`}>Ver todos em {group.label} <span aria-hidden="true">→</span></a>
            </div>
          </section>
        );
      })}
    </section>
  </main>
</BaseLayout>
