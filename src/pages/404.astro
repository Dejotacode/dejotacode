---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryIcon from "../components/CategoryIcon.astro";
import "../styles/auxiliary.css";
---

<BaseLayout
  title="Página não encontrada | DejotaCode"
  description="A página que você tentou acessar não foi encontrada."
  robots="noindex, follow"
  canonicalEnabled={false}
>
  <main id="conteudo" tabindex="-1" class="not-found-page">
    <section class="not-found container" aria-labelledby="not-found-title">
      <div class="not-found__copy">
      <p class="eyebrow">ERRO 404</p>

      <h1 id="not-found-title">Essa página não existe.</h1>

      <p class="not-found__lead">
        O endereço pode ter mudado, sido removido ou talvez tenha sido digitado
        incorretamente.
      </p>

      <div class="not-found__actions">
        <a class="button button-primary" href="/">
          Voltar para o início
        </a>

        <a class="button button-secondary" href="/blog/">
          Explorar conteúdos
        </a>
      </div>
      </div>
      <aside class="not-found__search" aria-labelledby="not-found-search-title">
        <CategoryIcon icon="grid" size={32} />
        <h2 id="not-found-search-title">Encontre o que procura.</h2>
        <form action="/busca/" method="get" role="search" aria-label="Buscar conteúdo no site">
          <label for="not-found-query">Buscar no DejotaCode</label>
          <input id="not-found-query" name="q" type="search" placeholder="Linux, programação, ferramentas…" required />
          <button class="button button-primary" type="submit">Buscar</button>
        </form>
      </aside>
    </section>
  </main>
</BaseLayout>
