---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página não encontrada | DejotaCode"
  description="A página que você tentou acessar não foi encontrada."
  robots="noindex, follow"
  canonicalEnabled={false}
>
  <main id="conteudo" tabindex="-1" class="not-found-page">
    <section class="not-found container">
      <p class="eyebrow">ERRO 404</p>

      <h1>Essa página não existe.</h1>

      <p class="not-found__lead">
        O endereço pode ter mudado, sido removido ou talvez tenha sido digitado
        incorretamente.
      </p>

      <div class="not-found__actions">
        <a class="button button-primary" href="/">
          Voltar para o início
        </a>

        <a class="button button-secondary" href="/blog/">
          Explorar conteúdos
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found-page {
    min-height: clamp(32rem, 70vh, 48rem);
    display: grid;
    align-items: center;
  }

  .not-found {
    padding-block: clamp(5rem, 12vw, 9rem);
  }

  .not-found h1 {
    max-width: 12ch;
    margin: 0.75rem 0 1rem;
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .not-found__lead {
    max-width: 38rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (max-width: 32rem) {
    .not-found__actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
