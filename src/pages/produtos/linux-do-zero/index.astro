---
import CategoryIcon from "../../../components/ui/CategoryIcon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/product.css";

const samples = [
  { src: "/assets/products/linux-do-zero/preview-01.webp", title: "Entenda o Linux", description: "Conceitos explicados com analogias e linguagem simples.", page: 9 },
  { src: "/assets/products/linux-do-zero/preview-install.webp", title: "Revise antes de instalar", description: "Cuidados com disco, partições e configurações.", page: 42 },
  { src: "/assets/products/linux-do-zero/preview-terminal.webp", title: "Comandos com exemplos", description: "Veja o que cada comando faz e como utilizá-lo.", page: 59 },
];
const chapters = [
  ["01", "Linux sem medo", "Entenda o que é Linux e onde ele aparece no dia a dia."],
  ["02", "Escolhendo sua primeira distribuição", "Critérios simples para escolher sem transformar a decisão em um labirinto."],
  ["03", "Preparação antes da instalação", "Backup, pendrive, modo live e cuidados antes de mexer no disco."],
  ["04", "Instalação passo a passo", "Do idioma ao primeiro boot, com alertas nos pontos que exigem mais atenção."],
  ["05", "Primeiros passos depois da instalação", "Atualizações, aplicativos, interface, som, Bluetooth e rotina inicial."],
  ["06", "Terminal sem medo", "20 comandos essenciais explicados para quem está começando."],
  ["07", "Arquivos, usuários e permissões", "Permissões sem mistério e sem atalhos perigosos."],
  ["08", "Problemas comuns", "Como investigar erros, pesquisar soluções e pedir ajuda com segurança."],
];

const canonicalUrl = new URL("/produtos/linux-do-zero/", Astro.site ?? Astro.url.origin);
const productBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Início",
      item: new URL("/", canonicalUrl).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Linux do Zero",
      item: canonicalUrl.href,
    },
  ],
};

const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: "Linux do Zero",
  author: { "@type": "Person", name: "Dejota" },
  publisher: { "@type": "Organization", name: "DejotaCode" },
  inLanguage: "pt-BR",
  bookFormat: "https://schema.org/EBook",
  numberOfPages: 88,
  url: canonicalUrl.href,
  description: "E-book prático de Linux para iniciantes, com instalação segura, primeiros passos, terminal, permissões e solução de problemas.",
  offers: {
    "@type": "Offer",
    price: "19.90",
    priceCurrency: "BRL",
    availability: "https://schema.org/InStock",
    url: "https://pay.hotmart.com/W107818359E?off=e3elv7fq",
    seller: { "@type": "Organization", name: "DejotaCode" },
  },
};
---

<BaseLayout
  title="Linux do Zero — e-book para iniciantes | DejotaCode"
  description="Aprenda Linux desde o primeiro passo com um e-book de 88 páginas, exemplos práticos, imagens reais e explicações pensadas para iniciantes."
  image="/assets/products/linux-do-zero/cover.png"
  imageAlt="Capa do e-book Linux do Zero, do DejotaCode"
  imageWidth={1159}
  imageHeight={1638}
  robots="index, follow"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(bookSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productBreadcrumbSchema)} />

  <main id="conteudo" tabindex="-1" class="product-page">
    <header class="product-hero">
      <div class="container product-hero__grid">
        <div class="product-hero__copy">
          <nav class="product-breadcrumbs" aria-label="Navegação estrutural">
            <a href="/">Início</a><span aria-hidden="true">/</span>
            <span>Produtos</span><span aria-hidden="true">/</span>
            <span aria-current="page">Linux do Zero</span>
          </nav>

          <p class="eyebrow">E-BOOK DEJOTACODE · DISPONÍVEL AGORA</p>
          <h1>Linux do Zero</h1>
          <p class="product-tagline">Comece no Linux com uma base mais segura.</p>
          <p class="product-lead">
            Um guia de 88 páginas para quem quer entender Linux, testar com segurança,
            instalar, usar o terminal e resolver os primeiros problemas sem depender de
            explicações cheias de jargões.
          </p>

          <div class="product-meta" aria-label="Informações do e-book">
            <span>88 páginas</span>
            <span>8 capítulos</span>
            <span>20 comandos essenciais</span>
            <span>Nível iniciante</span>
          </div>

          <div class="product-price" aria-label="Preço do e-book">
            <span>Preço de lançamento · pagamento único</span>
            <strong>R$ 19,90</strong>
            <small>Pagamento processado pela Hotmart. Acesso liberado após a aprovação da compra.</small>
          </div>

          <div class="product-actions">
            <a
              class="button button-primary"
              href="https://pay.hotmart.com/W107818359E?off=e3elv7fq"
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-cta="product-linux-buy-hotmart-hero"
            >Comprar o e-book <span aria-hidden="true"><CategoryIcon icon="arrow-up-right" size={18} class="action-arrow" /></span></a>
            <a
              class="button button-secondary"
              href="#preview-title"
              data-analytics-cta="product-linux-preview"
            >Ver páginas do e-book <CategoryIcon icon="arrow-down" size={18} class="action-arrow" /></a>
          </div>

          <p class="product-status">
            Compra segura pelo checkout da Hotmart. Você tem 7 dias após a compra para solicitar reembolso.
          </p>
        </div>

        <figure class="product-cover">
          <img
            src="/assets/products/linux-do-zero/cover.png"
            alt="Capa real do e-book Linux do Zero"
            width="1159"
            height="1638"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>Capa real do e-book digital.</figcaption>
        </figure>
      </div>
    </header>

    <section class="product-section container" aria-labelledby="for-title">
      <div class="product-section__heading">
        <div>
          <p class="eyebrow">PARA QUEM ESTÁ COMEÇANDO</p>
          <h2 id="for-title">Aprenda com uma sequência prática.</h2>
        </div>
        <p>Você não precisa saber programar nem decorar comandos antes de começar.</p>
      </div>

      <div class="product-audience-grid">
        <article>
          <CategoryIcon icon="terminal" size={26} />
          <h3>É seu primeiro contato com Linux</h3>
          <p>O material começa pelos conceitos básicos e explica o motivo de cada etapa.</p>
        </article>
        <article>
          <CategoryIcon icon="shield-check" size={26} />
          <h3>Você tem medo de instalar errado</h3>
          <p>Backup, modo live e decisões de instalação aparecem antes das mudanças no disco.</p>
        </article>
        <article>
          <CategoryIcon icon="code" size={26} />
          <h3>O terminal parece complicado</h3>
          <p>Os comandos entram aos poucos, sempre acompanhados de contexto e exemplos.</p>
        </article>
      </div>

      <aside class="product-not-for">
        <strong>Este material não foi pensado como referência avançada.</strong>
        <p>Se você já administra servidores Linux, domina shell e permissões, provavelmente encontrará mais valor em materiais especializados.</p>
      </aside>
    </section>

    <section class="product-preview" aria-labelledby="preview-title">
      <div class="container">
        <div class="product-section__heading">
          <div>
            <p class="eyebrow">POR DENTRO DO MATERIAL</p>
            <h2 id="preview-title">Veja o conteúdo antes de comprar.</h2>
          </div>
          <p>Explore algumas páginas reais e conheça a forma de ensinar do DejotaCode.</p>
        </div>
        <div class="product-preview__grid">
          {samples.map((sample, index) => (
            <figure>
              <a href={sample.src} data-sample-open={index} aria-label={`Ampliar: ${sample.title}, página ${sample.page}`}>
                <img src={sample.src} alt={`Página ${sample.page} do e-book: ${sample.title}`} width="1133" height="1600" loading="lazy" decoding="async" />
              </a>
              <figcaption><strong>{sample.title}</strong><span>{sample.description}</span><a href={sample.src} data-sample-open={index}>Ampliar página {sample.page} <CategoryIcon icon="arrow-up-right" size={18} class="action-arrow" /></a></figcaption>
            </figure>
          ))}
        </div>
        <dialog class="product-sample-dialog" aria-labelledby="sample-dialog-title">
          <div class="product-sample-dialog__toolbar">
            <h2 id="sample-dialog-title">Páginas do e-book</h2>
            <button type="button" data-sample-close autofocus>Fechar ✕</button>
          </div>
          <p data-sample-caption aria-live="polite"></p>
          <div class="product-sample-dialog__navigation">
            <button type="button" data-sample-prev><CategoryIcon icon="arrow-left" size={18} class="action-arrow" /> Anterior</button>
            <span data-sample-count></span>
            <button type="button" data-sample-next>Próxima <CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></button>
          </div>
          <img data-sample-image alt="" width="1133" height="1600" />
        </dialog>
      </div>
    </section>

    <section class="product-section container" aria-labelledby="contents-title">
      <div class="product-section__heading">
        <div>
          <p class="eyebrow">O QUE VOCÊ VAI ENCONTRAR</p>
          <h2 id="contents-title">Um caminho organizado em 8 capítulos.</h2>
        </div>
        <p>O conteúdo segue uma sequência para evitar que você precise adivinhar qual deveria ser o próximo passo.</p>
      </div>

      <ol class="product-chapters">
        {chapters.map(([number, title, description]) => (
          <li>
            <span>{number}</span>
            <div><h3>{title}</h3><p>{description}</p></div>
          </li>
        ))}
      </ol>
      <div class="product-mid-cta">
        <div>
          <strong>Quer estudar tudo em uma sequência única?</strong>
          <p>O e-book reúne os 8 capítulos em 88 páginas para você consultar no seu ritmo, do primeiro contato aos problemas mais comuns.</p>
        </div>
        <a class="button button-primary" href="https://pay.hotmart.com/W107818359E?off=e3elv7fq" target="_blank" rel="noopener noreferrer" data-analytics-cta="product-linux-buy-hotmart-middle">Comprar por R$ 19,90 <span aria-hidden="true"><CategoryIcon icon="arrow-up-right" size={18} class="action-arrow" /></span></a>
      </div>
    </section>

    <section class="product-learning">
      <div class="container product-learning__grid">
        <div>
          <p class="eyebrow">CONTEÚDO GRATUITO + MATERIAL COMPLETO</p>
          <h2>Comece gratuitamente. Aprofunde no seu ritmo.</h2>
          <p>
            A trilha Linux do Zero continua gratuita no DejotaCode. Ela serve como primeiro
            contato e também ajuda você a decidir se a forma de ensinar combina com seu jeito
            de aprender.
          </p>
          <a class="text-link" href="/trilhas/linux-do-zero/" data-analytics-cta="product-linux-trail-middle">Explorar a trilha gratuita <span aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></a>
        </div>
        <div class="product-learning__comparison">
          <article><CategoryIcon icon="workflow" size={26} /><h3>Trilha gratuita</h3><ul><li>Artigos introdutórios organizados</li><li>Primeiro contato com Linux</li><li>Progresso neste navegador</li></ul></article>
          <article><CategoryIcon icon="checklist" size={26} /><h3>E-book Linux do Zero</h3><ul><li>88 páginas em um único material</li><li>Preparação e instalação</li><li>20 comandos, permissões e problemas comuns</li></ul></article>
        </div>
      </div>
    </section>

    <section class="product-section container" aria-labelledby="author-title">
      <div class="product-author">
        <div class="product-author__copy">
          <p class="eyebrow">QUEM ESCREVEU</p>
          <h2 id="author-title">Dejota</h2>
          <p>
            O Linux do Zero nasceu da mesma proposta do DejotaCode: explicar tecnologia de
            forma simples, prática e responsável, respeitando quem ainda está construindo a
            base.
          </p>
          <a class="text-link" href="/sobre/">Conhecer a história do DejotaCode <span aria-hidden="true"><CategoryIcon icon="arrow-right" size={18} class="action-arrow" /></span></a>
        </div>
        <img
          src="/assets/brand/dejota-author.webp"
          alt="Dejota, autor do e-book Linux do Zero"
          width="160" height="160" loading="lazy" decoding="async"
        />
      </div>
    </section>

    <section class="product-section container" aria-labelledby="faq-title">
      <div class="product-section__heading">
        <div><p class="eyebrow">DÚVIDAS COMUNS</p><h2 id="faq-title">Antes de comprar</h2></div>
      </div>
      <div class="product-faq">
        <details open>
          <summary>Como recebo o e-book?</summary>
          <p>Após a aprovação do pagamento, a Hotmart envia as instruções de acesso ao produto digital. O Linux do Zero é entregue pelo Hotmart Club.</p>
        </details>
        <details>
          <summary>Preciso saber Linux antes?</summary>
          <p>Não. O material foi escrito para iniciantes e começa explicando os conceitos essenciais antes da prática.</p>
        </details>
        <details>
          <summary>Posso estudar gratuitamente primeiro?</summary>
          <p>Sim. A trilha Linux do Zero e os artigos do DejotaCode continuam disponíveis gratuitamente.</p>
        </details>
        <details>
          <summary>Qual é a diferença entre a trilha gratuita e o e-book?</summary>
          <p>A trilha gratuita organiza conteúdos introdutórios para você começar. O e-book reúne um caminho contínuo de 88 páginas, com preparação e instalação, 20 comandos essenciais, permissões e solução de problemas em um único material para consulta.</p>
        </details>
        <details>
          <summary>Qual é o preço?</summary>
          <p>O preço de lançamento do Linux do Zero é R$ 19,90, em pagamento único.</p>
        </details>
        <details>
          <summary>Posso pedir reembolso?</summary>
          <p>Sim. Compras feitas pela Hotmart têm prazo de 7 dias após a compra para solicitação de reembolso.</p>
        </details>
      </div>
    </section>

    <section class="product-final-cta">
      <div class="container">
        <div>
          <p class="eyebrow">PRÓXIMO PASSO</p>
          <h2>Seu próximo passo no Linux</h2>
          <p>Leve o e-book Linux do Zero por R$ 19,90 e avance no seu ritmo.</p>
        </div>
        <a class="button button-primary" href="https://pay.hotmart.com/W107818359E?off=e3elv7fq" target="_blank" rel="noopener noreferrer" data-analytics-cta="product-linux-buy-hotmart-final">Comprar por R$ 19,90 <span aria-hidden="true"><CategoryIcon icon="arrow-up-right" size={18} class="action-arrow" /></span></a>
      </div>
    </section>
  </main>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>(".product-sample-dialog");
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-sample-open]"));
    const images = Array.from(document.querySelectorAll<HTMLImageElement>(".product-preview__grid img"));
    let current = 0;
    let opener: HTMLElement | null = null;
    if (dialog) {
      const image = dialog.querySelector<HTMLImageElement>("[data-sample-image]");
      const prev = dialog.querySelector<HTMLButtonElement>("[data-sample-prev]");
      const next = dialog.querySelector<HTMLButtonElement>("[data-sample-next]");
      const show = (index: number) => {
        current = index;
        const source = images[index];
        if (image) { image.src = source.src; image.alt = source.alt; }
        const caption = dialog.querySelector("[data-sample-caption]");
        const count = dialog.querySelector("[data-sample-count]");
        if (caption) caption.textContent = source.alt;
        if (count) count.textContent = `${index + 1} de ${images.length}`;
        if (prev) prev.disabled = index === 0;
        if (next) next.disabled = index === images.length - 1;
      };
      links.forEach(link => link.addEventListener("click", event => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        show(Number(link.dataset.sampleOpen));
        dialog.showModal();
      }));
      prev?.addEventListener("click", () => { if (current > 0) show(current - 1); });
      next?.addEventListener("click", () => { if (current < images.length - 1) show(current + 1); });
      dialog.querySelector("[data-sample-close]")?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("close", () => opener?.focus());
      dialog.addEventListener("keydown", event => {
        if (event.key === "ArrowRight" && current < images.length - 1) { event.preventDefault(); show(current + 1); }
        if (event.key === "ArrowLeft" && current > 0) { event.preventDefault(); show(current - 1); }
      });
    }
  </script>
</BaseLayout>
