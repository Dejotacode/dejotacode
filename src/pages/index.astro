---
import BaseLayout from "../layouts/BaseLayout.astro";
import VisualMedia from "../components/visual/VisualMedia.astro";
import CategoryIcon from "../components/CategoryIcon.astro";
import { resolvePostVisual } from "../data/editorialVisuals";
import {
  featuredPostSlugs,
  homeTrailSlugs,
  recentTutorialSlugs,
  topics,
} from "../data/home";
import { availableTrails } from "../data/trails";
import {
  categories,
  getPublishedPosts,
  postHref,
  postSlug,
} from "../lib/content";
import "../styles/home.css";

const siteUrl = new URL("/", Astro.site ?? Astro.url.origin);
const posts = await getPublishedPosts();
const postsBySlug = new Map(posts.map((post) => [postSlug(post), post]));
const trailsBySlug = new Map(availableTrails.map((trail) => [trail.slug, trail]));

function resolveCurated<T>(
  slugs: readonly string[],
  itemsBySlug: Map<string, T>,
  itemLabel: string,
): T[] {
  return slugs.map((slug) => {
    const item = itemsBySlug.get(slug);
    if (!item) {
      throw new Error(`Homepage: ${itemLabel} curado não encontrado: ${slug}`);
    }
    return item;
  });
}

const homeTrails = resolveCurated(homeTrailSlugs, trailsBySlug, "trilha");
const featuredPosts = resolveCurated(featuredPostSlugs, postsBySlug, "conteúdo em destaque");
const recentTutorialPosts = resolveCurated(recentTutorialSlugs, postsBySlug, "tutorial recente");




const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl.href}#organization`,
      name: "DejotaCode",
      url: siteUrl.href,
      logo: {
        "@type": "ImageObject",
        url: new URL("/assets/brand/icon-512.png", siteUrl).href,
      },
      sameAs: ["https://github.com/Dejotacode"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: "DejotaCode",
      description:
        "Tutoriais passo a passo sobre Linux, programação e tecnologia prática para quem está começando.",
      inLanguage: "pt-BR",
      publisher: {
        "@id": `${siteUrl.href}#organization`,
      },
    },
  ],
};
---

<BaseLayout title="Linux, programação e tecnologia para iniciantes" description="Aprenda Linux, programação e tecnologia com tutoriais passo a passo, trilhas de aprendizagem e recursos práticos para quem está começando.">
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(homeSchema)}
  />

  <main id="conteudo" class="home-editorial" tabindex="-1">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">APRENDA · PRATIQUE · EVOLUA</p>
          <h1 id="hero-title">Tecnologia simples para quem está começando.</h1>
          <p class="hero-description">Tutoriais passo a passo sobre Linux, programação e tecnologia prática, explicados sem complicação.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#trilhas" data-analytics-cta="home-hero-trilhas">Escolher uma trilha <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/blog/" data-analytics-cta="home-hero-blog">Explorar o Blog <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-visual"><img src="/assets/posts/escolher-primeiro-projeto-portfolio-capa-v1.webp" alt="Notebook com projeto de interface e caderno de planejamento em um ambiente de estudos" width="1440" height="810" loading="eager" fetchpriority="high" decoding="async" /></div>
      </div>
    </section>
    <nav class="topic-strip container" aria-label="Assuntos principais">
      <div class="topic-grid">{topics.map((topic) => <a href={topic.href}><CategoryIcon icon={topic.iconId} size={32} /><strong>{topic.title}</strong></a>)}</div>
    </nav>
    <section class="section container" id="trilhas" aria-labelledby="tracks-title">
      <div class="section-bar"><h2 id="tracks-title">Escolha uma trilha</h2><a class="text-link" href="/trilhas/" data-analytics-cta="home-trilhas-todas">Ver todas as trilhas <span aria-hidden="true">→</span></a></div>
      <div class="tracks-grid">{homeTrails.map((track) => <article class="track-card"><CategoryIcon icon={track.iconId} size={38} /><h3>{track.title}</h3><p>{track.description}</p><a class="text-link" href={`/trilhas/${track.slug}/`} data-analytics-cta={`home-trail-${track.slug}`}>Ver trilha <span aria-hidden="true">→</span></a></article>)}</div>
    </section>
    <section class="section container" id="blog" aria-labelledby="featured-title">
      <div class="section-bar"><h2 id="featured-title">Aprenda algo novo</h2><a class="text-link" href="/blog/">Explorar o Blog <span aria-hidden="true">→</span></a></div>
      <div class="featured-grid">{featuredPosts.map((post) => <a class="content-card" href={postHref(post)}><div class="home-content-media"><VisualMedia src={resolvePostVisual(post.data.category, postSlug(post))} fallbackSrc="/assets/resources/category-aprendizado.svg" alt={post.data.title} label={post.data.title} loading="lazy" /></div><div class="card-content"><span class="category">{categories[post.data.category]}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="card-arrow" aria-hidden="true">→</span></div></a>)}</div>
      <h3 class="recent-title">Mais tutoriais do blog</h3>
      <div class="recent-grid">{recentTutorialPosts.map((post) => <a class="tutorial-card" href={postHref(post)}><h3>{post.data.title}</h3><span aria-hidden="true">→</span></a>)}</div>
    </section>
    <section class="section container" aria-labelledby="guide-title"><div class="guide-card"><span class="panel-icon"><CategoryIcon icon="news" size={38} /></span><div><h2 id="guide-title">Guia do Iniciante em Tecnologia</h2><p>Um caminho simples para organizar seus primeiros passos.</p></div><a class="button button-secondary" href="/guia/iniciante-em-tecnologia/" data-analytics-cta="home-guia-iniciante">Conhecer o guia <span aria-hidden="true">→</span></a></div></section>
    <section class="section container" aria-labelledby="product-highlight-title">
      <div class="product-highlight"><div class="product-highlight__cover"><img src="/assets/products/linux-do-zero/cover.png" alt="Capa do e-book Linux do Zero" width="1159" height="1638" loading="lazy" decoding="async" /></div><div class="product-highlight__copy"><p class="eyebrow">E-BOOK · MATERIAL PAGO</p><h2 id="product-highlight-title">Linux do Zero</h2><p>88 páginas para dar os primeiros passos com segurança.</p><div class="product-highlight__meta"><span><CategoryIcon icon="monitor" size={24} />Instalação</span><span><CategoryIcon icon="terminal" size={24} />Terminal</span><span><CategoryIcon icon="shield-check" size={24} />Segurança</span></div><div class="product-highlight__actions"><a class="button button-primary" href="/produtos/linux-do-zero/" data-analytics-cta="home-linux-ebook">Conhecer o e-book <span aria-hidden="true">→</span></a><a class="text-link" href="/trilhas/linux-do-zero/" data-analytics-cta="home-linux-trail">Começar pela trilha gratuita <span aria-hidden="true">→</span></a></div></div></div>
    </section>
    <section class="section container" aria-labelledby="practice-title"><div class="section-bar"><h2 id="practice-title">Da aprendizagem à prática</h2></div><div class="split-showcase">
      <article class="showcase-block"><span class="panel-icon"><CategoryIcon icon="code" size={38} /></span><div><h3>Projetos e serviços</h3><p>Veja o que construímos e como podemos ajudar seu projeto.</p><div class="showcase-links"><a class="text-link" href="/portfolio/" data-analytics-cta="home-portfolio">Ver portfólio <span aria-hidden="true">→</span></a><a class="text-link" href="/servicos/" data-analytics-cta="home-servicos">Conhecer serviços <span aria-hidden="true">→</span></a></div></div></article>
      <article class="showcase-block"><span class="panel-icon"><CategoryIcon icon="checklist" size={38} /></span><div><h3>Recursos e recomendações</h3><p>Ferramentas com contexto e critérios transparentes.</p><div class="showcase-links"><a class="text-link" href="/recursos/" data-analytics-cta="home-recursos">Explorar recursos <span aria-hidden="true">→</span></a><a class="text-link" href="/store/" data-analytics-cta="home-store">Conhecer a Store <span aria-hidden="true">→</span></a></div></div></article>
    </div></section>
    <section class="section container" aria-labelledby="about-title"><div class="about-grid"><div class="about-mark" aria-hidden="true"></div><div><h2 id="about-title">Olá, eu sou o Dejota.</h2><p>Compartilho o que aprendo construindo projetos e explicando tecnologia de forma prática.</p></div><a class="text-link" href="/sobre/" data-analytics-cta="home-sobre">Conhecer minha história <span aria-hidden="true">→</span></a></div></section>
    <section class="section container newsletter-section" aria-labelledby="newsletter-title"><div class="newsletter-card"><span class="panel-icon"><CategoryIcon icon="news" size={38} /></span><div><h2 id="newsletter-title">Um próximo passo por e-mail.</h2><p>Novos conteúdos, guias e recursos. Sem spam.</p></div><form class="newsletter-form" data-newsletter-preview><label class="sr-only" for="email">Seu melhor e-mail</label><div><input id="email" name="email" type="email" autocomplete="email" placeholder="Seu melhor e-mail" required /><button class="button button-primary" type="submit">Continuar <span aria-hidden="true">→</span></button></div><small>Respeitamos sua <a href="/politica-de-privacidade/">privacidade</a>.</small></form></div></section>
  </main>

  <script>
    import { sendAnalyticsEvent } from "../scripts/analytics";

    document.querySelector("[data-newsletter-preview]")?.addEventListener("submit", (event) => {
      event.preventDefault();

      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;

      const email = new FormData(form).get("email");
      if (typeof email !== "string") return;

      sessionStorage.setItem("dejotacode:newsletter-email", email.trim());

      const apiBase =
        typeof window.__DEJOTACODE_API_BASE__ === "string"
          ? window.__DEJOTACODE_API_BASE__
          : "";
      sendAnalyticsEvent(apiBase, "cta_click", "home-newsletter-preview");

      window.location.assign("/newsletter/");
    });
  </script>
</BaseLayout>
