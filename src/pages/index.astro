---
import Brand from "../components/Brand.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="DejotaCode">
  <main id="conteudo" class="foundation-preview">
    <div class="container">
      <section class="foundation-card" aria-labelledby="foundation-title">
        <Brand />
        <h1 id="foundation-title">Fundação visual aprovada.</h1>
        <p>
          Esta página técnica valida identidade, contraste, tipografia, foco e alternância entre os temas claro e escuro antes da construção da homepage.
        </p>
        <div class="foundation-actions">
          <button class="button button-primary" type="button" data-theme-toggle aria-pressed="false" aria-label="Ativar tema claro">
            Alternar tema
          </button>
          <a class="button" href="#foundation-title">Testar link e foco</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
