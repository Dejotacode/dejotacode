---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  featuredHomeTrailSlug,
  featuredPostSlugs,
  homeTrailSlugs,
  recentTutorialSlugs,
  topics,
} from "../data/home";
import { availableTrails } from "../data/trails";
import {
  categories,
  formatPostDate,
  getPublishedPosts,
  postHref,
  postSlug,
} from "../lib/content";
import "../styles/home.css";

const siteUrl = new URL("/", Astro.site ?? Astro.url.origin);
const posts = await getPublishedPosts();
const postsBySlug = new Map(posts.map((post) => [postSlug(post), post]));
const trailsBySlug = new Map(availableTrails.map((trail) => [trail.slug, trail]));

function resolveCurated<T>(
  slugs: readonly string[],
  itemsBySlug: Map<string, T>,
  itemLabel: string,
): T[] {
  return slugs.map((slug) => {
    const item = itemsBySlug.get(slug);
    if (!item) {
      throw new Error(`Homepage: ${itemLabel} curado não encontrado: ${slug}`);
    }
    return item;
  });
}

const homeTrails = resolveCurated(homeTrailSlugs, trailsBySlug, "trilha");
const featuredPosts = resolveCurated(featuredPostSlugs, postsBySlug, "conteúdo em destaque");
const recentTutorialPosts = resolveCurated(recentTutorialSlugs, postsBySlug, "tutorial recente");

const categorySymbols = {
  programacao: "</>",
  "linux-seguranca": "$ _",
  "inteligencia-artificial": "IA",
  "tecnologia-pratica": "▥",
} as const;

const difficultyLabels = {
  iniciante: "Iniciante",
  intermediario: "Intermediário",
  avancado: "Avançado",
} as const;

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl.href}#organization`,
      name: "DejotaCode",
      url: siteUrl.href,
      logo: {
        "@type": "ImageObject",
        url: new URL("/assets/brand/icon-512.png", siteUrl).href,
      },
      sameAs: ["https://github.com/Dejotacode"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: "DejotaCode",
      description:
        "Tutoriais passo a passo sobre Linux, programação e tecnologia prática para quem está começando.",
      inLanguage: "pt-BR",
      publisher: {
        "@id": `${siteUrl.href}#organization`,
      },
    },
  ],
};
---

<BaseLayout title="DejotaCode | Linux, programação e tecnologia para iniciantes" description="Aprenda Linux, programação e tecnologia com tutoriais passo a passo, trilhas de aprendizagem e recursos práticos para quem está começando.">
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(homeSchema)}
  />

  <main id="conteudo" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">APRENDA • PRATIQUE • EVOLUA</p>
          <h1 id="hero-title">Tecnologia simples para quem está começando.</h1>
          <p class="hero-description">Tutoriais passo a passo sobre Linux e tecnologia prática, explicados sem complicação.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#trilhas" data-analytics-cta="home-hero-trilhas">Escolher uma trilha <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/blog/" data-analytics-cta="home-hero-blog">Explorar conteúdos</a>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <span class="visual-label">IDEIAS<br />CÓDIGO<br />CONHECIMENTO<br />RESULTADOS</span>
          <span class="visual-mark"></span><span class="visual-dot"></span>
        </div>
      </div>
    </section>

    <nav class="topic-strip" aria-label="Assuntos principais">
      <div class="container topic-grid">
        {topics.map((topic) => <a href={topic.href}><span class="topic-icon">{topic.symbol}</span><span><strong>{topic.title}</strong><small>{topic.description}</small></span></a>)}
      </div>
    </nav>

    <section class="section" id="trilhas" aria-labelledby="tracks-title">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">COMECE PELO CAMINHO CERTO</p><h2 id="tracks-title">Escolha uma trilha</h2></div><p>Conteúdos organizados em sequência para você aprender com clareza e avançar no seu ritmo.</p></div>
        <div class="tracks-grid">
          {homeTrails.map((track) => <article class:list={["track-card", { "track-featured": track.slug === featuredHomeTrailSlug }]}><div class="card-topline"><span>{track.number}</span><span class="level">{track.level}</span></div><div><span class="track-symbol">{track.icon}</span><h3>{track.title}</h3><p>{track.description}</p></div><a class="text-link" href={`/trilhas/${track.slug}/`} data-analytics-cta={`home-trail-${track.slug}`}>Ver trilha <span aria-hidden="true">→</span></a></article>)}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="blog" aria-labelledby="featured-title">
      <div class="container">
        <div class="section-bar"><div><p class="eyebrow">CONHECIMENTO QUE GERA RESULTADOS</p><h2 id="featured-title">Conteúdos em destaque</h2></div><a class="text-link" href="/blog/">Ver todos <span aria-hidden="true">→</span></a></div>
        <div class="featured-grid">
          {featuredPosts.map((post) => <a class="content-card" href={postHref(post)}><div class="editorial-art" aria-hidden="true"><span>{categorySymbols[post.data.category]}</span></div><div class="card-content"><span class="category">{categories[post.data.category]}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="meta"><span>{formatPostDate(post.data.publishedAt)}</span><span>{post.data.readingTime} min de leitura</span></div></div></a>)}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="recent-title">
      <div class="container">
        <div class="section-bar"><div><p class="eyebrow">PASSO A PASSO</p><h2 id="recent-title">Tutoriais recentes</h2></div><a class="text-link" href="/blog/">Acessar o blog <span aria-hidden="true">→</span></a></div>
        <div class="recent-grid">
          {recentTutorialPosts.map((post, index) => <a class="tutorial-card" href={postHref(post)}><span class="tutorial-icon">{String(index + 1).padStart(2, "0")}</span><div><span class="category">{categories[post.data.category]}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="meta"><span>{post.data.readingTime} min</span><span>{difficultyLabels[post.data.difficulty]}</span></div></div></a>)}
        </div>
      </div>
    </section>

    <section class="section guide-section" aria-labelledby="guide-title"><div class="container guide-card"><div class="guide-visual" aria-hidden="true"><span class="guide-badge">GUIA</span><strong>01</strong><i></i></div><div class="guide-copy"><p class="eyebrow">COMECE SEM SE PERDER</p><h2 id="guide-title">Guia do Iniciante em Tecnologia</h2><p>Um caminho simples para escolher o que aprender, organizar seus estudos e colocar o conhecimento em prática.</p><ul><li>Escolha seu primeiro objetivo</li><li>Monte uma rotina possível</li><li>Evite os erros mais comuns</li></ul><a class="button button-primary" href="/newsletter/?resource=guia-iniciante-tecnologia" data-analytics-cta="home-guia-iniciante">Quero receber o guia <span aria-hidden="true">→</span></a></div></div></section>

    <section class="section product-highlight-section" aria-labelledby="product-highlight-title">
      <div class="container product-highlight">
        <div class="product-highlight__cover">
          <img src="/assets/products/linux-do-zero/cover.png" alt="Capa real do e-book Linux do Zero" loading="lazy" />
        </div>
        <div class="product-highlight__copy">
          <p class="eyebrow">MATERIAL DEJOTACODE · PRÉ-LANÇAMENTO</p>
          <h2 id="product-highlight-title">Linux do Zero: da primeira curiosidade aos primeiros passos com confiança.</h2>
          <p>O e-book reúne 88 páginas para iniciantes, com instalação segura, terminal, permissões e solução de problemas explicados sem pular etapas.</p>
          <div class="product-highlight__actions">
            <a class="button button-primary" href="/produtos/linux-do-zero/" data-analytics-cta="home-linux-ebook">Conhecer o e-book <span aria-hidden="true">→</span></a>
            <a class="text-link" href="/trilhas/linux-do-zero/" data-analytics-cta="home-linux-trail">Começar pela trilha gratuita</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt"><div class="container split-showcase"><div class="showcase-block"><p class="eyebrow">PROJETOS REAIS</p><h2>Aprendizado colocado em prática</h2><p>Conheça projetos construídos com decisões documentadas, desafios reais e resultados verificáveis.</p><a class="text-link" href="/portfolio/" data-analytics-cta="home-portfolio">Explorar portfólio <span aria-hidden="true">→</span></a><div class="project-preview"><span>DEJOTACODE / 01</span><strong>Plataforma de conteúdo na infraestrutura Cloudflare</strong><small>Astro • Workers • D1 • R2</small></div></div><div class="showcase-block"><p class="eyebrow">FERRAMENTAS QUE AJUDAM</p><h2>Recursos recomendados</h2><p>Uma seleção transparente de ferramentas usadas nos estudos e projetos do DejotaCode.</p><a class="text-link" href="/recursos/" data-analytics-cta="home-recursos">Ver recursos <span aria-hidden="true">→</span></a><div class="resource-list"><span><b>VS Code</b><small>Editor de código</small></span><span><b>GitHub</b><small>Projetos e versões</small></span><span><b>Cloudflare</b><small>Publicação e infraestrutura</small></span></div></div></div></section>


    <section class="section services-intro" aria-labelledby="services-title">
      <div class="container services-intro__layout">
        <div>
          <p class="eyebrow">PRECISA COLOCAR SUA IDEIA NO AR?</p>
          <h2 id="services-title">Sites simples, rápidos e feitos para gerar contatos.</h2>
          <p>Landing pages para autônomos e pequenos negócios, com escopo claro, prazo definido e acompanhamento direto.</p>
        </div>
        <a class="button button-primary" href="/servicos/" data-analytics-cta="home-servicos">Conhecer os serviços <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="section" aria-labelledby="about-title"><div class="container about-grid"><div class="about-mark" aria-hidden="true"><span></span></div><div><p class="eyebrow">QUEM COMPARTILHA</p><h2 id="about-title">Olá, eu sou o Dejota.</h2><p>Criei o DejotaCode para compartilhar o que aprendo construindo projetos de verdade. Aqui, tecnologia é explicada com calma, exemplos práticos e respeito por quem está começando.</p><a class="button button-secondary" href="/sobre/" data-analytics-cta="home-sobre">Conhecer minha história</a></div></div></section>

    <section class="section newsletter-section" aria-labelledby="newsletter-title"><div class="container newsletter-card"><div><p class="eyebrow">APRENDA. CONSTRUA. EVOLUA.</p><h2 id="newsletter-title">Um próximo passo por e-mail.</h2><p>Receba novos conteúdos, guias e recursos. Sem spam e com cancelamento simples.</p></div><form class="newsletter-form" data-newsletter-preview><label for="email">Seu melhor e-mail</label><div><input id="email" name="email" type="email" autocomplete="email" placeholder="voce@exemplo.com" required /><button class="button button-primary" type="submit">Continuar</button></div><small>Nenhum dado será enviado nesta etapa. Você continuará para a página da Newsletter. Consulte a <a class="inline-link" href="/politica-de-privacidade/">Política de Privacidade</a>.</small></form></div></section>
  </main>

  <script>
    import { sendAnalyticsEvent } from "../scripts/analytics";

    document.querySelector("[data-newsletter-preview]")?.addEventListener("submit", (event) => {
      event.preventDefault();

      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;

      const email = new FormData(form).get("email");
      if (typeof email !== "string") return;

      sessionStorage.setItem("dejotacode:newsletter-email", email.trim());

      const apiBase =
        typeof window.__DEJOTACODE_API_BASE__ === "string"
          ? window.__DEJOTACODE_API_BASE__
          : "";
      sendAnalyticsEvent(apiBase, "cta_click", "home-newsletter-preview");

      window.location.assign("/newsletter/");
    });
  </script>
</BaseLayout>
