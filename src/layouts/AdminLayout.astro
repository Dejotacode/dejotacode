---
import "../styles/global.css";
import "../styles/admin-refinement.css";
import Brand from "../components/layout/Brand.astro";
import AdminNav from "../components/admin/AdminNav.astro";
import MediaFlowNav from "../components/admin/MediaFlowNav.astro";
import EditorMediaMigrationGuard from "../components/admin/EditorMediaMigrationGuard.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Área privada de administração do DejotaCode.",
} = Astro.props;

const pageTitle = `${title} | DejotaCode`;
const currentPath = Astro.url.pathname;
const showsMediaFlow = currentPath.startsWith("/admin/midia");
const showsEditorMediaMigration = currentPath.startsWith("/admin/editor");
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0d12" />
    <link rel="icon" type="image/svg+xml" href="/assets/brand/dejotacode-app-icon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("dejotacode-theme");
        const preferred = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        const theme = saved === "light" || saved === "dark" ? saved : preferred;
        document.documentElement.dataset.theme = theme;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        themeColor?.setAttribute("content", theme === "light" ? "#f7f9fc" : "#0a0d12");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    <header class="admin-topbar">
      <div class="admin-topbar__inner">
        <div class="admin-topbar__brand">
          <Brand />
          <span class="admin-topbar__badge">Admin</span>
        </div>
        <div class="admin-topbar__actions">
          <span class="admin-topbar__label">Área privada</span>
          <button class="admin-theme-toggle" type="button" data-theme-toggle aria-pressed="false">
            Tema
          </button>
        </div>
      </div>
    </header>

    <AdminNav />
    {showsMediaFlow && <MediaFlowNav />}
    {showsEditorMediaMigration && <EditorMediaMigrationGuard />}

    <slot />

    <script>
      const syncThemeControl = () => {
        const isLight = document.documentElement.dataset.theme === "light";
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", isLight ? "#f7f9fc" : "#0a0d12");
        document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((control) => {
          control.setAttribute("aria-pressed", String(isLight));
          control.setAttribute("aria-label", isLight ? "Ativar tema escuro" : "Ativar tema claro");
        });
      };

      syncThemeControl();

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const toggle = target.closest("[data-theme-toggle]");
        if (!toggle) return;

        const root = document.documentElement;
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        localStorage.setItem("dejotacode-theme", next);
        syncThemeControl();
      });

      requestAnimationFrame(() => document.documentElement.classList.add("theme-ready"));
    </script>

    <style>
      .admin-topbar {
        position: relative;
        border-bottom: 1px solid var(--color-border);
        background-color: var(--color-surface);
        background-image: radial-gradient(circle at 14% 0%, var(--color-glow), transparent 34%), var(--grid-pattern);
        background-size: auto, 2.25rem 2.25rem, 2.25rem 2.25rem;
      }

      .admin-topbar::after {
        content: "";
        position: absolute;
        inset: auto 0 -1px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
        opacity: 0.28;
        pointer-events: none;
      }

      .admin-topbar__inner {
        width: min(calc(100% - var(--space-page) - var(--space-page)), 68rem);
        min-height: 4.75rem;
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .admin-topbar__brand,
      .admin-topbar__actions {
        display: flex;
        align-items: center;
      }

      .admin-topbar__brand {
        gap: 0.8rem;
      }

      .admin-topbar__actions {
        gap: 0.75rem;
      }

      .admin-topbar__badge {
        padding: 0.28rem 0.48rem;
        border: 1px solid var(--color-border-strong);
        border-radius: var(--radius-sm);
        background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface-soft));
        color: var(--color-accent-strong);
        font: var(--type-eyebrow);
        letter-spacing: var(--tracking-eyebrow);
        text-transform: uppercase;
      }

      .admin-topbar__label {
        color: var(--color-text-subtle);
        font: var(--type-eyebrow);
        letter-spacing: var(--tracking-eyebrow);
        text-transform: uppercase;
      }

      .admin-theme-toggle {
        min-height: var(--space-control);
        padding: 0.55rem 0.85rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: color-mix(in srgb, var(--color-surface-soft) 92%, transparent);
        color: var(--color-text);
        cursor: pointer;
        font-weight: 800;
        transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
      }

      .admin-theme-toggle:hover,
      .admin-theme-toggle:focus-visible {
        border-color: var(--color-accent-strong);
        color: var(--color-accent-strong);
        background: var(--color-surface);
      }

      @media (max-width: 38rem) {
        .admin-topbar__label {
          display: none;
        }
      }

      @media (max-width: 30rem) {
        :global(.admin-topbar .brand__name) {
          display: none;
        }

        .admin-topbar__inner {
          min-height: 4.25rem;
        }
      }
    </style>
  </body>
</html>
