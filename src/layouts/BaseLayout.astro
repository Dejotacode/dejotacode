---
import { existsSync } from "node:fs";
import { join } from "node:path";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

const apiBase = import.meta.env.PUBLIC_API_URL?.trim() ?? "";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  ogType?: "website" | "article";
  canonicalEnabled?: boolean;
}

const {
  title,
  description = "Tecnologia explicada de forma simples, prática e responsável.",
  image,
  imageAlt,
  robots = "index, follow",
  ogType = "website",
  canonicalEnabled = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pageTitle =
  title === "DejotaCode" || title.endsWith("| DejotaCode")
    ? title
    : `${title} | DejotaCode`;
const ogRouteKey =
  Astro.url.pathname === "/"
    ? "home"
    : Astro.url.pathname
        .replace(/^\/+|\/+$/g, "")
        .replaceAll("/", "--");

const routeSocialImagePath = `/assets/og/${ogRouteKey}.png`;
const routeSocialImageFile = join(process.cwd(), "public", routeSocialImagePath);
const socialImagePath =
  image ??
  (existsSync(routeSocialImageFile)
    ? routeSocialImagePath
    : "/assets/brand/opengraph-dark.png");
const socialImage = new URL(socialImagePath, Astro.site ?? Astro.url.origin);
const socialImageAlt = imageAlt ?? pageTitle;
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0a0d12" />
    <meta name="application-name" content="DejotaCode" />
    <meta name="apple-mobile-web-app-title" content="DejotaCode" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DejotaCode" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {canonicalEnabled && <link rel="canonical" href={canonical} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DejotaCode RSS"
      href="/rss.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/assets/brand/dejotacode-app-icon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/brand/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("dejotacode-theme");
        const preferred = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        const theme = saved === "light" || saved === "dark" ? saved : preferred;
        document.documentElement.dataset.theme = theme;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        themeColor?.setAttribute("content", theme === "light" ? "#f7f9fc" : "#0a0d12");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <Header />
    <slot />
    <Footer />

    <script is:inline define:vars={{ apiBase }}>
      window.__DEJOTACODE_API_BASE__ = apiBase;
    </script>

    <script>
      import { prepareAnalytics } from "../scripts/analytics";

      prepareAnalytics(
        typeof window.__DEJOTACODE_API_BASE__ === "string"
          ? window.__DEJOTACODE_API_BASE__
          : "",
      );

      requestAnimationFrame(() => document.documentElement.classList.add("theme-ready"));

      const syncThemeControls = () => {
        const isLight = document.documentElement.dataset.theme === "light";
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", isLight ? "#f7f9fc" : "#0a0d12");
        document.querySelectorAll("[data-theme-toggle]").forEach((control) => {
          control.setAttribute("aria-pressed", String(isLight));
          control.setAttribute("aria-label", isLight ? "Ativar tema escuro" : "Ativar tema claro");
        });
      };

      syncThemeControls();

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const toggle = target.closest("[data-theme-toggle]");
        if (!toggle) return;

        const root = document.documentElement;
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        localStorage.setItem("dejotacode-theme", next);
        syncThemeControls();
      });
    </script>
  </body>
</html>
